diff --git a/fs/ext4/trim_acl.c b/fs/ext4/trim_acl.c
new file mode 100755
index 000000000..225fb6eef
--- /dev/null
+++ b/fs/ext4/trim_acl.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ext4 的 Trim-ACL 支持 (system.trim_acl 存在 EXT4_XATTR_INDEX_SYSTEM 下, 名字为空;
+ * trim flags 存在 EXT4_XATTR_INDEX_TRIM_FLAGS 下)。
+ * Copyright (C) T.R.I.M Inc.
+ */
+#include <linux/quotaops.h>
+#include <linux/trim_acl.h>
+#include "ext4_jbd2.h"
+#include "ext4.h"
+#include "xattr.h"
+#include "acl.h"
+
+ssize_t ext4_get_trim_flags(struct inode *inode, void *buffer, size_t size)
+{
+	return ext4_xattr_get(inode, EXT4_XATTR_INDEX_TRIM_FLAGS, "", buffer, size);
+}
+
+int ext4_set_trim_flags(struct inode *inode, const void *value, size_t size,
+			int flags)
+{
+	return ext4_xattr_set(inode, EXT4_XATTR_INDEX_TRIM_FLAGS, "", value, size,
+			      flags);
+}
+
+/*
+ * Inode operation get_trim_acl().
+ *
+ * inode->i_rwsem: don't care
+ */
+struct trim_acl *ext4_get_trim_acl(struct mnt_idmap *idmap, struct inode *inode)
+{
+	char *value = NULL;
+	struct trim_acl *acl;
+	int retval;
+
+	acl = get_cached_trim_acl(inode);
+	if (!is_uncached_trim_acl(acl))
+		return acl;
+
+	retval = ext4_xattr_get(inode, EXT4_XATTR_INDEX_TRIM_ACL, "", NULL, 0);
+	if (retval > 0) {
+		value = kmalloc(retval, GFP_NOFS);
+		if (!value)
+			return ERR_PTR(-ENOMEM);
+		retval = ext4_xattr_get(inode, EXT4_XATTR_INDEX_TRIM_ACL, "", value, retval);
+	}
+	if (retval > 0)
+		acl = trim_acl_from_disk(value, retval);
+	else if (retval == -ENODATA || retval == -ENOSYS || !retval)
+		acl = NULL;
+	else
+		acl = ERR_PTR(retval);
+	kfree(value);
+
+	if (!IS_ERR(acl))
+		set_cached_trim_acl(inode, acl);
+
+	return acl;
+}
+
+/*
+ * Set the trim acl of an inode.
+ *
+ * inode->i_rwsem: down
+ */
+static int __ext4_set_trim_acl(handle_t *handle, struct inode *inode,
+			       struct trim_acl *acl)
+{
+	void *value = NULL;
+	size_t size = 0;
+	int error;
+
+	if (acl) {
+		error = trim_acl_valid(acl);
+		if (error < 0)
+			return error;
+		value = trim_acl_to_disk(acl, &size);
+		if (IS_ERR(value))
+			return (int)PTR_ERR(value);
+	}
+
+	error = ext4_xattr_set_handle(handle, inode, EXT4_XATTR_INDEX_TRIM_ACL, "",
+				      value, size, 0);
+	kfree(value);
+	if (!error)
+		set_cached_trim_acl(inode, acl);
+
+	return error;
+}
+
+/*
+ * Inode operation set_trim_acl().
+ */
+int ext4_set_trim_acl(struct mnt_idmap *idmap, struct inode *inode,
+		      struct trim_acl *acl)
+{
+	handle_t *handle;
+	int error, retries = 0;
+
+	if (!inode)
+		return -EINVAL;
+
+	error = dquot_initialize(inode);
+	if (error)
+		return error;
+retry:
+	handle = ext4_journal_start(inode, EXT4_HT_TRIM_ACL,
+				    EXT4_DATA_TRANS_BLOCKS(inode->i_sb));
+	if (IS_ERR(handle))
+		return PTR_ERR(handle);
+
+	error = __ext4_set_trim_acl(handle, inode, acl);
+	ext4_journal_stop(handle);
+	if (error == -ENOSPC && ext4_should_retry_alloc(inode->i_sb, &retries))
+		goto retry;
+	return error;
+}
+
+static bool ext4_xattr_trim_acl_list(struct dentry *dentry)
+{
+	return IS_TRIMACL(dentry);
+}
+
+static int ext4_xattr_trim_acl_get(const struct xattr_handler *handler,
+				   struct dentry *unused, struct inode *inode,
+				   const char *name, void *buffer, size_t size)
+{
+	struct trim_acl *acl;
+	int error;
+
+	acl = ext4_get_trim_acl(&nop_mnt_idmap, inode);
+	if (IS_ERR(acl))
+		return PTR_ERR(acl);
+	if (acl == NULL)
+		return -ENODATA;
+	error = trim_acl_to_xattr(acl, buffer, size);
+	trim_acl_release(acl);
+
+	return error;
+}
+
+static int ext4_xattr_trim_acl_set(const struct xattr_handler *handler,
+				   struct mnt_idmap *idmap,
+				   struct dentry *unused, struct inode *inode,
+				   const char *name, const void *value,
+				   size_t size, int flags)
+{
+	handle_t *handle;
+	struct trim_acl *acl;
+	int error, retries = 0;
+
+	if (value) {
+		acl = trim_acl_from_xattr(value, size);
+		if (IS_ERR(acl))
+			return PTR_ERR(acl);
+		else if (acl) {
+			error = trim_acl_valid(acl);
+			if (error)
+				goto release_and_out;
+		}
+	} else
+		acl = NULL;
+
+	error = dquot_initialize(inode);
+	if (error)
+		goto release_and_out;
+retry:
+	handle = ext4_journal_start(inode, EXT4_HT_TRIM_ACL,
+				    EXT4_DATA_TRANS_BLOCKS(inode->i_sb));
+	if (IS_ERR(handle)) {
+		error = PTR_ERR(handle);
+		goto release_and_out;
+	}
+	error = __ext4_set_trim_acl(handle, inode, acl);
+	ext4_journal_stop(handle);
+	if (error == -ENOSPC && ext4_should_retry_alloc(inode->i_sb, &retries))
+		goto retry;
+
+release_and_out:
+	trim_acl_release(acl);
+	return error;
+}
+
+const struct xattr_handler ext4_xattr_trimacl_access_handler = {
+	.name	= TRIM_ACL_XATTR_ACCESS,
+	.list	= ext4_xattr_trim_acl_list,
+	.get	= ext4_xattr_trim_acl_get,
+	.set	= ext4_xattr_trim_acl_set,
+};
