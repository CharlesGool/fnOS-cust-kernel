diff --git a/drivers/md/md-resync-hint.c b/drivers/md/md-resync-hint.c
new file mode 100644
index 000000000..415138296
--- /dev/null
+++ b/drivers/md/md-resync-hint.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * fnnas: resync hints for md.
+ *
+ * A resync hint is a sector range [h_start, h_end) of the array.  Hints are
+ * kept in an interval-less rbtree sorted by h_start, overlapping or
+ * adjacent ranges are merged on insertion.
+ *  - mddev->resync_rh_tree: ranges reported as unused by the filesystem
+ *    (REQ_OP_UNUSED_HINT), resync can skip them.
+ *  - mddev->resync_sh_tree: ranges that resync skipped.
+ */
+#include <linux/slab.h>
+#include <linux/rbtree.h>
+#include "md.h"
+
+#define MD_RESYNC_HINT_MAX_COUNT	300000
+
+static struct kmem_cache *md_resync_hint_cache;
+
+int md_resync_hint_add(struct md_resync_hint_tree *tree, sector_t h_start,
+		       sector_t h_end, gfp_t gfp_mask)
+{
+	struct rb_node **link = &tree->root.rb_root.rb_node, *parent = NULL;
+	struct md_resync_hint *hint;
+	bool leftmost = true;
+
+	while (*link) {
+		parent = *link;
+		hint = rb_entry(parent, struct md_resync_hint, node);
+		if (h_start < hint->h_start) {
+			link = &parent->rb_left;
+		} else if (h_start <= hint->h_start || h_start <= hint->h_end) {
+			hint->h_end = max(hint->h_end, h_end);
+			return 0;
+		} else {
+			link = &parent->rb_right;
+			leftmost = false;
+		}
+	}
+
+	if (tree->count == tree->max_count)
+		return -ENOMEM;
+
+	hint = kmem_cache_zalloc(md_resync_hint_cache, gfp_mask);
+	if (!hint)
+		return -ENOMEM;
+
+	tree->count++;
+	hint->h_start = h_start;
+	hint->h_end = h_end;
+	rb_link_node(&hint->node, parent, link);
+	rb_insert_color_cached(&hint->node, &tree->root, leftmost);
+	return 0;
+}
+
+void md_resync_hint_remove(struct md_resync_hint_tree *tree,
+			   struct md_resync_hint *hint)
+{
+	rb_erase_cached(&hint->node, &tree->root);
+	tree->count--;
+}
+
+void md_resync_hint_free(struct md_resync_hint *hint)
+{
+	kmem_cache_free(md_resync_hint_cache, hint);
+}
+
+struct md_resync_hint *md_resync_hint_first(struct md_resync_hint_tree *tree)
+{
+	return rb_entry_safe(rb_first_cached(&tree->root),
+			     struct md_resync_hint, node);
+}
+
+void md_resync_hint_tree_init(struct md_resync_hint_tree *tree)
+{
+	tree->root = RB_ROOT_CACHED;
+	tree->count = 0;
+	tree->max_count = MD_RESYNC_HINT_MAX_COUNT;
+}
+
+void md_resync_hint_tree_clear(struct md_resync_hint_tree *tree)
+{
+	struct md_resync_hint *hint, *next;
+
+	rbtree_postorder_for_each_entry_safe(hint, next, &tree->root.rb_root,
+					     node)
+		md_resync_hint_free(hint);
+
+	tree->root = RB_ROOT_CACHED;
+	tree->count = 0;
+}
+
+int __init md_resync_hint_init(void)
+{
+	md_resync_hint_cache = kmem_cache_create("md_resync_hint",
+						 sizeof(struct md_resync_hint),
+						 0, 0, NULL);
+	return md_resync_hint_cache ? 0 : -ENOMEM;
+}
+
+void md_resync_hint_exit(void)
+{
+	kmem_cache_destroy(md_resync_hint_cache);
+}
diff --git a/drivers/md/md.c b/drivers/md/md.c
index 25d33ab62..34f9baee7 100644
--- a/drivers/md/md.c
+++ b/drivers/md/md.c
@@ -101,6 +101,274 @@ static void mddev_detach(struct mddev *mddev);
 static void export_rdev(struct md_rdev *rdev);
 static void md_wakeup_thread_directly(struct md_thread __rcu **thread);
 
+/* fnnas: bios ending with this end_io are discards the member disk can't do */
+static void md_end_clone_discard_unsupported(struct bio *bio);
+
+void md_mark_discard_unsupported(struct bio *bio)
+{
+	bio->bi_end_io = md_end_clone_discard_unsupported;
+}
+EXPORT_SYMBOL_GPL(md_mark_discard_unsupported);
+
+/*
+ * fnnas: MD_HAS_WRITE_ZEROES is set if all working member disks unmap on
+ * write zeroes, MD_NO_DISCARD is set if none of them supports discard.
+ */
+void md_update_rdev_capabilities(struct mddev *mddev)
+{
+	struct md_rdev *rdev;
+	bool write_zeroes = true;
+	bool discard = false;
+
+	rdev_for_each(rdev, mddev) {
+		if (rdev->raid_disk < 0 || test_bit(Faulty, &rdev->flags))
+			continue;
+
+		write_zeroes &= bdev_write_zeroes_unmap_sectors(rdev->bdev) ==
+				UINT_MAX;
+		discard |= !!bdev_max_discard_sectors(rdev->bdev);
+	}
+
+	if (write_zeroes)
+		set_bit(MD_HAS_WRITE_ZEROES, &mddev->flags);
+	else
+		clear_bit(MD_HAS_WRITE_ZEROES, &mddev->flags);
+
+	if (discard)
+		clear_bit(MD_NO_DISCARD, &mddev->flags);
+	else
+		set_bit(MD_NO_DISCARD, &mddev->flags);
+}
+EXPORT_SYMBOL_GPL(md_update_rdev_capabilities);
+
+static sector_t md_status_max_sectors(struct mddev *mddev)
+{
+	if (test_bit(MD_RECOVERY_SYNC, &mddev->recovery) ||
+	    test_bit(MD_RECOVERY_RESHAPE, &mddev->recovery))
+		return mddev->resync_max_sectors;
+	else
+		return mddev->dev_sectors;
+}
+
+static sector_t md_status_resync(struct mddev *mddev, sector_t max_sectors)
+{
+	sector_t resync, res;
+
+	resync = mddev->curr_resync;
+	if (resync < MD_RESYNC_ACTIVE) {
+		if (test_bit(MD_RECOVERY_DONE, &mddev->recovery))
+			/* Still cleaning up */
+			resync = max_sectors;
+	} else if (resync > max_sectors) {
+		resync = max_sectors;
+	} else {
+		res = atomic_read(&mddev->recovery_active);
+		/*
+		 * Resync has started, but the subtraction has overflowed or
+		 * yielded one of the special values. Force it to active to
+		 * ensure the status reports an active resync.
+		 */
+		if (resync < res || resync - res < MD_RESYNC_ACTIVE)
+			resync = MD_RESYNC_ACTIVE;
+		else
+			resync -= res;
+	}
+
+	return resync;
+}
+
+/*
+ * fnnas: estimated seconds to finish the sync, the remaining sectors are
+ * reported by llbitmap if possible (only dirty bits need to be synced).
+ *
+ * dt: time from mark until now
+ * db: blocks written from mark until now
+ * rt: remaining time
+ *
+ * We scale the divisor (db) by 32 to avoid losing precision near the end of
+ * resync when the number of remaining sectors is close to 'db'.  We then
+ * divide rt by 32 after multiplying by db to compensate.  The '+1' avoids
+ * division by zero if db is very small.
+ */
+static sector_t md_sync_finish_time_secs(struct mddev *mddev, sector_t resync,
+					 sector_t max_sectors, long *speed)
+{
+	unsigned long dt, db = 0;
+	sector_t rt, curr_mark_cnt, resync_mark_cnt;
+	int recovery_active;
+
+	dt = ((jiffies - mddev->resync_mark) / HZ);
+	if (!dt) dt++;
+
+	curr_mark_cnt = mddev->curr_mark_cnt;
+	recovery_active = atomic_read(&mddev->recovery_active);
+	resync_mark_cnt = mddev->resync_mark_cnt;
+
+	if (curr_mark_cnt >= (recovery_active + resync_mark_cnt))
+		db = curr_mark_cnt - (recovery_active + resync_mark_cnt);
+
+	if (speed)
+		*speed = db/2/dt;
+
+	/* number of remaining sectors */
+	rt = md_llbitmap_sync_remaining(mddev, resync, max_sectors);
+	rt = div64_u64(rt, db/32+1);
+	rt *= dt;
+	rt >>= 5;
+
+	return rt;
+}
+
+/* fnnas: user requested resync (sync_action=repair) is running */
+static bool md_is_requested_resyncing(struct mddev *mddev)
+{
+	return test_bit(MD_RECOVERY_RUNNING, &mddev->recovery) &&
+	       !test_bit(MD_RECOVERY_RESHAPE, &mddev->recovery) &&
+	       test_bit(MD_RECOVERY_SYNC, &mddev->recovery) &&
+	       test_bit(MD_RECOVERY_REQUESTED, &mddev->recovery) &&
+	       !test_bit(MD_RECOVERY_CHECK, &mddev->recovery);
+}
+
+/*
+ * fnnas: recovery of a member disk is running, and it's not a replacement,
+ * hence data that the filesystem doesn't use can be skipped.
+ */
+static bool md_is_rebuilding(struct mddev *mddev)
+{
+	struct md_rdev *rdev;
+	bool ret = false;
+
+	if (test_bit(MD_RECOVERY_RUNNING, &mddev->recovery) &&
+	    !test_bit(MD_RECOVERY_RESHAPE, &mddev->recovery) &&
+	    !test_bit(MD_RECOVERY_SYNC, &mddev->recovery))
+		ret = test_bit(MD_RECOVERY_RECOVER, &mddev->recovery);
+
+	rcu_read_lock();
+	rdev_for_each_rcu(rdev, mddev) {
+		if (rdev->raid_disk >= 0 &&
+		    test_bit(WantReplacement, &rdev->flags)) {
+			ret = false;
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return ret;
+}
+
+/*
+ * fnnas: called by personality sync_request() while rebuilding, if the
+ * unused ranges reported by the filesystem (mddev->resync_rh_tree) cover
+ * @sector_nr, return the number of sectors that can be skipped.  Ranges
+ * that are synced instead are recorded in mddev->resync_sh_tree, so that the
+ * following requested resync only needs to sync the skipped ranges.
+ */
+sector_t md_speedup_resync(struct mddev *mddev, sector_t sector_nr)
+{
+	struct md_resync_hint *hint;
+	sector_t last, skipped;
+	sector_t h_start = 0, h_end = 0;
+	sector_t start = 0, end = 0;
+
+	if (WARN_ON(!mddev->pers))
+		return 0;
+
+	last = mddev->last_resync_start;
+	if (!md_is_rebuilding(mddev) ||
+	    !mddev->pers->align_chunk_addr_virt_to_dev)
+		return 0;
+
+	if (!mutex_trylock(&mddev->resync_rh_mutex))
+		return 0;
+
+	hint = md_resync_hint_first(&mddev->resync_rh_tree);
+	while (hint) {
+		mddev->pers->align_chunk_addr_virt_to_dev(mddev, hint->h_start,
+							  0, &start, NULL);
+		if (sector_nr < start)
+			break;
+
+		h_start = hint->h_start;
+		do {
+			h_end = max(h_end, hint->h_end);
+			md_resync_hint_remove(&mddev->resync_rh_tree, hint);
+			md_resync_hint_free(hint);
+			hint = md_resync_hint_first(&mddev->resync_rh_tree);
+		} while (hint && hint->h_start <= h_end);
+	}
+	mutex_unlock(&mddev->resync_rh_mutex);
+
+	mddev->pers->align_chunk_addr_virt_to_dev(mddev, h_start, h_end,
+						  &start, &end);
+	if (max(start, sector_nr) >= end)
+		return 0;
+
+	skipped = end - sector_nr;
+	mddev->resync_rh_skipped_sectors += skipped;
+	if (mddev->enable_requested_resync_hints && last < sector_nr) {
+		if (md_resync_hint_add(&mddev->resync_sh_tree, last, sector_nr,
+				       GFP_KERNEL))
+			pr_err("%s: failed to add requested resync hint\n",
+			       mdname(mddev));
+		mddev->last_resync_start = end;
+	}
+
+	return skipped;
+}
+EXPORT_SYMBOL(md_speedup_resync);
+
+/*
+ * fnnas: called by personality sync_request() while requested resync, ranges
+ * in mddev->resync_sh_tree are synced by previous rebuilding, skip them.
+ */
+sector_t md_speedup_requested_resync(struct mddev *mddev, sector_t sector_nr)
+{
+	struct md_resync_hint *hint;
+	sector_t h_end = 0;
+
+	if (WARN_ON(!mddev->pers))
+		return 0;
+
+	if (!md_is_requested_resyncing(mddev) ||
+	    !mddev->enable_requested_resync_hints ||
+	    mddev->resync_max_sectors != mddev->dev_sectors)
+		return 0;
+
+	hint = md_resync_hint_first(&mddev->resync_sh_tree);
+	if (!hint)
+		return 0;
+
+	while (hint && sector_nr >= hint->h_start) {
+		h_end = hint->h_end;
+		md_resync_hint_remove(&mddev->resync_sh_tree, hint);
+		md_resync_hint_free(hint);
+		hint = md_resync_hint_first(&mddev->resync_sh_tree);
+	}
+
+	if (sector_nr >= h_end)
+		return 0;
+
+	return h_end - sector_nr;
+}
+EXPORT_SYMBOL(md_speedup_requested_resync);
+
+bool md_sb_pending(struct mddev *mddev)
+{
+	return test_bit(MD_SB_CHANGE_PENDING, &mddev->sb_flags) &&
+	       !md_dfr_started(mddev);
+}
+EXPORT_SYMBOL_GPL(md_sb_pending);
+
+void md_report_failure(struct mddev *mddev, enum md_failure failure)
+{
+	if (WARN_ON(failure >= NR_MD_FAILURES))
+		return;
+
+	set_bit(failure, &mddev->failures);
+	sysfs_notify_dirent_safe(mddev->sysfs_failures);
+}
+EXPORT_SYMBOL(md_report_failure);
+
 /*
  * Default number of read corrections we'll attempt on an rdev
  * before ejecting it from the array. We divide the read error
@@ -342,6 +610,10 @@ static int start_readonly;
 static bool create_on_open = true;
 static bool legacy_async_del_gendisk = true;
 static bool check_new_feature = true;
+/* fnnas: skip unused (REQ_OP_UNUSED_HINT) ranges while rebuilding */
+static int enable_fast_resync = 1;
+/* fnnas: unused hints smaller than 1MiB are ignored */
+#define MD_RESYNC_HINT_MIN_SECTORS	2048
 
 /*
  * We have a system wide 'event count' that is incremented
@@ -395,6 +667,96 @@ static bool is_suspended(struct mddev *mddev, struct bio *bio)
 	return true;
 }
 
+static void md_clone_bio(struct mddev *mddev, struct bio **bio,
+			 sector_t offset, unsigned long sectors);
+static bool md_handle_discard_range(struct mddev *mddev, struct bio *bio,
+				    sector_t array_start, sector_t array_end,
+				    blk_opf_t opf);
+
+static inline bool md_level_is_raid456(int level)
+{
+	return level == 4 || level == 5 || level == 6;
+}
+
+/*
+ * fnnas: with llbitmap and MD_FAST_DISCARD, discard is not passed to the
+ * personality, md discards the member disks directly and llbitmap records
+ * the discarded ranges (no resync is needed for them).
+ */
+static inline bool md_can_fast_discard(struct mddev *mddev)
+{
+	return !mddev_is_dm(mddev) && mddev->pers &&
+	       mddev->pers->map_sector &&
+	       mddev->bitmap_id == ID_LLBITMAP &&
+	       test_bit(MD_FAST_DISCARD, &mddev->flags);
+}
+
+/* Return true if the discard bio is handled. */
+static bool md_fast_discard(struct mddev *mddev, struct bio *bio)
+{
+	sector_t start, end;
+	bool ret;
+
+	if ((bio->bi_opf & REQ_PREFLUSH) && md_flush_request(mddev, bio))
+		return true;
+
+	if (!bio_sectors(bio))
+		goto endio;
+
+	/* reshape is not supported */
+	if ((md_level_is_raid456(mddev->level) || mddev->level == 10) &&
+	    mddev->reshape_position != MaxSector)
+		goto endio;
+
+	md_write_start(mddev, bio);
+	if (md_level_is_raid456(mddev->level)) {
+		/*
+		 * Only full stripes can be discarded, and parity is kept
+		 * consistent by write zeroes to all member disks.
+		 */
+		unsigned int stripe_sectors =
+			bdev_get_queue(bio->bi_bdev)->limits.chunk_sectors;
+
+		if (WARN_ON(!stripe_sectors)) {
+			bio_io_error(bio);
+			goto end_write;
+		}
+
+		start = roundup(bio->bi_iter.bi_sector, stripe_sectors);
+		end = rounddown(bio_end_sector(bio), stripe_sectors);
+		if (start >= end) {
+			bio_endio(bio);
+			goto end_write;
+		}
+
+		if (!test_bit(MD_HAS_WRITE_ZEROES, &mddev->flags)) {
+			percpu_ref_get(&mddev->active_io);
+			md_clone_bio(mddev, &bio, start, end - start);
+			md_mark_discard_unsupported(bio);
+			bio->bi_status = BLK_STS_NOTSUPP;
+			bio_endio(bio);
+			goto end_write;
+		}
+
+		if (!md_handle_discard_range(mddev, bio, start, end,
+					     REQ_OP_WRITE_ZEROES))
+			bio_endio(bio);
+		goto end_write;
+	}
+
+	ret = md_handle_discard_range(mddev, bio, bio->bi_iter.bi_sector,
+				      bio_end_sector(bio), REQ_OP_DISCARD);
+	md_write_end(mddev);
+	return ret;
+
+end_write:
+	md_write_end(mddev);
+	return true;
+endio:
+	bio_endio(bio);
+	return true;
+}
+
 bool md_handle_request(struct mddev *mddev, struct bio *bio)
 {
 check_suspended:
@@ -430,6 +792,10 @@ bool md_handle_request(struct mddev *mddev, struct bio *bio)
 		percpu_ref_put(&mddev->active_io);
 		return true;
 	}
+	if (bio_op(bio) == REQ_OP_DISCARD && md_can_fast_discard(mddev) &&
+	    md_fast_discard(mddev, bio))
+		goto out;
+
 	if (!mddev->pers->make_request(mddev, bio)) {
 		percpu_ref_put(&mddev->active_io);
 		if (!mddev->gendisk && mddev->pers->prepare_suspend)
@@ -437,6 +803,7 @@ bool md_handle_request(struct mddev *mddev, struct bio *bio)
 		goto check_suspended;
 	}
 
+out:
 	percpu_ref_put(&mddev->active_io);
 	return true;
 }
@@ -468,6 +835,38 @@ static void md_submit_bio(struct bio *bio)
 		return;
 	}
 
+	/*
+	 * fnnas: the filesystem reports that this range is unused, while a
+	 * member disk is rebuilding, remember it so that md_do_sync() can
+	 * skip it (see md_speedup_resync()).
+	 */
+	if (bio_op(bio) == REQ_OP_UNUSED_HINT) {
+		sector_t start = bio->bi_iter.bi_sector;
+		unsigned int nr = bio_sectors(bio);
+		sector_t dev_start = 0;
