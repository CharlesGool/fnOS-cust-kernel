+/* fnnas: end_io of the discard bio to a member disk */
+static void md_end_discard_io(struct bio *bio)
+{
+	struct md_io_clone *md_io_clone = bio->bi_private;
+	struct bio *orig_bio = md_io_clone->orig_bio;
+
+	if (bio->bi_status && !orig_bio->bi_status)
+		orig_bio->bi_status = bio->bi_status;
+
+	rdev_dec_pending(md_io_clone->rdev, md_io_clone->mddev);
+	md_write_end(md_io_clone->mddev);
+	bio_put(bio);
+	bio_endio(orig_bio);
