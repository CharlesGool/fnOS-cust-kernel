+/*
+ * fnnas: discard (or write zeroes) the array range [array_start, array_end)
+ * on all working member disks directly, the range is converted by
+ * pers->map_sector(), and llbitmap tracks the discarded range.
+ *
+ * Return true if the bio is handled.
+ */
+static bool md_handle_discard_range(struct mddev *mddev, struct bio *bio,
+				    sector_t array_start, sector_t array_end,
+				    blk_opf_t opf)
+{
+	struct md_rdev *rdev;
+	bool submitted = false;
+
+	percpu_ref_get(&mddev->active_io);
+	md_clone_bio(mddev, &bio, array_start, array_end - array_start);
+
+	if (opf == REQ_OP_DISCARD && test_bit(MD_NO_DISCARD, &mddev->flags)) {
+		bio->bi_status = BLK_STS_NOTSUPP;
+		bio_endio(bio);
+		return true;
+	}
+
+	rdev_for_each(rdev, mddev) {
+		struct md_io_clone *md_io_clone;
+		struct bio *discard_bio;
+		sector_t dev_start, dev_end;
+
+		if (rdev->raid_disk < 0 || test_bit(Faulty, &rdev->flags))
+			continue;
+
+		dev_start = mddev->pers->map_sector(mddev, rdev, array_start);
+		dev_end = mddev->pers->map_sector(mddev, rdev, array_end);
+		if (dev_start >= dev_end || dev_end == MaxSector)
+			continue;
+
+		if (opf == REQ_OP_DISCARD &&
+		    !bdev_max_discard_sectors(rdev->bdev)) {
+			submitted = true;
+			continue;
+		}
+
+		discard_bio = bio_alloc_bioset(rdev->bdev, 0, opf, GFP_NOIO,
+					       &mddev->io_clone_set);
+		md_io_clone = container_of(discard_bio, struct md_io_clone,
+					   bio_clone);
+		md_io_clone->rdev = rdev;
+		md_io_clone->mddev = mddev;
+		md_io_clone->orig_bio = bio;
+		discard_bio->bi_private = md_io_clone;
+		discard_bio->bi_end_io = md_end_discard_io;
+		discard_bio->bi_iter.bi_sector = dev_start;
+		discard_bio->bi_iter.bi_size = (dev_end - dev_start) << 9;
+
+		atomic_inc(&rdev->nr_pending);
+		md_write_inc(mddev, discard_bio);
+		bio_inc_remaining(bio);
+		bio_clone_blkg_association(discard_bio, bio);
+		mddev_trace_remap(mddev, discard_bio, array_start);
+		submit_bio_noacct(discard_bio);
+		submitted = true;
+	}
+
+	if (submitted) {
+		bio_endio(bio);
+		return true;
+	}
+
+	md_free_cloned_bio(bio);
+	return false;
