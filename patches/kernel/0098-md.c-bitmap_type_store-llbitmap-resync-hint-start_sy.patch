+
 		queue_limits_stack_bdev(lim, rdev->bdev, rdev->data_offset,
 					mddev->gendisk->disk_name);
 		if ((flags & MDDEV_STACK_INTEGRITY) &&
 		    !queue_limits_stack_integrity_bdev(lim, rdev->bdev))
 			return -EINVAL;
+
+		/* fnnas: keep the optimal io size the personality set */
+		if (rdev->bdev->bd_disk->fops != &md_fops && io_opt)
+			lim->io_opt = old_io_opt;
 	}
 
 	/*
@@ -6912,9 +7046,11 @@ int mddev_stack_rdev_limits(struct mddev *mddev, struct queue_limits *lim,
 EXPORT_SYMBOL_GPL(mddev_stack_rdev_limits);
 
 /* apply the extra stacking limits from a new rdev into mddev */
-int mddev_stack_new_rdev(struct mddev *mddev, struct md_rdev *rdev)
+int mddev_stack_new_rdev(struct mddev *mddev, struct md_rdev *rdev,
+			 bool keep_io_opt)
 {
 	struct queue_limits lim;
+	unsigned int io_opt;
 
 	if (mddev_is_dm(mddev))
 		return 0;
@@ -6927,6 +7063,7 @@ int mddev_stack_new_rdev(struct mddev *mddev, struct md_rdev *rdev)
 	}
 
 	lim = queue_limits_start_update(mddev->gendisk->queue);
+	io_opt = lim.io_opt;
 	queue_limits_stack_bdev(&lim, rdev->bdev, rdev->data_offset,
 				mddev->gendisk->disk_name);
 
@@ -6937,6 +7074,10 @@ int mddev_stack_new_rdev(struct mddev *mddev, struct md_rdev *rdev)
 		return -ENXIO;
 	}
 
+	/* fnnas: keep the optimal io size of the array */
+	if (rdev->bdev->bd_disk->fops != &md_fops && keep_io_opt)
+		lim.io_opt = io_opt;
+
 	return queue_limits_commit_update(mddev->gendisk->queue, &lim);
 }
 EXPORT_SYMBOL_GPL(mddev_stack_new_rdev);
@@ -7082,6 +7223,7 @@ struct mddev *md_alloc(dev_t dev, char *name)
 	kobject_uevent(&mddev->kobj, KOBJ_ADD);
 	mddev->sysfs_state = sysfs_get_dirent_safe(mddev->kobj.sd, "array_state");
 	mddev->sysfs_level = sysfs_get_dirent_safe(mddev->kobj.sd, "level");
+	mddev->sysfs_failures = sysfs_get_dirent_safe(mddev->kobj.sd, "failures");
 	mutex_unlock(&disks_mutex);
 	return mddev;
 
@@ -7504,6 +7646,8 @@ int md_run(struct mddev *mddev)
 	} else if (mddev->ro == MD_AUTO_READ)
 		mddev->ro = MD_RDWR;
 
+	md_update_rdev_capabilities(mddev);
+
 	atomic_set(&mddev->max_corr_read_errors,
 		   MD_DEFAULT_MAX_CORRECTED_READ_ERRORS);
 	mddev->safemode = 0;
@@ -7772,6 +7916,11 @@ static void __md_stop(struct mddev *mddev)
 	mddev->private = NULL;
 	put_pers(pers);
 	clear_bit(MD_RECOVERY_FROZEN, &mddev->recovery);
+
+	mutex_lock(&mddev->resync_rh_mutex);
+	md_resync_hint_tree_clear(&mddev->resync_rh_tree);
+	mutex_unlock(&mddev->resync_rh_mutex);
+	md_resync_hint_tree_clear(&mddev->resync_sh_tree);
 }
 
 void md_stop(struct mddev *mddev)
@@ -9911,8 +10060,8 @@ void md_sync_error(struct mddev *mddev)
 		md_report_failure(mddev, MD_FAILURE_RESYNC);
 
 	// stop recovery, signal do_sync ....
-	set_bit(MD_RECOVERY_ERROR, &mddev->recovery);
 	set_bit(MD_RECOVERY_INTR, &mddev->recovery);
+	set_bit(MD_RECOVERY_ERROR, &mddev->recovery);
 	md_wakeup_thread(mddev->thread);
 }
 EXPORT_SYMBOL(md_sync_error);
@@ -10324,39 +10473,6 @@ static sector_t md_sync_max_sectors(struct mddev *mddev,
 	}
 }
 
-/*
- * If lazy recovery is requested and all rdevs are in sync, select the rdev with
- * the higest index to perfore recovery to build initial xor data, this is the
