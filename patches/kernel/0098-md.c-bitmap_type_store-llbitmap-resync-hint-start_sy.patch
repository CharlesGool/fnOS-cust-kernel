-	}
+	md_dfr_clear_sync_takeover(mddev);
 
 	if (!test_bit(MD_RECOVERY_RESHAPE, &mddev->recovery) &&
 	    !test_bit(MD_RECOVERY_INTR, &mddev->recovery) &&
@@ -10800,12 +10930,29 @@ void md_do_sync(struct md_thread *thread)
 		if (test_bit(MD_RECOVERY_REQUESTED, &mddev->recovery))
 			mddev->resync_min = 0;
 		mddev->resync_max = MaxSector;
+		completed = true;
 	} else if (test_bit(MD_RECOVERY_REQUESTED, &mddev->recovery))
 		mddev->resync_min = mddev->curr_resync_completed;
 	set_bit(MD_RECOVERY_DONE, &mddev->recovery);
 	mddev->curr_resync = MD_RESYNC_NONE;
 	spin_unlock(&mddev->lock);
 
+	if (rebuilding) {
+		mutex_lock(&mddev->resync_rh_mutex);
+		md_resync_hint_tree_clear(&mddev->resync_rh_tree);
+		mutex_unlock(&mddev->resync_rh_mutex);
+	} else if (md_is_requested_resyncing(mddev)) {
+		md_resync_hint_tree_clear(&mddev->resync_sh_tree);
+		mddev->enable_requested_resync_hints = false;
+		if (completed && md_level_is_raid456(mddev->level) &&
+		    (mddev->ext_status & MD_SB_1_EXT_STATUS_FAST_RESCYNC))
+			mddev->ext_status &= ~MD_SB_1_EXT_STATUS_FAST_RESCYNC;
+		rcu_read_lock();
+		rdev_for_each_rcu(rdev, mddev)
+			clear_bit(NonFullInsync, &rdev->flags);
+		rcu_read_unlock();
+	}
+
 	wake_up(&resync_wait);
 	md_wakeup_thread(mddev->thread);
 	return;
@@ -10972,7 +11119,6 @@ static bool md_choose_sync_action(struct mddev *mddev, int *spares)
 
 		set_bit(MD_RECOVERY_RESHAPE, &mddev->recovery);
 		clear_bit(MD_RECOVERY_RECOVER, &mddev->recovery);
-		clear_bit(MD_RECOVERY_LAZY_RECOVER, &mddev->recovery);
