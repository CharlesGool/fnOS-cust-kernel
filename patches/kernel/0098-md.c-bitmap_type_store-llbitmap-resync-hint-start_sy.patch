Subject: [PATCH 098/110] =?UTF-8?q?md.c:=20=E8=A1=A5=E9=BD=90=20bitmap=5Ft?=
 =?UTF-8?q?ype=5Fstore=20=E5=9C=A8=E7=BA=BF=E8=BD=AC=20llbitmap=E3=80=81re?=
 =?UTF-8?q?sync=20hint=20=E5=88=9D=E5=A7=8B=E5=8C=96/=E6=B8=85=E7=90=86?=
 =?UTF-8?q?=E3=80=81start=5Fsync/check=5Frecovery=20=E7=9A=84=20DFR=20?=
 =?UTF-8?q?=E5=88=A4=E6=96=AD=E7=AD=89?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- bitmap_type_store: 运行中的阵列只能转 llbitmap(MD_LLBITMAP_CONVERTING, 失败回滚)
- md_do_sync: 重建/请求重同步的 hint 树清理, 结束后清 NonFullInsync/FAST_RESCYNC
- md_start_sync/md_check_recovery: DFR 起动时不拉起同步; 去掉飞牛没有的 MD_RECOVERY_LAZY_RECOVER
- mddev_init 初始化 hint 树和 mutex, md_alloc 取 failures dirent, add_bound_rdev/md_run 更新 rdev 能力位
- mddev_stack_rdev_limits/mddev_stack_new_rdev 保留 personality 设置的 io_opt(新增 keep_io_opt 参数)
- md_init_stacking_limits 去掉 BLK_FEAT_NOWAIT, md_sync_error 置位顺序

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/md/md.c     | 318 +++++++++++++++++++++++++++++++++-----------
 drivers/md/md.h     |   9 +-
 drivers/md/raid1.c  |   2 +-
 drivers/md/raid10.c |   4 +-
 4 files changed, 246 insertions(+), 87 deletions(-)

diff --git a/drivers/md/md.c b/drivers/md/md.c
index d500c8ece..1a9f9d5c6 100644
--- a/drivers/md/md.c
+++ b/drivers/md/md.c
@@ -1201,6 +1201,9 @@ int mddev_init(struct mddev *mddev)
 	spin_lock_init(&mddev->lock);
 	init_waitqueue_head(&mddev->sb_wait);
 	init_waitqueue_head(&mddev->recovery_wait);
+	md_resync_hint_tree_init(&mddev->resync_rh_tree);
+	mutex_init(&mddev->resync_rh_mutex);
+	md_resync_hint_tree_init(&mddev->resync_sh_tree);
 	mddev->reshape_position = MaxSector;
 	mddev->reshape_backwards = 0;
 	mddev->last_sync_action = ACTION_IDLE;
@@ -3452,6 +3455,7 @@ static int add_bound_rdev(struct md_rdev *rdev)
 			md_kick_rdev_from_array(rdev);
 			return err;
 		}
+		md_update_rdev_capabilities(mddev);
 	}
 	sysfs_notify_dirent_safe(rdev->sysfs_state);
 
@@ -4800,48 +4804,169 @@ bitmap_type_store(struct mddev *mddev, const char *buf, size_t len)
 {
 	struct md_submodule_head *head;
 	enum md_submodule_id id;
+	struct bitmap_operations *old_ops;
+	void *old_bitmap;
+	enum md_submodule_id old_id;
+	loff_t old_offset;
+	unsigned long old_space;
 	unsigned long i;
-	int err = 0;
+	int err;
 
 	xa_lock(&md_submodule);
 
-	if (mddev->bitmap_ops) {
-		err = -EBUSY;
-		goto out;
-	}
-
 	if (cmd_match(buf, "none")) {
-		mddev->bitmap_id = ID_BITMAP_NONE;
-		goto out;
+		id = ID_BITMAP_NONE;
+		goto found;
 	}
 
 	xa_for_each(&md_submodule, i, head) {
 		if (head->type == MD_BITMAP && cmd_match(buf, head->name)) {
-			mddev->bitmap_id = head->id;
-			goto out;
+			id = head->id;
+			goto found;
 		}
 	}
 
 	err = kstrtoint(buf, 10, &id);
-	if (err)
-		goto out;
+	if (err) {
+		xa_unlock(&md_submodule);
+		return err;
+	}
 
-	if (id == ID_BITMAP_NONE) {
-		mddev->bitmap_id = id;
-		goto out;
+	if (id != ID_BITMAP_NONE) {
+		head = xa_load(&md_submodule, id);
+		if (!head || head->type != MD_BITMAP) {
+			xa_unlock(&md_submodule);
+			return -ENOENT;
+		}
 	}
 
-	head = xa_load(&md_submodule, id);
-	if (head && head->type == MD_BITMAP) {
+found:
+	xa_unlock(&md_submodule);
+
+	if (!mddev->pers && !mddev->bitmap_ops) {
 		mddev->bitmap_id = id;
-		goto out;
+		return len;
 	}
 
-	err = -ENOENT;
+	/* fnnas: a running array can only switch to llbitmap */
+	if (id != ID_LLBITMAP)
+		return -EBUSY;
 
-out:
-	xa_unlock(&md_submodule);
-	return err ? err : len;
+	old_id = mddev->bitmap_id;
+	old_ops = mddev->bitmap_ops;
+	old_bitmap = mddev->bitmap;
+	old_offset = mddev->bitmap_info.offset;
+	old_space = mddev->bitmap_info.space;
+
+	err = mddev_suspend(mddev, true);
+	if (err)
+		return err;
+
+	err = mutex_lock_interruptible(&mddev->reconfig_mutex);
+	if (err) {
+		mddev_resume(mddev);
+		return err;
+	}
+
+	if (test_bit(MD_DELETED, &mddev->flags)) {
+		mutex_unlock(&mddev->reconfig_mutex);
+		err = -ENODEV;
+		goto out_resume;
+	}
+
+	if (mddev->bitmap_id == ID_LLBITMAP)
+		goto out_unlock;
+
+	/* only from the internal bitmap (or none) of a v1.x redundant array */
+	if ((mddev->bitmap_id != ID_BITMAP && mddev->bitmap_id != ID_BITMAP_NONE) ||
+	    mddev->major_version != 1 || mddev->bitmap_info.file) {
+		err = -EOPNOTSUPP;
+		goto out_unlock_err;
+	}
+
+	if (mddev->bitmap_info.external || mddev->bitmap_info.nodes) {
+		err = -EOPNOTSUPP;
+		goto out_unlock_err;
+	}
+
+	if (!mddev->pers || !mddev->pers->sync_request || !mddev->thread ||
+	    mddev->recovery || mddev->sync_thread) {
+		err = -EBUSY;
+		goto out_unlock_err;
+	}
+
+	mddev->bitmap_info.offset = mddev->bitmap_info.default_offset;
+	mddev->bitmap_info.space = mddev->bitmap_info.default_space;
+	set_bit(MD_LLBITMAP_CONVERTING, &mddev->flags);
+	set_bit(MD_SB_CHANGE_DEVS, &mddev->sb_flags);
+	md_update_sb(mddev, 1);
+	if (test_bit(MD_SB_NEED_REWRITE, &mddev->sb_flags)) {
+		err = -EIO;
+		goto rollback;
+	}
+
+	if (mddev->gendisk && mddev->bitmap_ops && mddev->bitmap_ops->group)
+		sysfs_remove_group(&mddev->kobj, mddev->bitmap_ops->group);
+	mddev->bitmap_ops = NULL;
+	mddev->bitmap_id = ID_LLBITMAP;
+	if (!mddev_set_bitmap_ops(mddev)) {
+		err = -ENOENT;
+		goto rollback;
+	}
+
+	if (mddev->level < 4 || mddev->level > 6)
+		set_bit(MD_RECOVERY_SYNC, &mddev->recovery);
+	set_bit(MD_ARRAY_FIRST_USE, &mddev->flags);
+	err = mddev->bitmap_ops->create(mddev);
+	clear_bit(MD_ARRAY_FIRST_USE, &mddev->flags);
+	if (err) {
+		clear_bit(MD_RECOVERY_SYNC, &mddev->recovery);
+		if (mddev->gendisk && mddev->bitmap_ops &&
+		    mddev->bitmap_ops->group)
+			sysfs_remove_group(&mddev->kobj,
+					   mddev->bitmap_ops->group);
+		mddev->bitmap_ops = NULL;
+		goto rollback;
+	}
+
+	if (old_bitmap) {
+		if (!test_bit(MD_SERIALIZE_POLICY, &mddev->flags) &&
+		    mddev->serial_info_pool)
+			mddev_destroy_serial_pool(mddev, NULL);
+		old_ops->destroy(old_bitmap);
+	}
+
+	set_bit(MD_RECOVERY_SYNC, &mddev->recovery);
+	set_bit(MD_RECOVERY_NEEDED, &mddev->recovery);
+	clear_bit(MD_LLBITMAP_CONVERTING, &mddev->flags);
+	set_bit(MD_SB_CHANGE_DEVS, &mddev->sb_flags);
+	md_update_sb(mddev, 1);
+	goto out_unlock;
+
+rollback:
+	clear_bit(MD_LLBITMAP_CONVERTING, &mddev->flags);
+	mddev->bitmap = old_bitmap;
+	mddev->bitmap_id = old_id;
+	mddev->bitmap_info.offset = old_offset;
+	mddev->bitmap_info.space = old_space;
+	mddev_set_bitmap_ops(mddev);
+	set_bit(MD_SB_CHANGE_DEVS, &mddev->sb_flags);
+	md_update_sb(mddev, 1);
+	mddev_unlock(mddev);
+	mddev_resume(mddev);
+	return err;
+
+out_unlock_err:
+	mddev_unlock(mddev);
+	mddev_resume(mddev);
+	return err;
+
+out_unlock:
+	mddev_unlock(mddev);
+	err = len;
+out_resume:
+	mddev_resume(mddev);
+	return err;
 }
 
 static struct md_sysfs_entry md_bitmap_type =
@@ -6845,6 +6970,8 @@ static void md_kobj_release(struct kobject *ko)
 			sysfs_put(mddev->sysfs_state);
