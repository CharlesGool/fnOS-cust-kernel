diff --git a/fs/trim_acl.c b/fs/trim_acl.c
new file mode 100755
index 000000000..4bf33fa6b
--- /dev/null
+++ b/fs/trim_acl.c
@@ -0,0 +1,1861 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) T.R.I.M Inc.
+ *
+ * fnOS TRIM ACL core. Reconstructed from the fnOS 6.18.18.c1186-trim binary.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/atomic.h>
+#include <linux/fs.h>
+#include <linux/sched.h>
+#include <linux/cred.h>
+#include <linux/namei.h>
+#include <linux/mnt_idmapping.h>
+#include <linux/posix_acl.h>
+#include <linux/posix_acl_xattr.h>
+#include <linux/xattr.h>
+#include <linux/export.h>
+#include <linux/uaccess.h>
+#include <linux/debugfs.h>
+#include <linux/device_cgroup.h>
+#include <linux/trim_acl.h>
+#include <linux/trim_acl_xattr.h>
+#include <linux/trim_flags.h>
+#include <linux/trimvfs.h>
+
+/*
+ * Allocate a new ACL with the specified number of entries.
+ */
+struct trim_acl *trim_acl_alloc(int count, gfp_t flags)
+{
+	const size_t size = sizeof(struct trim_acl) + count * sizeof(struct trim_acl_entry);
+	struct trim_acl *acl = kmalloc(size, flags);
+
+	if (acl) {
+		refcount_set(&acl->a_refcount, 1);
+		acl->a_count = count;
+	}
+	return acl;
+}
+EXPORT_SYMBOL(trim_acl_alloc);
+
+/*
+ * Check if an acl is valid. Returns 0 if it is, or -E... otherwise.
+ */
+int trim_acl_valid(const struct trim_acl *acl)
+{
+	const struct trim_acl_entry *pa, *pe;
+
+	if (!acl)
+		return -EINVAL;
+
+	FOREACH_TRIMACL_ENTRY(pa, acl, pe) {
+		if (pa->e_perm & ~(TRIM_PERM_FULL_CONTROL))
+			return -EINVAL;
+		if (pa->e_tag > TRIM_ACL_TAG_ALL)
+			return -EINVAL;
+		if (pa->e_allow != TRIM_ACL_ALLOW && pa->e_allow != TRIM_ACL_DENY)
+			return -EINVAL;
+		if (pa->e_inherit & ~TRIM_ACL_INHERIT_ALL)
+			return -EINVAL;
+	}
+	return 0;
+}
+EXPORT_SYMBOL(trim_acl_valid);
+
+/*
+ * Convert from in-memory to extended attribute representation.
+ */
+int trim_acl_to_xattr(const struct trim_acl *acl, void *buffer, size_t size)
+{
+	trim_acl_xattr_header *ext_acl = buffer;
+	trim_acl_xattr_entry *ext_entry;
+	int real_size, n;
+	unsigned short tag;
+
+	if (!acl)
+		return 0;
+
+	real_size = trim_acl_xattr_size(acl->a_count);
+	if (!buffer)
+		return real_size;
+	if (real_size > size)
+		return -ERANGE;
+
+	ext_entry = ext_acl->a_entries;
+	ext_acl->a_version = cpu_to_le16(TRIM_ACL_XATTR_VERSION);
+
+	for (n = 0; n < acl->a_count; n++, ext_entry++) {
+		const struct trim_acl_entry *acl_e = &acl->a_entries[n];
+
+		switch (acl_e->e_tag) {
+		case TRIM_ACL_USER:
+			tag = TRIM_ACL_XATTR_TAG_ID_USER;
+			break;
+		case TRIM_ACL_GROUP:
+			tag = TRIM_ACL_XATTR_TAG_ID_GROUP;
+			break;
+		case TRIM_ACL_EVERYONE:
+			tag = TRIM_ACL_XATTR_TAG_ID_EVERYONE;
+			break;
+		case TRIM_ACL_OWNER:
+			tag = TRIM_ACL_XATTR_TAG_ID_OWNER;
+			break;
+		case TRIM_ACL_AUTHENTICATEDUSER:
+			tag = TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER;
+			break;
+		case TRIM_ACL_SYSTEM:
+			tag = TRIM_ACL_XATTR_TAG_ID_SYSTEM;
+			break;
+		default:
+			return -EINVAL;
+		}
+
+		switch (acl_e->e_allow) {
+		case TRIM_ACL_ALLOW:
+			tag |= TRIM_ACL_XATTR_TAG_IS_ALLOW;
+			break;
+		case TRIM_ACL_DENY:
+			tag |= TRIM_ACL_XATTR_TAG_IS_DENY;
+			break;
+		default:
+			return -EINVAL;
+		}
+
+		ext_entry->e_tag = cpu_to_le16(tag);
+		ext_entry->e_inherit = cpu_to_le16(acl_e->e_inherit);
+		ext_entry->e_perm = cpu_to_le32(acl_e->e_perm);
+		ext_entry->e_id = cpu_to_le32(acl_e->e_id);
+		ext_entry->e_level = cpu_to_le32(acl_e->e_level);
+	}
+	return real_size;
+}
+EXPORT_SYMBOL(trim_acl_to_xattr);
+
+struct trim_acl *trim_acl_clone(const struct trim_acl *acl, gfp_t flags)
+{
+	struct trim_acl *clone = NULL;
+
+	if (acl) {
+		clone = kmemdup(acl, sizeof(struct trim_acl) + acl->a_count * sizeof(struct trim_acl_entry), flags);
+		if (clone)
+			refcount_set(&clone->a_refcount, 1);
+	}
+	return clone;
+}
+EXPORT_SYMBOL(trim_acl_clone);
+
+struct trim_acl *trim_acl_realloc(struct trim_acl *acl, unsigned int counts, gfp_t flags)
+{
+	struct trim_acl *new_acl;
+
+	if (!acl)
+		return NULL;
+
+	if (refcount_read(&acl->a_refcount) != 1) {
+		printk(KERN_ERR " acl reference count: %d \n ", refcount_read(&acl->a_refcount));
+		return NULL;
+	}
+
+	new_acl = krealloc(acl, sizeof(struct trim_acl) + counts * sizeof(struct trim_acl_entry), flags);
+	if (new_acl)
+		new_acl->a_count = counts;
+	return new_acl;
+}
+EXPORT_SYMBOL(trim_acl_realloc);
+
+/*
+ * Convert from in-memory to filesystem representation.
+ */
+void *trim_acl_to_disk(const struct trim_acl *acl, size_t *size)
+{
+	trim_acl_header_t *ext_acl;
+	char *e;
+	size_t n;
+	unsigned short tag;
+
+	*size = sizeof(trim_acl_header_t) + acl->a_count * sizeof(trim_acl_entry_t);
+	ext_acl = kmalloc(*size, GFP_NOFS);
+	if (!ext_acl)
+		return ERR_PTR(-ENOMEM);
+	ext_acl->a_version = cpu_to_le16(TRIM_ACL_VERSION);
+	e = (char *)ext_acl + sizeof(trim_acl_header_t);
+	for (n = 0; n < acl->a_count; n++) {
+		const struct trim_acl_entry *acl_e = &acl->a_entries[n];
+		trim_acl_entry_t *entry = (trim_acl_entry_t *)e;
+
+		switch (acl_e->e_tag) {
+		case TRIM_ACL_USER:
+			tag = TRIM_ACL_XATTR_TAG_ID_USER;
+			break;
+		case TRIM_ACL_GROUP:
+			tag = TRIM_ACL_XATTR_TAG_ID_GROUP;
+			break;
+		case TRIM_ACL_EVERYONE:
+			tag = TRIM_ACL_XATTR_TAG_ID_EVERYONE;
+			break;
+		case TRIM_ACL_OWNER:
+			tag = TRIM_ACL_XATTR_TAG_ID_OWNER;
+			break;
+		case TRIM_ACL_AUTHENTICATEDUSER:
+			tag = TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER;
+			break;
+		case TRIM_ACL_SYSTEM:
+			tag = TRIM_ACL_XATTR_TAG_ID_SYSTEM;
+			break;
+		default:
+			goto fail;
+		}
+
+		switch (acl_e->e_allow) {
+		case TRIM_ACL_ALLOW:
+			tag |= TRIM_ACL_XATTR_TAG_IS_ALLOW;
+			break;
+		case TRIM_ACL_DENY:
+			tag |= TRIM_ACL_XATTR_TAG_IS_DENY;
+			break;
+		default:
+			goto fail;
+		}
+
+		entry->e_tag = cpu_to_le16(tag);
+		entry->e_inherit = cpu_to_le16(acl_e->e_inherit);
+		entry->e_perm = cpu_to_le32(acl_e->e_perm);
+		entry->e_id = cpu_to_le32(acl_e->e_id);
+		e += sizeof(trim_acl_entry_t);
+	}
+	return (char *)ext_acl;
+
+fail:
+	kfree(ext_acl);
+	return ERR_PTR(-EINVAL);
+}
+EXPORT_SYMBOL(trim_acl_to_disk);
+
+struct trim_acl *get_cached_trim_acl(struct inode *inode)
+{
+	struct trim_acl **p = &inode->i_trim_acl, *acl;
+
+	for (;;) {
+		rcu_read_lock();
+		acl = rcu_dereference(*p);
+		if (!acl || is_uncached_trim_acl(acl) || refcount_inc_not_zero(&acl->a_refcount))
+			break;
+		rcu_read_unlock();
+		cpu_relax();
+	}
+	rcu_read_unlock();
+	return acl;
+}
+EXPORT_SYMBOL(get_cached_trim_acl);
+
+void forget_cached_trim_acl(struct inode *inode)
+{
+	struct trim_acl *old;
+
+	old = xchg(&inode->i_trim_acl, ACL_NOT_CACHED);
+	if (!is_uncached_trim_acl(old))
+		trim_acl_release(old);
+}
+EXPORT_SYMBOL(forget_cached_trim_acl);
+
+void set_cached_trim_acl(struct inode *inode, struct trim_acl *acl)
+{
+	struct trim_acl *old;
+
+	old = xchg(&inode->i_trim_acl, trim_acl_dup(acl));
+	if (!is_uncached_trim_acl(old))
+		trim_acl_release(old);
+}
+EXPORT_SYMBOL(set_cached_trim_acl);
+
+/*
+ * Convert from extended attribute to in-memory representation.
+ */
+struct trim_acl *trim_acl_from_xattr(const void *value, size_t size)
+{
+	const trim_acl_xattr_header *header = value;
+	const trim_acl_xattr_entry *entry = (const void *)(header + 1), *end;
+	int count;
+	struct trim_acl *acl;
+	struct trim_acl_entry *acl_e;
+	unsigned short tag;
+
+	if (!value)
+		return NULL;
+	if (size < sizeof(trim_acl_xattr_header))
+		return ERR_PTR(-EINVAL);
+	if (header->a_version != cpu_to_le16(TRIM_ACL_XATTR_VERSION))
+		return ERR_PTR(-EOPNOTSUPP);
+
+	count = trim_acl_xattr_count(size);
+	if (count < 0)
+		return ERR_PTR(-EINVAL);
+	if (count == 0)
+		return NULL;
+
+	acl = trim_acl_alloc(count, GFP_KERNEL);
+	if (!acl)
+		return ERR_PTR(-ENOMEM);
+	acl_e = acl->a_entries;
+
+	for (end = entry + count; entry != end; acl_e++, entry++) {
+		tag = le16_to_cpu(entry->e_tag);
+
+		if (tag & TRIM_ACL_XATTR_TAG_ID_USER) {
+			acl_e->e_tag = TRIM_ACL_USER;
+			acl_e->e_id = le32_to_cpu(entry->e_id);
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_GROUP) {
+			acl_e->e_tag = TRIM_ACL_GROUP;
+			acl_e->e_id = le32_to_cpu(entry->e_id);
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_EVERYONE) {
+			acl_e->e_tag = TRIM_ACL_EVERYONE;
+			acl_e->e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_OWNER) {
+			acl_e->e_tag = TRIM_ACL_OWNER;
+			acl_e->e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER) {
+			acl_e->e_tag = TRIM_ACL_AUTHENTICATEDUSER;
+			acl_e->e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_SYSTEM) {
+			acl_e->e_tag = TRIM_ACL_SYSTEM;
+			acl_e->e_id = TRIM_ACL_UNDEFINED_ID;
+		} else {
+			goto fail;
+		}
+
+		if (tag & TRIM_ACL_XATTR_TAG_IS_ALLOW)
+			acl_e->e_allow = TRIM_ACL_ALLOW;
+		else if (tag & TRIM_ACL_XATTR_TAG_IS_DENY)
+			acl_e->e_allow = TRIM_ACL_DENY;
+		else
+			goto fail;
+
+		acl_e->e_perm = le32_to_cpu(entry->e_perm);
+		acl_e->e_inherit = le16_to_cpu(entry->e_inherit);
+		acl_e->e_level = le32_to_cpu(entry->e_level);
+	}
+	return acl;
+
+fail:
+	trim_acl_release(acl);
+	return ERR_PTR(-EINVAL);
+}
+EXPORT_SYMBOL(trim_acl_from_xattr);
+
+static inline int trim_acl_count(size_t size)
+{
+	size -= sizeof(trim_acl_header_t);
+	if (size % sizeof(trim_acl_entry_t))
+		return -1;
+	return size / sizeof(trim_acl_entry_t);
+}
+
+/*
+ * Convert from filesystem to in-memory representation.
+ */
+struct trim_acl *trim_acl_from_disk(const void *value, size_t size)
+{
+	int n, count;
+	struct trim_acl *acl;
+	unsigned short tag;
+
+	if (!value)
+		return NULL;
+	if (size < sizeof(trim_acl_header_t))
+		return ERR_PTR(-EINVAL);
+	if (((trim_acl_header_t *)value)->a_version != cpu_to_le16(TRIM_ACL_VERSION))
+		return ERR_PTR(-EINVAL);
+	value = (char *)value + sizeof(trim_acl_header_t);
+	count = trim_acl_count(size);
+	if (count < 0)
+		return ERR_PTR(-EINVAL);
+	if (count == 0)
+		return NULL;
+	acl = trim_acl_alloc(count, GFP_NOFS);
+	if (!acl)
+		return ERR_PTR(-ENOMEM);
+	for (n = 0; n < count; n++) {
+		trim_acl_entry_t *entry = (trim_acl_entry_t *)value;
+
+		tag = le16_to_cpu(entry->e_tag);
+		if (tag & TRIM_ACL_XATTR_TAG_ID_USER) {
+			acl->a_entries[n].e_tag = TRIM_ACL_USER;
+			acl->a_entries[n].e_id = le32_to_cpu(entry->e_id);
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_GROUP) {
+			acl->a_entries[n].e_tag = TRIM_ACL_GROUP;
+			acl->a_entries[n].e_id = le32_to_cpu(entry->e_id);
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_EVERYONE) {
+			acl->a_entries[n].e_tag = TRIM_ACL_EVERYONE;
+			acl->a_entries[n].e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_OWNER) {
+			acl->a_entries[n].e_tag = TRIM_ACL_OWNER;
+			acl->a_entries[n].e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER) {
+			acl->a_entries[n].e_tag = TRIM_ACL_AUTHENTICATEDUSER;
+			acl->a_entries[n].e_id = TRIM_ACL_UNDEFINED_ID;
+		} else if (tag & TRIM_ACL_XATTR_TAG_ID_SYSTEM) {
+			acl->a_entries[n].e_tag = TRIM_ACL_SYSTEM;
+			acl->a_entries[n].e_id = TRIM_ACL_UNDEFINED_ID;
+		} else {
+			goto fail;
+		}
+
+		if (tag & TRIM_ACL_XATTR_TAG_IS_ALLOW)
+			acl->a_entries[n].e_allow = TRIM_ACL_ALLOW;
+		else if (tag & TRIM_ACL_XATTR_TAG_IS_DENY)
+			acl->a_entries[n].e_allow = TRIM_ACL_DENY;
+		else
+			goto fail;
+
+		acl->a_entries[n].e_perm = le32_to_cpu(entry->e_perm);
+		acl->a_entries[n].e_inherit = le16_to_cpu(entry->e_inherit);
+		acl->a_entries[n].e_level = 0;
+		value = (char *)value + sizeof(trim_acl_entry_t);
+	}
+	return acl;
+
+fail:
+	trim_acl_release(acl);
+	return ERR_PTR(-EINVAL);
+}
+EXPORT_SYMBOL(trim_acl_from_disk);
+
+static struct trim_acl *get_inode_trim_acl(struct inode *inode)
+{
+	void *sentinel;
+	struct trim_acl **p;
+	struct trim_acl *acl;
+
+	acl = get_cached_trim_acl(inode);
+	if (!is_uncached_trim_acl(acl))
+		return acl;
+
+	if (!IS_TRIMACL_INODE(inode))
+		return NULL;
+
+	sentinel = uncached_acl_sentinel(current);
+	p = &inode->i_trim_acl;
+
+	/*
+	 * Same protocol as __get_acl(): mark the cache slot with a
+	 * per-task sentinel so a concurrent set/forget invalidates us.
+	 */
+	cmpxchg(p, ACL_NOT_CACHED, sentinel);
+
+	if (!inode->i_op->get_trim_acl) {
+		set_cached_trim_acl(inode, NULL);
+		return NULL;
+	}
+
+	acl = inode->i_op->get_trim_acl(&nop_mnt_idmap, inode);
+	if (IS_ERR(acl)) {
+		cmpxchg(p, sentinel, ACL_NOT_CACHED);
+		return acl;
+	}
+
+	trim_acl_dup(acl);
+	if (unlikely(!try_cmpxchg(p, &sentinel, acl)))
+		trim_acl_release(acl);
+	return acl;
+}
