diff --git a/fs/attr.c b/fs/attr.c
index 3f2cce4e4..acada3a44 100644
--- a/fs/attr.c
+++ b/fs/attr.c
@@ -16,6 +16,7 @@
 #include <linux/fcntl.h>
 #include <linux/filelock.h>
 #include <linux/security.h>
+#include <linux/trim_acl.h>
 
 /**
  * setattr_should_drop_sgid - determine whether the setgid bit needs to be
@@ -106,6 +107,26 @@ static bool chown_ok(struct mnt_idmap *idmap,
 	return false;
 }
 
+/*
+ * trim_chown_ok - chown check used for volume admins/home owners
+ *
+ * Unlike chown_ok(), the caller may take ownership (chown to itself)
+ * even when it does not own the inode yet.
+ */
+static bool trim_chown_ok(struct mnt_idmap *idmap,
+			  const struct inode *inode, vfsuid_t ia_vfsuid)
+{
+	vfsuid_t vfsuid = i_uid_into_vfsuid(idmap, inode);
+	if (vfsuid_eq_kuid(ia_vfsuid, current_fsuid()))
+		return true;
+	if (capable_wrt_inode_uidgid(idmap, inode, CAP_CHOWN))
+		return true;
+	if (!vfsuid_valid(vfsuid) &&
+	    ns_capable(inode->i_sb->s_user_ns, CAP_CHOWN))
+		return true;
+	return false;
+}
+
 /**
  * chgrp_ok - verify permissions to chgrp inode
  * @idmap:	idmap of the mount @inode was found from
@@ -163,6 +184,7 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 {
 	struct inode *inode = d_inode(dentry);
 	unsigned int ia_valid = attr->ia_valid;
+	int ret;
 
 	/*
 	 * First check size constraints.  These can't be overriden using
@@ -184,6 +206,34 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 			return error;
 	}
 
+	/* Volume admins and home owners skip the owner checks below. */
+	ret = vol_is_admin_or_homeowner(idmap, dentry);
+	if (ret) {
+		if (ret != 1) {
+			if ((ia_valid & ATTR_UID) &&
+			    !trim_chown_ok(idmap, inode, attr->ia_vfsuid))
+				return -EPERM;
+			if ((ia_valid & ATTR_GID) &&
+			    !chgrp_ok(idmap, inode, attr->ia_vfsgid))
+				return -EPERM;
+		}
+		ia_valid |= ATTR_FORCE;
+	}
+
+	/* Taking ownership is allowed by the MAY_GET_OWNER_SHIP ACL right. */
+	if (IS_TRIMACL(dentry)) {
+		enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+		int error = trimacl_resolve_policy(dentry, 0, &policy);
+
+		if (error)
+			return error;
+		if (policy == TRIMACL_POLICY_TRIM &&
+		    (ia_valid & (ATTR_UID | ATTR_FORCE)) == ATTR_UID &&
+		    trim_chown_ok(idmap, inode, attr->ia_vfsuid) &&
+		    !trimacl_check_acl(idmap, dentry, MAY_GET_OWNER_SHIP, NULL))
+			ia_valid &= ~ATTR_UID;
+	}
+
 	/* If force is set do it anyway. */
 	if (ia_valid & ATTR_FORCE)
 		goto kill_priv;
@@ -369,9 +419,10 @@ void setattr_copy(struct mnt_idmap *idmap, struct inode *inode,
 }
 EXPORT_SYMBOL(setattr_copy);
 
-int may_setattr(struct mnt_idmap *idmap, struct inode *inode,
+int may_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
 		unsigned int ia_valid)
 {
+	struct inode *inode = d_inode(dentry);
 	int error;
 
 	if (ia_valid & (ATTR_MODE | ATTR_UID | ATTR_GID | ATTR_TIMES_SET)) {
@@ -387,6 +438,17 @@ int may_setattr(struct mnt_idmap *idmap, struct inode *inode,
 		if (IS_IMMUTABLE(inode))
 			return -EPERM;
 
+		if (IS_TRIMACL_INODE(inode)) {
+			enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+
+			error = trimacl_resolve_policy(dentry, 0, &policy);
+			if (error)
+				return error;
+			if (policy == TRIMACL_POLICY_TRIM)
+				return trim_permission(idmap, dentry,
+						       MAY_WRITE_ATTR | MAY_WRITE_EXT_ATTR);
+		}
+
 		if (!inode_owner_or_capable(idmap, inode)) {
 			error = inode_permission(idmap, inode, MAY_WRITE);
 			if (error)
@@ -435,7 +497,7 @@ int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 
 	WARN_ON_ONCE(!inode_is_locked(inode));
 
-	error = may_setattr(idmap, inode, ia_valid);
+	error = may_setattr(idmap, dentry, ia_valid);
 	if (error)
 		return error;
 
