+
+/* fnOS Administrators group and system user */
+#define TRIM_ADMIN_GID		1000
+#define TRIM_SYSTEM_UID		712
+/* is_vol_d(): external disk */
+#define TRIM_VOL_TYPE_EXTERNAL	0x110
+/* is_user_dir_d() results */
+#define TRIM_USER_DIR_READONLY	0x01
+#define TRIM_USER_DIR_READ	0x11
+#define TRIM_USER_DIR_FULL	0x12
+
+#define TA_UID(ta)	(TA_NOT_CURRENT(ta) ? (ta)->uid : __kuid_val(current_fsuid()))
+
+static inline bool ta_vfsuid_eq(struct trim_access_t *ta, vfsuid_t vfsuid)
+{
+	return vfsuid_eq_kuid(vfsuid, KUIDT_INIT(TA_UID(ta)));
+}
+
+static inline bool ta_vfsgid_in_group(struct trim_access_t *ta, vfsgid_t vfsgid)
+{
+	if (TA_NOT_CURRENT(ta))
+		return trim_is_in_group(__vfsgid_val(vfsgid), ta->gid_count, ta->gids);
+	return vfsgid_in_group_p(vfsgid);
+}
+
+static inline bool ta_in_group(struct mnt_idmap *idmap, struct user_namespace *ns, struct trim_access_t *ta,
+			       gid_t gid)
+{
+	if (TA_NOT_CURRENT(ta))
+		return trim_is_in_group(gid, ta->gid_count, ta->gids);
+	return vfsgid_in_group_p(make_vfsgid(idmap, ns, make_kgid(ns, gid)));
+}
+
+static inline bool ta_is_root(struct mnt_idmap *idmap, struct inode *inode, struct trim_access_t *ta)
+{
+	return (!TA_NOT_CURRENT(ta) && capable_wrt_inode_uidgid(idmap, inode, CAP_DAC_OVERRIDE)) ||
+	       (TA_NOT_CURRENT(ta) && ta->uid == 0);
+}
+
+/*
+ * Does the entry apply at this level?  Level 0 is the object itself,
+ * higher levels are inherited from the ancestors.
+ */
+static inline bool trimacl_entry_applies(const struct trim_acl_entry *pa, int level, umode_t type)
+{
+	if ((pa->e_inherit & TRIM_ACL_INHERIT_NO_PROPAGATE) && level > 1)
+		return false;
+	if (level == 0)
+		return type != S_IFDIR || (pa->e_inherit & TRIM_ACL_INHERIT_SELF);
+	if (type == S_IFDIR)
+		return pa->e_inherit & TRIM_ACL_INHERIT_DIR;
+	return pa->e_inherit & TRIM_ACL_INHERIT_FILE;
+}
+
+/* POSIX rwx (3 bits) -> trim permission */
+static inline unsigned int trimacl_rwx_to_perm(umode_t mode)
+{
+	unsigned int perm = mode & S_IXOTH;
+
+	if (mode & S_IWOTH)
+		perm |= TRIM_PERM_WRITABLE;
+	if (mode & S_IROTH)
+		perm |= TRIM_PERM_READABLE;
+	return perm;
+}
+
+/* trim permission -> POSIX rwx (3 bits) */
+static inline unsigned int trimacl_perm_to_rwx(unsigned int perm)
+{
+	unsigned int mode = 0;
+
+	if ((perm & TRIM_PERM_READABLE) == TRIM_PERM_READABLE)
+		mode |= S_IROTH;
+	if ((perm & TRIM_PERM_WRITABLE) == TRIM_PERM_WRITABLE)
+		mode |= S_IWOTH;
+	if (perm & MAY_EXEC)
+		mode |= S_IXOTH;
+	return mode;
+}
+
+static inline void trimacl_set_entry(struct trim_acl_entry *pa, unsigned short tag, unsigned int id,
+				     unsigned int perm, unsigned short inherit)
+{
+	pa->e_tag = tag;
+	pa->e_id = id;
+	pa->e_perm = perm;
+	pa->e_inherit = inherit;
+	pa->e_allow = TRIM_ACL_ALLOW;
+}
+
+/*
+ * Build the ACL that represents a POSIX mode: owner, owning group and
+ * everyone entries plus a terminating EXCLUDE entry that stops
+ * inheritance from the ancestors.
+ */
+static struct trim_acl *trim_acl_from_mode(struct inode *inode, umode_t mode, unsigned int o_perm,
+					   unsigned int g_perm, unsigned int e_perm)
+{
+	unsigned short inherit = S_ISDIR(mode) ? TRIM_ACL_INHERIT_TYPE : 0;
+	struct trim_acl *acl;
+	gid_t gid = -1;
+	int count = 1, n = 0;
+
+	if (o_perm)
+		count++;
+	if (g_perm) {
+		count++;
+		gid = from_kgid(i_user_ns(inode), inode->i_gid);
+		if (gid == (gid_t)-1)
+			return ERR_PTR(-EOVERFLOW);
+	}
+	if (e_perm)
+		count++;
+
+	acl = trim_acl_alloc(count, GFP_KERNEL);
+	if (!acl)
+		return ERR_PTR(-ENOMEM);
+
+	if (o_perm)
+		trimacl_set_entry(&acl->a_entries[n++], TRIM_ACL_OWNER, TRIM_ACL_UNDEFINED_ID, o_perm, inherit);
+	if (g_perm)
+		trimacl_set_entry(&acl->a_entries[n++], TRIM_ACL_GROUP, gid, g_perm, inherit);
+	if (e_perm)
+		trimacl_set_entry(&acl->a_entries[n++], TRIM_ACL_EVERYONE, TRIM_ACL_UNDEFINED_ID, e_perm, inherit);
+	trimacl_set_entry(&acl->a_entries[n], TRIM_ACL_EVERYONE, TRIM_ACL_UNDEFINED_ID, 0,
+			  TRIM_ACL_INHERIT_EXCLUDE);
+	return acl;
+}
+
+int trim_acl_chmod(struct mnt_idmap *idmap, struct dentry *dentry, umode_t mode)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	struct inode *inode;
+	struct trim_acl *acl;
+	unsigned int o_perm, g_perm, e_perm;
+	int ret;
+
+	ret = trimacl_resolve_policy(dentry, 0, &policy);
+	if (ret)
+		return ret;
+	if (policy == TRIMACL_POLICY_POSIX)
+		return posix_acl_chmod(idmap, dentry, mode);
+
+	inode = d_inode(dentry);
+	if (!IS_TRIMACL_INODE(inode))
+		return 0;
+	if (!inode->i_op->set_trim_acl)
+		return -EOPNOTSUPP;
+
+	acl = get_inode_trim_acl(inode);
+	if (IS_ERR(acl)) {
+		if (PTR_ERR(acl) == -EOPNOTSUPP)
+			return 0;
+		return PTR_ERR(acl);
+	}
+
+	o_perm = trimacl_rwx_to_perm(mode >> 6);
+	g_perm = trimacl_rwx_to_perm(mode >> 3);
+	e_perm = trimacl_rwx_to_perm(mode);
+
+	if (acl) {
+		struct user_namespace *ns = i_user_ns(inode);
+		unsigned int found = 0, others = 0, protected = 0, n;
+
+		/* Nothing to do if the ACL already is exactly the mode */
+		for (n = 0; n < acl->a_count; n++) {
+			struct trim_acl_entry *pa = &acl->a_entries[n];
+
+			switch (pa->e_tag) {
+			case TRIM_ACL_OWNER:
+				if (pa->e_allow == TRIM_ACL_ALLOW && pa->e_perm == o_perm &&
+				    (!S_ISDIR(mode) || pa->e_inherit == TRIM_ACL_INHERIT_TYPE)) {
+					found |= TRIM_ACL_OWNER;
+					continue;
+				}
+				break;
+			case TRIM_ACL_GROUP:
+				if (pa->e_allow == TRIM_ACL_ALLOW && pa->e_perm == g_perm &&
+				    (!S_ISDIR(mode) || pa->e_inherit == TRIM_ACL_INHERIT_TYPE)) {
+					kgid_t gid = make_kgid(ns, pa->e_id);
+
+					if (gid_valid(gid) && gid_eq(gid, inode->i_gid)) {
+						found |= TRIM_ACL_GROUP;
+						continue;
+					}
+				}
+				break;
+			case TRIM_ACL_EVERYONE:
+				if (pa->e_allow == TRIM_ACL_ALLOW && pa->e_perm == e_perm &&
+				    (!S_ISDIR(mode) || pa->e_inherit == TRIM_ACL_INHERIT_TYPE)) {
+					found |= TRIM_ACL_EVERYONE;
+					continue;
+				}
+				break;
+			}
+			if (pa->e_inherit & TRIM_ACL_INHERIT_EXCLUDE)
+				protected = 1;
+			else
+				others++;
+		}
+		if (!(found & TRIM_ACL_OWNER) && !o_perm)
+			found |= TRIM_ACL_OWNER;
+		if (!(found & TRIM_ACL_GROUP) && !g_perm)
+			found |= TRIM_ACL_GROUP;
+		if (!(found & TRIM_ACL_EVERYONE) && !e_perm)
+			found |= TRIM_ACL_EVERYONE;
+		if (found == (TRIM_ACL_OWNER | TRIM_ACL_GROUP | TRIM_ACL_EVERYONE) && !others && protected) {
+			trim_acl_release(acl);
+			return 0;
+		}
+		trim_acl_release(acl);
+	}
+
+	acl = trim_acl_from_mode(inode, mode, o_perm, g_perm, e_perm);
+	if (IS_ERR(acl))
+		return PTR_ERR(acl);
+
+	ret = inode->i_op->set_trim_acl(idmap, inode, acl);
+	trim_acl_release(acl);
+	trimacl_debug("trim_acl_chmod: '%s', mode=%u, acl=%p, return %d\n", dentry->d_name.name, mode, acl, ret);
+	return ret;
+}
+EXPORT_SYMBOL(trim_acl_chmod);
+
+int aclv2_mode_to_posix_mode(int mask)
+{
+	int mode = 0;
+
+	if (mask & TRIM_PERM_READABLE)
+		mode |= MAY_READ;
+	if (mask & TRIM_PERM_FULL_WRITABLE)
+		mode |= MAY_WRITE;
+	if (mask & MAY_EXEC)
+		mode |= MAY_EXEC;
+	return mode | (mask & ~TRIM_PERM_FULL_CONTROL);
+}
+
+/*
+ * Evaluate one ACL for @want.  Returns 0 when everything is allowed,
+ * -EACCES when denied, 1 when the ancestors have to be checked.
+ */
+static int trimacl_acl_permission(struct mnt_idmap *idmap, struct inode *inode, struct trim_acl *acl,
+				  umode_t type, vfsuid_t owner, unsigned int want, int level,
+				  struct trim_access_t *ta, unsigned int *allowed_out)
+{
+	struct user_namespace *ns = i_user_ns(inode);
+	const struct trim_acl_entry *pa, *pe;
+	unsigned int allowed = 0, perm;
+	int excluded = 0;
+	bool match;
+
+	FOREACH_TRIMACL_ENTRY(pa, acl, pe) {
+		if (pa->e_inherit & TRIM_ACL_INHERIT_EXCLUDE) {
+			excluded = 1;
+			continue;
+		}
+		if (!trimacl_entry_applies(pa, level, type))
+			continue;
+
+		perm = pa->e_perm & TRIM_PERM_FULL_CONTROL;
+		switch (pa->e_tag) {
+		case TRIM_ACL_EVERYONE:
+			match = true;
+			break;
+		case TRIM_ACL_USER:
+			match = ta_vfsuid_eq(ta, make_vfsuid(idmap, ns, make_kuid(ns, pa->e_id)));
+			break;
+		case TRIM_ACL_GROUP:
+			match = ta_vfsgid_in_group(ta, make_vfsgid(idmap, ns, make_kgid(ns, pa->e_id)));
+			break;
+		case TRIM_ACL_OWNER:
+			match = ta_vfsuid_eq(ta, owner);
+			break;
+		default:
+			return -EIO;
+		}
+		if (!match)
+			continue;
+		if (pa->e_allow & TRIM_ACL_ALLOW)
+			allowed |= perm;
+		else if (perm & want)
+			return -EACCES;
+	}
+
+	allowed &= want;
+	*allowed_out = allowed;
+	if (allowed == want)
+		return 0;
+	return excluded ? -EACCES : 1;
+}
+
+/*
+ * Check @mask against the ACL of @dentry and, for what is not decided
+ * yet, against the inheritable entries of its ancestors.
+ */
+int trimacl_check_acl(struct mnt_idmap *idmap, struct dentry *dentry, int mask, struct trim_access_t *ta)
+{
+	struct inode *inode = d_inode(dentry);
+	struct trim_acl *acl;
+	unsigned int want, allowed;
+	umode_t type;
+	vfsuid_t owner;
+	int level = 0, ret;
+
+	if (!inode)
+		return -ENOENT;
+
+	type = inode->i_mode & S_IFMT;
+	owner = i_uid_into_vfsuid(idmap, inode);
+	want = mask & TRIM_PERM_FULL_CONTROL;
+	if (!want)
+		return 0;
+
+	dentry = dget(dentry);
+	for (;;) {
+		inode = d_inode(dentry);
+		if (!inode) {
+			ret = -ENOENT;
+			break;
+		}
+		acl = get_inode_trim_acl(inode);
+		if (IS_ERR(acl)) {
+			ret = PTR_ERR(acl);
+			break;
+		}
+		if (acl) {
+			allowed = 0;
+			ret = trimacl_acl_permission(idmap, inode, acl, type, owner, want, level, ta, &allowed);
+			trim_acl_release(acl);
+			trimacl_debug("    '%s' trimacl_acl_permission: mask=%X allowed=%X return %d\n",
+				      dentry->d_name.name, want, allowed, ret);
+			if (ret <= 0)
+				break;
+			want &= ~allowed;
+			if (!want) {
+				ret = 0;
+				break;
+			}
+		}
+		if (IS_ROOT(dentry)) {
+			ret = -EACCES;
+			break;
+		}
+		level++;
+		{
+			struct dentry *parent = dget_parent(dentry);
+
+			dput(dentry);
+			dentry = parent;
+		}
+	}
+	dput(dentry);
+	return ret;
+}
+
+int trim_generic_permission_ta(struct mnt_idmap *idmap, struct dentry *dentry, int mask, struct trim_access_t *ta)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	struct inode *inode;
+	int ret, vol_type, access;
+
+	ret = trimacl_resolve_policy(dentry, mask, &policy);
+	if (ret)
+		return ret;
+
+	if (policy == TRIMACL_POLICY_POSIX) {
+		mask = aclv2_mode_to_posix_mode(mask);
+		if (ta)
+			return posixacl_access_permission_check(idmap, d_inode(dentry), mask, ta);
+		return inode_permission(idmap, d_inode(dentry), mask);
+	}
+
+	if (ta_is_root(idmap, d_inode(dentry), ta))
+		goto full_access;
+
+	vol_type = is_vol_d(dentry);
+	if (!vol_type)
+		goto check;
+
+	inode = d_inode(dentry);
+	/* Traversing directories on a volume is always allowed */
+	if (S_ISDIR(inode->i_mode))
+		mask &= ~MAY_EXEC;
+	if (!(mask & TRIM_PERM_FULL_CONTROL))
+		return 0;
+
+	if (TA_UID(ta) == TRIM_SYSTEM_UID)
+		goto read_access;
+
+	/* External disks are for administrators unless enabled for everyone */
+	if (vol_type == TRIM_VOL_TYPE_EXTERNAL && !g_external_disk_access &&
+	    !ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		return -EACCES;
+
+	if (!(ta && (ta->flags & TRIM_ACCESS_FLAG_IGNORE_ADMINS)) &&
+	    ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		goto full_access;
+
+	switch (is_user_dir_d(dentry, TA_UID(ta), vol_type)) {
+	case TRIM_USER_DIR_FULL:
+		goto full_access;
+	case TRIM_USER_DIR_READ:
+		if (mask & TRIM_PERM_FULL_WRITABLE)
+			return -EACCES;
+		goto read_access;
+	case TRIM_USER_DIR_READONLY:
+		if (mask & TRIM_PERM_FULL_WRITABLE)
+			return -EACCES;
+		return trimacl_check_acl(idmap, dentry, mask, ta);
+	}
+
+	access = 0;
+	if (is_team_trashbin_dir_and_check_acl_d(dentry, mask, idmap, ta, &access))
+		return access;
+	return trimacl_check_acl(idmap, dentry, mask, ta);
+
+full_access:
+	if (S_ISDIR(d_inode(dentry)->i_mode))
+		return ret;
+	mask &= ~(TRIM_PERM_FULL_CONTROL & ~MAY_EXEC);
+	goto check;
+
+read_access:
+	mask &= ~(TRIM_PERM_READABLE | (S_ISDIR(d_inode(dentry)->i_mode) ? MAY_EXEC : 0));
+
+check:
+	if (!(mask & TRIM_PERM_FULL_CONTROL))
+		return ret;
+	return trimacl_check_acl(idmap, dentry, mask, ta);
+}
+
+int trim_permission(struct mnt_idmap *idmap, struct dentry *dentry, int mask)
+{
+	struct inode *inode = d_inode(dentry);
+	int retval;
+
+	trimacl_debug_path(dentry, "trim_permission: '%s', uid=%u, mask=%X\n",
+			   __kuid_val(current_fsuid()), mask);
+
+	if (mask & TRIM_PERM_FULL_WRITABLE) {
+		struct super_block *sb = inode->i_sb;
+		umode_t mode = inode->i_mode;
+
+		/* Nobody gets write access to a read-only fs. */
+		if ((sb_rdonly(sb) || (sb->s_flags & SB_TRIM_RO)) &&
+		    (S_ISREG(mode) || S_ISDIR(mode) || S_ISLNK(mode)))
+			return -EROFS;
+	}
+
+	if (mask & MAY_WRITE) {
+		/* Nobody gets write access to an immutable file. */
+		if (IS_IMMUTABLE(inode))
+			return -EPERM;
+		if (HAS_UNMAPPED_ID(idmap, inode))
+			return -EACCES;
+	}
+
+	if (mask & MAY_NOT_BLOCK)
+		return -ECHILD;
+
+	if (inode->i_op->trim_permission)
+		retval = inode->i_op->trim_permission(idmap, dentry, mask);
+	else
+		retval = trim_generic_permission(idmap, dentry, mask);
+	if (!retval)
+		retval = devcgroup_inode_permission(inode, mask);
+
+	trimacl_debug_path(dentry, "trim_permission: '%s', uid=%u, mask=%X, return %d\n",
+			   __kuid_val(current_fsuid()), mask, retval);
+	return retval;
+}
+EXPORT_SYMBOL(trim_permission);
+
+int trim_xattr_permission(struct mnt_idmap *idmap, const char *name, struct dentry *dentry, unsigned int perm)
+{
+	if (!name || strcmp(name, TRIM_ACL_XATTR_ACCESS))
+		return 0;
+	if (perm != MAY_READ_PERMISSION && perm != MAY_WRITE_PERMISSION)
+		return 0;
+	if (!IS_TRIMACL(dentry))
+		return -EOPNOTSUPP;
+	if (inode_owner_or_capable(idmap, d_inode(dentry)))
+		return 0;
+	return trim_permission(idmap, dentry, perm);
+}
+EXPORT_SYMBOL(trim_xattr_permission);
+
+/*
+ * Collect the ACL entries of @dentry and the inheritable entries of its
+ * ancestors.  e_level is the distance to @dentry, negative once a
+ * protected (EXCLUDE) ACL was passed with FORCE_INHERIT.
+ */
+int trimacl_get_trimacl_xattr_all(struct mnt_idmap *idmap, struct dentry *dentry, unsigned flags,
+				  void __user *buffer, size_t buffer_size)
+{
+	struct inode *inode = d_inode(dentry);
+	struct trim_acl *all, *acl;
+	unsigned int cap = 0;
+	bool excluded = false;
+	umode_t type;
+	int level = 0, ret, size;
+	void *kbuf;
+
+	if (!inode)
+		return -ENOENT;
+	if (!IS_TRIMACL_INODE(inode))
+		return -EPERM;
+
+	ret = trim_xattr_permission(idmap, TRIM_ACL_XATTR_ACCESS, dentry, MAY_READ_PERMISSION);
+	if (ret)
+		return ret;
+
+	type = inode->i_mode & S_IFMT;
+	all = trim_acl_alloc(0, GFP_KERNEL);
+	if (!all)
+		return -ENOMEM;
+
+	dentry = dget(dentry);
+	for (;;) {
+		inode = d_inode(dentry);
+		if (!inode) {
+			ret = -ENOENT;
+			goto out;
+		}
+		acl = get_inode_trim_acl(inode);
+		if (IS_ERR(acl)) {
+			ret = PTR_ERR(acl);
+			goto out;
+		}
+		if (acl) {
+			const struct trim_acl_entry *pa, *pe;
+			unsigned int e_level = excluded ? -level : level;
+			bool new_excluded = false;
+
+			ret = 0;
+			FOREACH_TRIMACL_ENTRY(pa, acl, pe) {
+				struct trim_acl_entry *e;
+				unsigned int count;
+
+				if (pa->e_inherit & TRIM_ACL_INHERIT_EXCLUDE) {
+					if (level) {
+						ret = 1;
+						continue;
+					}
+					if (flags & TRIM_GET_TRIMACL_XATTR_FLAG_FORCE_INHERIT)
+						new_excluded = true;
+					else
+						ret = 1;
+				} else if (level && !trimacl_entry_applies(pa, level, type)) {
+					continue;
+				}
+
+				if (all->a_count == UINT_MAX) {
+					ret = -EOVERFLOW;
+					break;
+				}
+				count = all->a_count + 1;
+				if (count > cap) {
+					unsigned int new_cap = cap ? cap : 16;
+					struct trim_acl *new_all;
+
+					while (new_cap < count) {
+						if ((int)new_cap < 0) {
+							new_cap = UINT_MAX;
+							break;
+						}
+						new_cap <<= 1;
+					}
+					new_all = kvrealloc(all, sizeof(struct trim_acl) +
+							    new_cap * sizeof(struct trim_acl_entry), GFP_KERNEL);
+					if (!new_all) {
+						ret = -ENOMEM;
+						break;
+					}
+					all = new_all;
+					cap = new_cap;
+				}
+				e = &all->a_entries[all->a_count];
+				e->e_level = e_level;
+				e->e_allow = pa->e_allow;
+				e->e_id = pa->e_id;
+				e->e_inherit = pa->e_inherit;
+				e->e_perm = pa->e_perm;
+				e->e_tag = pa->e_tag;
+				all->a_count = count;
+			}
+			if (new_excluded)
+				excluded = new_excluded;
+			trim_acl_release(acl);
+			trimacl_debug(" '%s' __trimacl_get_acl_xattr: return %d\n", dentry->d_name.name, ret);
+			if (ret == 1)
+				break;
+			if (ret)
+				goto out;
+		}
+		if (IS_ROOT(dentry))
+			break;
+		level++;
+		{
+			struct dentry *parent = dget_parent(dentry);
+
+			dput(dentry);
+			dentry = parent;
+		}
+	}
+
+	if (!all->a_count) {
+		ret = 0;
+		goto out;
+	}
+	size = trim_acl_xattr_size(all->a_count);
+	ret = size;
+	if (size <= 0 || !buffer)
+		goto out;
+	if (buffer_size < size) {
+		ret = -ERANGE;
+		goto out;
+	}
+	kbuf = kmalloc(size, GFP_KERNEL);
+	if (!kbuf) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = trim_acl_to_xattr(all, kbuf, size);
+	if (ret > 0 && copy_to_user(buffer, kbuf, ret))
+		ret = -EFAULT;
+	kfree(kbuf);
+out:
+	dput(dentry);
+	trim_acl_release(all);
+	return ret;
+}
+EXPORT_SYMBOL(trimacl_get_trimacl_xattr_all);
+
+int trim_may_delete(struct mnt_idmap *idmap, struct dentry *victim, struct inode *dir)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	enum trimacl_policy victim_policy = TRIMACL_POLICY_TRIM;
+	int error;
+
+	error = trimacl_resolve_policy(victim->d_parent, 0, &policy);
+	if (error)
+		return error;
+	if (policy == TRIMACL_POLICY_POSIX)
+		return inode_permission(idmap, dir, MAY_WRITE | MAY_EXEC);
+
+	error = trimacl_resolve_policy(victim, 0, &victim_policy);
+	if (error)
+		return error;
+	if (victim_policy == TRIMACL_POLICY_POSIX)
+		goto parent;
+
+	if (dir->i_op->trim_may_delete)
+		return dir->i_op->trim_may_delete(idmap, victim, dir);
+
+	/* MAY_DEL on the victim or MAY_DEL_CHILD on the parent */
+	error = trim_permission(idmap, victim, MAY_DEL);
+	if (!error)
+		return 0;
+parent:
+	return trim_permission(idmap, victim->d_parent, MAY_DEL_CHILD);
+}
+EXPORT_SYMBOL(trim_may_delete);
+
+int trim_generic_permission(struct mnt_idmap *idmap, struct dentry *dentry, int mask)
+{
+	return trim_generic_permission_ta(idmap, dentry, mask, NULL);
+}
+
+/*
+ * One ACL: what it allows and denies for @mask (bits not decided yet).
+ * Returns 1 to continue with the ancestors, 0 when the ACL is protected.
+ */
+static int __trimacl_calc_permission(struct mnt_idmap *idmap, struct inode *inode, struct trim_acl *acl,
+				     umode_t type, vfsuid_t owner, unsigned int mask, int level,
+				     struct trim_access_t *ta, unsigned int *allow_out, unsigned int *deny_out)
+{
+	struct user_namespace *ns = i_user_ns(inode);
+	const struct trim_acl_entry *pa, *pe;
+	unsigned int allow = 0, deny = 0, perm;
+	int excluded = 0, ret;
+	bool match;
+
+	FOREACH_TRIMACL_ENTRY(pa, acl, pe) {
+		if (pa->e_inherit & TRIM_ACL_INHERIT_EXCLUDE) {
+			excluded = 1;
+			continue;
+		}
+		if (!trimacl_entry_applies(pa, level, type))
+			continue;
+
+		perm = pa->e_perm & TRIM_PERM_FULL_CONTROL;
+		switch (pa->e_tag) {
+		case TRIM_ACL_EVERYONE:
+			match = true;
+			break;
+		case TRIM_ACL_USER:
+			match = ta_vfsuid_eq(ta, make_vfsuid(idmap, ns, make_kuid(ns, pa->e_id)));
+			break;
+		case TRIM_ACL_GROUP:
+			match = ta_vfsgid_in_group(ta, make_vfsgid(idmap, ns, make_kgid(ns, pa->e_id)));
+			break;
+		case TRIM_ACL_OWNER:
+			match = ta_vfsuid_eq(ta, owner);
+			break;
+		default:
+			ret = -EIO;
+			goto out;
+		}
+		if (!match)
+			continue;
+		if (pa->e_allow & TRIM_ACL_ALLOW)
+			allow |= perm;
+		else
+			deny |= perm;
+	}
+	ret = excluded ? 0 : 1;
+out:
+	allow &= mask;
+	deny &= mask;
+	*deny_out = deny;
+	*allow_out = allow & ~deny;
+	return ret;
+}
+
+unsigned int trimacl_calc_permission(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta)
+{
+	struct inode *inode = d_inode(dentry);
+	unsigned int allowed = 0, denied = 0, allow, deny;
+	struct trim_acl *acl;
+	umode_t type;
+	vfsuid_t owner;
+	int level = 0, ret;
+
+	if (!inode)
+		return 0;
+
+	type = inode->i_mode & S_IFMT;
+	owner = i_uid_into_vfsuid(idmap, inode);
+
+	dentry = dget(dentry);
+	for (;;) {
+		inode = d_inode(dentry);
+		if (!inode)
+			goto fail;
+		acl = get_inode_trim_acl(inode);
+		if (IS_ERR(acl))
+			goto fail;
+		if (acl) {
+			ret = __trimacl_calc_permission(idmap, inode, acl, type, owner, ~(allowed | denied),
+							level, ta, &allow, &deny);
+			denied |= deny;
+			allowed |= allow;
+			trim_acl_release(acl);
+			trimacl_debug("    '%s' __trimacl_calc_permission: uid=%u (allow: %X, deny: %X) return %d\n",
+				      dentry->d_name.name, TA_UID(ta), allow, deny, ret);
+			if (!ret || (allowed | denied) == TRIM_PERM_FULL_CONTROL)
+				break;
+			if (ret < 0)
+				goto fail;
+		}
+		if (IS_ROOT(dentry))
+			break;
+		level++;
+		{
+			struct dentry *parent = dget_parent(dentry);
+
+			dput(dentry);
+			dentry = parent;
+		}
+	}
+	dput(dentry);
+	return allowed;
+
+fail:
+	dput(dentry);
+	return 0;
+}
+
+int trimacl_get_permission(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	unsigned int granted = 0, limit = ~0U, perm;
+	struct inode *inode;
+	int ret, vol_type;
+
+	ret = trimacl_resolve_policy(dentry, 0, &policy);
+	if (ret)
+		return ret;
+	if (policy == TRIMACL_POLICY_POSIX)
+		return posixacl_get_permission(idmap, d_inode(dentry), ta);
+
+	if (ta_is_root(idmap, d_inode(dentry), ta))
+		goto full_access;
+
+	vol_type = is_vol_d(dentry);
+	if (!vol_type)
+		goto calc;
+
+	inode = d_inode(dentry);
+	/* Traversing directories on a volume is always allowed */
+	granted = S_ISDIR(inode->i_mode) ? MAY_EXEC : 0;
+
+	if (TA_UID(ta) == TRIM_SYSTEM_UID) {
+		granted |= TRIM_PERM_READABLE;
+		goto calc;
+	}
+
+	if (vol_type == TRIM_VOL_TYPE_EXTERNAL && !g_external_disk_access &&
+	    !ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		return ret;
+
+	if (!(ta && (ta->flags & TRIM_ACCESS_FLAG_IGNORE_ADMINS)) &&
+	    ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		goto full_access;
+
+	switch (is_user_dir_d(dentry, TA_UID(ta), vol_type)) {
+	case TRIM_USER_DIR_FULL:
+		goto full_access;
+	case TRIM_USER_DIR_READ:
+		granted |= TRIM_PERM_READABLE;
+		limit = ~TRIM_PERM_FULL_WRITABLE;
+		goto calc;
+	case TRIM_USER_DIR_READONLY:
+		limit = ~TRIM_PERM_FULL_WRITABLE;
+		goto calc;
+	}
+
+	perm = 0;
+	if (is_team_trashbin_dir_and_get_permission_d(dentry, idmap, ta, &perm))
+		return perm;
+	goto calc;
+
+full_access:
+	if (S_ISDIR(d_inode(dentry)->i_mode))
+		return TRIM_PERM_FULL_CONTROL;
+	granted = TRIM_PERM_FULL_CONTROL & ~MAY_EXEC;
+	limit = ~0U;
+
+calc:
+	perm = (trimacl_calc_permission(idmap, dentry, ta) | granted) & limit;
+	trimacl_debug("'%s' trimacl_get_permission: uid=%u return %X\n", dentry->d_name.name, TA_UID(ta), perm);
+	return perm;
+}
+
+struct trimacl_mode_perm {
+	unsigned int o_allow, o_deny;
+	unsigned int g_allow, g_deny;
+	unsigned int e_allow, e_deny;
+};
+
+static int __trimacl_to_mode(struct inode *owner_inode, struct trim_acl *acl, umode_t type, int level,
+			     const struct trimacl_mode_perm *mp, struct trimacl_mode_perm *cur)
+{
+	struct user_namespace *ns = i_user_ns(owner_inode);
+	unsigned int o_mask = ~(mp->o_allow | mp->o_deny);
+	unsigned int g_mask = ~(mp->g_allow | mp->g_deny);
+	unsigned int e_mask = ~(mp->e_allow | mp->e_deny);
+	unsigned int o_allow = 0, o_deny = 0, g_allow = 0, g_deny = 0, e_allow = 0, e_deny = 0, perm;
+	const struct trim_acl_entry *pa, *pe;
+	int excluded = 0, ret;
+	kgid_t gid;
+
+	FOREACH_TRIMACL_ENTRY(pa, acl, pe) {
+		if (pa->e_inherit & TRIM_ACL_INHERIT_EXCLUDE) {
+			excluded = 1;
+			continue;
+		}
+		if (!trimacl_entry_applies(pa, level, type))
+			continue;
+
+		perm = pa->e_perm & TRIM_PERM_FULL_CONTROL;
+		switch (pa->e_tag) {
+		case TRIM_ACL_EVERYONE:
+			if (pa->e_allow & TRIM_ACL_ALLOW)
+				e_allow |= perm;
+			else
+				e_deny |= perm;
+			break;
+		case TRIM_ACL_OWNER:
+			if (pa->e_allow & TRIM_ACL_ALLOW)
+				o_allow |= perm;
+			else
+				o_deny |= perm;
+			break;
+		case TRIM_ACL_GROUP:
+			gid = make_kgid(ns, pa->e_id);
+			if (!gid_valid(gid) || !gid_eq(gid, owner_inode->i_gid))
+				break;
+			if (pa->e_allow & TRIM_ACL_ALLOW)
+				g_allow |= perm;
+			else
+				g_deny |= perm;
+			break;
+		case TRIM_ACL_USER:
+			break;
+		default:
+			ret = -EIO;
+			goto out;
+		}
+	}
+	ret = excluded ? 0 : 1;
+out:
+	cur->o_deny = o_deny & o_mask;
+	cur->o_allow = o_allow & o_mask & ~o_deny;
+	cur->g_deny = g_deny & g_mask;
+	cur->g_allow = g_allow & g_mask & ~g_deny;
+	cur->e_deny = e_deny & e_mask;
+	cur->e_allow = e_allow & e_mask & ~e_deny;
+	return ret;
+}
+
+unsigned int trimacl_to_mode(struct mnt_idmap *idmap, struct dentry *dentry)
+{
+	struct inode *owner_inode = d_inode(dentry), *inode;
+	struct trimacl_mode_perm mp = {}, cur;
+	struct trim_acl *acl;
+	unsigned int mode;
+	umode_t type;
+	int level = 0, ret;
+
+	if (!owner_inode)
+		return 0;
+	type = owner_inode->i_mode & S_IFMT;
+
+	dentry = dget(dentry);
+	for (;;) {
+		inode = d_inode(dentry);
+		if (!inode) {
+			ret = -ENOENT;
+			goto fail;
+		}
+		acl = get_inode_trim_acl(inode);
+		if (IS_ERR(acl)) {
+			ret = PTR_ERR(acl);
+			goto fail;
+		}
+		if (acl) {
+			ret = __trimacl_to_mode(owner_inode, acl, type, level, &mp, &cur);
+			mp.o_allow |= cur.o_allow;
+			mp.o_deny |= cur.o_deny;
+			mp.g_allow |= cur.g_allow;
+			mp.g_deny |= cur.g_deny;
+			mp.e_allow |= cur.e_allow;
+			mp.e_deny |= cur.e_deny;
+			trim_acl_release(acl);
+			trimacl_debug(" '%s' __trimacl_to_mode: (o_allow: %X, o_deny: %X, e_allow: %X, e_deny: %X) return %d\n",
+				      dentry->d_name.name, cur.o_allow, cur.o_deny, cur.e_allow, cur.e_deny, ret);
+			if (!ret)
+				break;
+			if ((mp.o_allow | mp.o_deny) == TRIM_PERM_FULL_CONTROL &&
+			    (mp.g_allow | mp.g_deny) == TRIM_PERM_FULL_CONTROL &&
+			    (mp.e_allow | mp.e_deny) == TRIM_PERM_FULL_CONTROL)
+				break;
+			if (ret < 0)
+				goto fail;
+		}
+		if (IS_ROOT(dentry))
+			break;
+		level++;
+		{
+			struct dentry *parent = dget_parent(dentry);
+
+			dput(dentry);
+			dentry = parent;
+		}
+	}
+
+	mode = trimacl_perm_to_rwx(mp.o_allow) << 6 | trimacl_perm_to_rwx(mp.g_allow) << 3 |
+	       trimacl_perm_to_rwx(mp.e_allow);
+	trimacl_debug("'%s' trimacl_to_mode: %o\n", dentry->d_name.name, mode);
+	dput(dentry);
+	return mode;
+
+fail:
+	trimacl_debug("'%s' trimacl_to_mode: %o [error: %d]\n", dentry->d_name.name, 0, ret);
+	dput(dentry);
+	return 0;
+}
+
+int trim_to_mode(struct mnt_idmap *idmap, struct dentry *dentry, struct kstat *stat)
+{
+	struct inode *inode = d_inode(dentry);
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	int error;
+
+	if (inode->i_op->trim_acl_to_mode)
+		return inode->i_op->trim_acl_to_mode(idmap, dentry, stat);
+
+	error = trimacl_resolve_policy(dentry, 0, &policy);
+	if (error || policy == TRIMACL_POLICY_POSIX)
+		return error;
+
+	stat->mode = (stat->mode & ~S_IRWXUGO) | (trimacl_to_mode(idmap, dentry) & S_IRWXUGO);
+	return 0;
+}
+EXPORT_SYMBOL(trim_to_mode);
+
+/* -------------------------------------------------------------------------- */
+/* system.trim_flags: per-inode flags, cached in the inode */
+
+void trim_inode_flags_forget(struct inode *inode)
+{
+	spin_lock(&inode->i_lock);
+	inode->i_trim_flags_generation++;
+	inode->i_trim_flags_state = TRIM_INODE_FLAGS_UNKNOWN;
+	spin_unlock(&inode->i_lock);
+}
+EXPORT_SYMBOL(trim_inode_flags_forget);
+
+void trim_inode_flags_init_new(struct inode *inode)
+{
+	if (!IS_TRIMACL_INODE(inode))
+		return;
+
+	spin_lock(&inode->i_lock);
+	if (inode->i_trim_flags_state == TRIM_INODE_FLAGS_UNKNOWN) {
+		inode->i_trim_flags_generation++;
+		atomic64_set(&inode->i_trim_flags, 0);
+		inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+	}
+	spin_unlock(&inode->i_lock);
+}
+EXPORT_SYMBOL(trim_inode_flags_init_new);
+
+static int trim_inode_flags_read_disk(struct inode *inode, u64 *flags, bool *found, bool *unsupported)
+{
+	struct trim_inode_flags_xattr_v1 *buf;
+	int retries = 3;
+	ssize_t size;
+	int ret;
+
+	if (!inode->i_op->get_trim_flags)
+		return -EOPNOTSUPP;
+retry:
+	size = inode->i_op->get_trim_flags(inode, NULL, 0);
+	if (size == -ENODATA || size == -ENOENT)
+		return 0;
+	if (size < 0)
+		return size;
+	if (size == 0 || size > XATTR_SIZE_MAX)
+		return -EUCLEAN;
+
+	buf = kmalloc(size, GFP_NOFS);
+	if (!buf)
+		return -ENOMEM;
+
+	size = inode->i_op->get_trim_flags(inode, buf, size);
+	if (size == -ERANGE) {
+		kfree(buf);
+		if (--retries)
+			goto retry;
+		return -EAGAIN;
+	}
+	if (size == -ENODATA || size == -ENOENT) {
+		ret = 0;
+		goto out;
+	}
+	if (size < 0) {
+		ret = size;
+		goto out;
+	}
+
+	*found = true;
+	if (size < sizeof(*buf)) {
+		ret = -EUCLEAN;
+		goto out;
+	}
+	if (le16_to_cpu(buf->version) != TRIM_INODE_FLAGS_XATTR_VERSION) {
+		if (unsupported)
+			*unsupported = true;
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (le16_to_cpu(buf->size) != sizeof(*buf) || size != sizeof(*buf) || buf->reserved) {
+		ret = -EUCLEAN;
+		goto out;
+	}
+	*flags = le64_to_cpu(buf->flags);
+	ret = 0;
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int trim_inode_flags_xattr_get(const struct xattr_handler *handler, struct dentry *unused,
+				      struct inode *inode, const char *name, void *buffer, size_t size)
+{
+	struct trim_inode_flags_xattr_v1 *xattr = buffer;
+	bool found = false;
+	u64 flags = 0;
+	int ret;
+
+	ret = trim_inode_flags_read_disk(inode, &flags, &found, NULL);
+	if (ret)
+		return ret;
+	if (!found)
+		return -ENODATA;
+	if (!buffer)
+		return sizeof(*xattr);
+	if (size < sizeof(*xattr))
+		return -ERANGE;
+
+	xattr->version = cpu_to_le16(TRIM_INODE_FLAGS_XATTR_VERSION);
+	xattr->size = cpu_to_le16(sizeof(*xattr));
+	xattr->reserved = 0;
+	xattr->flags = cpu_to_le64(flags);
+	return sizeof(*xattr);
+}
+
+int trim_inode_flags_load(struct inode *inode, u64 *flags)
+{
+	bool found = false, unsupported = false;
+	u64 disk_flags = 0;
+	unsigned int gen;
+	int ret;
+
+	for (;;) {
+		switch (READ_ONCE(inode->i_trim_flags_state)) {
+		case TRIM_INODE_FLAGS_VALID:
+			*flags = atomic64_read(&inode->i_trim_flags);
+			return 0;
+		case TRIM_INODE_FLAGS_CORRUPT:
+			return -EUCLEAN;
+		case TRIM_INODE_FLAGS_UNSUPPORTED:
+			return -EOPNOTSUPP;
+		}
+
+		found = false;
+		disk_flags = 0;
+		unsupported = false;
+		gen = READ_ONCE(inode->i_trim_flags_generation);
+		ret = trim_inode_flags_read_disk(inode, &disk_flags, &found, &unsupported);
+
+		spin_lock(&inode->i_lock);
+		if (inode->i_trim_flags_generation != gen ||
+		    inode->i_trim_flags_state != TRIM_INODE_FLAGS_UNKNOWN) {
+			/* Raced with an update, look again */
+			spin_unlock(&inode->i_lock);
+			continue;
+		}
+		if (!ret) {
+			atomic64_set(&inode->i_trim_flags, disk_flags);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+			*flags = disk_flags;
+		} else if (ret == -EUCLEAN) {
+			atomic64_set(&inode->i_trim_flags, 0);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_CORRUPT;
+		} else if (ret == -EOPNOTSUPP && unsupported) {
+			atomic64_set(&inode->i_trim_flags, 0);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_UNSUPPORTED;
+		}
+		spin_unlock(&inode->i_lock);
+		return ret;
+	}
+}
+EXPORT_SYMBOL(trim_inode_flags_load);
+
+/* Top-level directories of a volume that always use POSIX ACLs */
+static bool trimacl_is_posix_top_dir(const char *name)
+{
+	return !strcmp(name, "docker") || !strcmp(name, "@appcenter") || !strcmp(name, "@appconf") ||
+	       !strcmp(name, "@appdata") || !strcmp(name, "@apphome") || !strcmp(name, "@appmeta") ||
+	       !strcmp(name, "@apptemp") || name[0] == '_';
+}
+
+/*
+ * Find the directory right below the root of the filesystem that
+ * contains @dentry (and the one below that).  Called under RCU.
+ */
+static void trimacl_top_dirs(struct dentry *dentry, struct dentry **top, struct dentry **second)
+{
+	struct dentry *root = dentry->d_sb->s_root;
+	struct dentry *d = dentry, *child = NULL, *grandchild = NULL;
+
+	if (!root)
+		return;
+	if (dentry && dentry != root) {
+		while (!IS_ROOT(d)) {
+			struct dentry *parent = d->d_parent;
+
+			grandchild = child;
+			child = d;
+			d = parent;
+			if (!parent || parent == root)
+				break;
+		}
+	}
+	if (d != root)
+		return;
+	*top = child;
+	*second = grandchild;
+}
+
+/*
+ * TRIM ACL or POSIX ACL for @dentry?  The filesystem can decide with
+ * ->is_trimacl, otherwise app/docker directories are POSIX and the
+ * TRIM_INODE_F_POSIX_ACL flag of the nearest ancestor decides.
+ */
+int trimacl_resolve_policy(struct dentry *dentry, unsigned int flags, enum trimacl_policy *policy)
+{
+	struct inode *inode = d_inode(dentry);
+	struct dentry *d, *top, *second;
+	unsigned int seq;
+	u64 tflags;
+	int ret;
+
+	if (!inode)
+		return -ENOENT;
+	if (!IS_TRIMACL_INODE(inode))
+		goto posix;
+
+	if (inode->i_op->is_trimacl) {
+		if (flags & MAY_NOT_BLOCK)
+			return -ECHILD;
+		ret = inode->i_op->is_trimacl(dentry);
+		if (ret < 0)
+			return ret;
+		*policy = ret ? TRIMACL_POLICY_TRIM : TRIMACL_POLICY_POSIX;
+		return 0;
+	}
+
+	for (;;) {
+		bool posix_dir = false;
+
+		top = second = NULL;
+		rcu_read_lock();
+		seq = read_seqbegin(&rename_lock);
+		trimacl_top_dirs(dentry, &top, &second);
+		if (top && d_is_dir(top))
+			posix_dir = trimacl_is_posix_top_dir(top->d_name.name);
+		if (!read_seqretry(&rename_lock, seq)) {
+			rcu_read_unlock();
+			if (posix_dir)
+				goto posix;
+			break;
+		}
+		rcu_read_unlock();
+	}
+
+retry:
+	tflags = 0;
+	*policy = TRIMACL_POLICY_TRIM;
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	ret = 0;
+	for (d = dentry;; d = d->d_parent) {
+		inode = d_inode(d);
+		if (!inode) {
+			ret = -ESTALE;
+			break;
+		}
+		if (inode->i_op->get_trim_flags) {
+			switch (READ_ONCE(inode->i_trim_flags_state)) {
+			case TRIM_INODE_FLAGS_UNKNOWN:
+				/* Load the flags outside RCU and look again */
+				if (flags & MAY_NOT_BLOCK)
+					goto echild;
+				if (!lockref_get_not_dead(&d->d_lockref)) {
+					if (read_seqretry(&rename_lock, seq))
+						goto resched;
+					rcu_read_unlock();
+					return -ESTALE;
+				}
+				if (read_seqretry(&rename_lock, seq)) {
+					rcu_read_unlock();
+					dput(d);
+					cond_resched();
+					goto retry;
+				}
+				rcu_read_unlock();
+				if (!d_inode(d)) {
+					dput(d);
+					return -ESTALE;
+				}
+				ret = trim_inode_flags_load(d_inode(d), &tflags);
+				dput(d);
+				if (ret)
+					return ret;
+				goto retry;
+			case TRIM_INODE_FLAGS_CORRUPT:
+				ret = -EUCLEAN;
+				goto done;
+			case TRIM_INODE_FLAGS_UNSUPPORTED:
+				ret = -EOPNOTSUPP;
+				goto done;
+			}
+			tflags = atomic64_read(&inode->i_trim_flags);
+			if (tflags & TRIM_INODE_F_POSIX_ACL) {
+				*policy = TRIMACL_POLICY_POSIX;
+				break;
+			}
+		}
+		if (IS_ROOT(d))
+			break;
+	}
+done:
+	if (read_seqretry(&rename_lock, seq)) {
+		if (flags & MAY_NOT_BLOCK)
+			goto echild;
+resched:
+		rcu_read_unlock();
+		cond_resched();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+
+echild:
+	rcu_read_unlock();
+	return -ECHILD;
+
+posix:
+	*policy = TRIMACL_POLICY_POSIX;
+	return 0;
+}
+EXPORT_SYMBOL(trimacl_resolve_policy);
+
+static int trim_inode_flags_xattr_set(const struct xattr_handler *handler, struct mnt_idmap *idmap,
+				      struct dentry *dentry, struct inode *inode, const char *name,
+				      const void *value, size_t size, int flags)
+{
+	struct trim_inode_flags_xattr_v1 xattr = {};
+	const struct trim_inode_flags_xattr_v1 *in = value;
+	u64 new_flags = 0;
+	int ret;
+
+	if (!inode->i_op->set_trim_flags)
+		return -EOPNOTSUPP;
+	if (!capable(CAP_SYS_ADMIN) && vol_is_admin_or_homeowner(idmap, dentry) <= 0)
+		return -EPERM;
+
+	if (value) {
+		if (size < sizeof(*in))
+			return -EUCLEAN;
+		if (le16_to_cpu(in->version) != TRIM_INODE_FLAGS_XATTR_VERSION)
+			return -EOPNOTSUPP;
+		if (le16_to_cpu(in->size) != sizeof(*in) || size != sizeof(*in) || in->reserved)
+			return -EUCLEAN;
+		new_flags = le64_to_cpu(in->flags);
+		xattr.version = cpu_to_le16(TRIM_INODE_FLAGS_XATTR_VERSION);
+		xattr.size = cpu_to_le16(sizeof(xattr));
+		xattr.flags = cpu_to_le64(new_flags);
+		value = &xattr;
+		size = sizeof(xattr);
+	} else {
+		size = 0;
+	}
+
+	ret = inode->i_op->set_trim_flags(inode, value, size, flags);
+	if (ret)
+		return ret;
+
+	spin_lock(&inode->i_lock);
+	inode->i_trim_flags_generation++;
+	atomic64_set(&inode->i_trim_flags, new_flags);
+	inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+	spin_unlock(&inode->i_lock);
+	return ret;
+}
+
+const struct xattr_handler trim_inode_flags_xattr_handler = {
+	.name = TRIM_INODE_FLAGS_XATTR,
+	.get = trim_inode_flags_xattr_get,
+	.set = trim_inode_flags_xattr_set,
+};
+EXPORT_SYMBOL(trim_inode_flags_xattr_handler);
+
+static int __init trimacl_debug_init_function(void)
+{
+	debugfs_create_u32("trimacl_debug_print_level", 0644, NULL, &trimacl_debug_level);
+	return 0;
+}
+fs_initcall(trimacl_debug_init_function);
