diff --git a/include/linux/trim_acl.h b/include/linux/trim_acl.h
new file mode 100644
index 000000000..7f728fbdf
--- /dev/null
+++ b/include/linux/trim_acl.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) T.R.I.M Inc.
+ */
+#ifndef _LINUX_TRIM_ACL_H
+#define _LINUX_TRIM_ACL_H
+
+#include <linux/fs.h>
+#include <linux/slab.h>
+#include <linux/rcupdate.h>
+#include <linux/refcount.h>
+#include <linux/spinlock.h>
+#include <uapi/linux/trim_acl.h>
+#include <linux/trimvfs.h>
+#include <linux/trim_flags.h>
+
+#define TRIM_ACL_CHECK_PARENT 1
+
+/* */
+#define SB_TRIMACL (1 << 20) /* Trim-ACL */
+
+#define IS_SB_TRIMACL(inode) __IS_FLG(inode, SB_TRIMACL)
+#define IS_TRIMACL_INODE(inode) (IS_SB_TRIMACL(inode))
+#define IS_TRIMACL(dentry) (IS_SB_TRIMACL(dentry->d_inode))
+/* 这里加入is_vol和is_vol_d的判断，是为了外接存储，能进到trimacl的特殊权限判定代码里（这里是管理员对外接存储可读写的特权，否则管理员无法写入U盘） */
+//#define IS_TRIMACL_INODE(inode) (IS_SB_TRIMACL(inode) || is_vol(inode))
+//#define IS_TRIMACL(dentry) (IS_SB_TRIMACL(dentry->d_inode) || is_vol_d(dentry))
+
+#define IS_TRIMACL_OWNER_IS_GROUP(dentry) 0
+#define IS_TRIMACL_OWNER(dentry)                                                  \
+	(IS_TRIMACL_OWNER_IS_GROUP(dentry) ? in_group_p(dentry->d_inode->i_gid) : \
+					     (uid_eq(dentry->d_inode->i_uid, current_fsuid())))
+#define IS_TRIMACL_OWNER_OR_CAPABLE(dentry) (IS_TRIMACL_OWNER(dentry) || capable(CAP_FOWNER))
+
+/* e_tag entry in struct trim_acl_entry */
+#define TRIM_ACL_USER 0x01
+#define TRIM_ACL_GROUP 0x02
+#define TRIM_ACL_EVERYONE 0x04
+#define TRIM_ACL_OWNER 0x08
+#define TRIM_ACL_AUTHENTICATEDUSER 0x09
+#define TRIM_ACL_SYSTEM 0x0A
+#define TRIM_ACL_TAG_ALL (TRIM_ACL_USER | TRIM_ACL_GROUP | TRIM_ACL_OWNER | TRIM_ACL_EVERYONE)
+
+/* e_allow */
+#define TRIM_ACL_ALLOW 0x01
+#define TRIM_ACL_DENY 0x02
+
+struct trim_acl_entry {
+	unsigned short e_tag;
+	unsigned int e_id;
+	unsigned int e_perm;
+	unsigned short e_inherit;
+	unsigned short e_allow;
+	unsigned int e_level;
+};
+
+struct trim_acl {
+	refcount_t a_refcount;
+	struct rcu_head a_rcu;
+	unsigned int a_count;
+	struct trim_acl_entry a_entries[0];
+};
+
+#define FOREACH_TRIMACL_ENTRY(pa, acl, pe) for (pa = (acl)->a_entries, pe = pa + (acl)->a_count; pa < pe; pa++)
+
+/*
+ * Duplicate an ACL handle.
+ */
+static inline struct trim_acl *trim_acl_dup(struct trim_acl *acl)
+{
+	if (acl)
+		refcount_inc(&acl->a_refcount);
+	return acl;
+}
+
+#define non_gpl_kvfree_rcu(ptr, rhf)                                         \
+	do {                                                                 \
+		typeof(ptr) ___p = (ptr);                                    \
+                                                                             \
+		if (___p) {                                                  \
+			BUILD_BUG_ON(offsetof(typeof(*(ptr)), rhf) >= 4096); \
+			__kvfree_call_rcu(&((___p)->rhf), (void *)(___p));   \
+		}                                                            \
+	} while (0)
+
+/*
+ * Free an ACL handle.
+ */
+static inline void trim_acl_release(struct trim_acl *acl)
+{
+	if (acl && refcount_dec_and_test(&acl->a_refcount))
+		non_gpl_kvfree_rcu(acl, a_rcu);
+}
+
+extern struct trim_acl *trim_acl_alloc(int count, gfp_t flags);
+extern int trim_acl_valid(const struct trim_acl *);
+extern struct trim_acl *trim_acl_realloc(struct trim_acl *acl, unsigned int counts, gfp_t flags);
+extern struct trim_acl *trim_acl_clone(const struct trim_acl *acl, gfp_t flags);
+
+extern int trim_acl_to_xattr(const struct trim_acl *acl, void *buffer, size_t size);
+extern struct trim_acl *trim_acl_from_xattr(const void *value, size_t size);
+
+struct trim_acl *get_cached_trim_acl(struct inode *inode);
+void set_cached_trim_acl(struct inode *inode, struct trim_acl *acl);
+
+extern void forget_cached_trim_acl(struct inode *inode);
+
+extern int trim_permission(struct mnt_idmap *idmap, struct dentry *dentry, int perm);
+extern int trim_may_delete(struct mnt_idmap *idmap, struct dentry *victim, struct inode *dir);
+extern int trim_to_mode(struct mnt_idmap *idmap, struct dentry *dentry, struct kstat *stat);
+extern int trim_xattr_permission(struct mnt_idmap *idmap, const char *name, struct dentry *dentry, unsigned int perm);
+extern int trim_acl_chmod(struct mnt_idmap *idmap, struct dentry *dentry, umode_t mode);
+
+extern struct trim_acl *trim_acl_from_disk(const void *value, size_t size);
+extern void *trim_acl_to_disk(const struct trim_acl *acl, size_t *size);
+
+int trimacl_check_acl(struct mnt_idmap *idmap, struct dentry *dentry, int mask, struct trim_access_t *ta);
+unsigned int trimacl_calc_permission(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta);
+int trim_generic_permission_ta(struct mnt_idmap *idmap, struct dentry *dentry, int mask, struct trim_access_t *ta);
+int trim_generic_permission(struct mnt_idmap *idmap, struct dentry *dentry, int mask);
+int trimacl_get_permission(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta);
+unsigned int trimacl_to_mode(struct mnt_idmap *idmap, struct dentry *dentry);
+int trimacl_get_trimacl_xattr_all(struct mnt_idmap *idmap, struct dentry *dentry, unsigned flags, void __user *buffer,
+				  size_t buffer_size);
+
+#endif /* _LINUX_TRIM_ACL_H */
