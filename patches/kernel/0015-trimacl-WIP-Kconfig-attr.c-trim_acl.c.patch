+/* Supported ACL a_version fields */
+#define TRIM_ACL_XATTR_VERSION 0x0001
+
+/* undefined e_id value */
+#define TRIM_ACL_UNDEFINED_ID -1
+
+/* Classify permission type */
+#define TRIM_PERM_READABLE (MAY_READ | MAY_READ_ATTR | MAY_READ_PERMISSION | MAY_READ_EXT_ATTR)
+#define TRIM_PERM_WRITE_DATA (MAY_WRITE | MAY_APPEND | MAY_DEL_CHILD)
+#define TRIM_PERM_WRITABLE (TRIM_PERM_WRITE_DATA | MAY_WRITE_ATTR | MAY_WRITE_EXT_ATTR)
+#define TRIM_PERM_FULL_WRITABLE (TRIM_PERM_WRITABLE | MAY_WRITE_PERMISSION | MAY_GET_OWNER_SHIP | MAY_DEL)
+#define TRIM_PERM_OWNER (MAY_READ_PERMISSION | MAY_WRITE_PERMISSION | MAY_GET_OWNER_SHIP)
+#define TRIM_PERM_FULL_CONTROL \
+	(MAY_EXEC | TRIM_PERM_READABLE | TRIM_PERM_WRITABLE | MAY_WRITE_PERMISSION | MAY_GET_OWNER_SHIP | MAY_DEL)
+
+/* inherit mode in the e_inherit field */
+#define TRIM_ACL_INHERIT_SELF 0x0001
+#define TRIM_ACL_INHERIT_FILE 0x0002
+#define TRIM_ACL_INHERIT_DIR 0x0004
+#define TRIM_ACL_INHERIT_NO_PROPAGATE 0x1000
+#define TRIM_ACL_INHERIT_EXCLUDE 0x4000
+
+#define TRIM_ACL_INHERIT_TYPE (TRIM_ACL_INHERIT_SELF | TRIM_ACL_INHERIT_FILE | TRIM_ACL_INHERIT_DIR)
+
+#define TRIM_ACL_INHERIT_ALL                                                                                    \
+	(TRIM_ACL_INHERIT_SELF | TRIM_ACL_INHERIT_FILE | TRIM_ACL_INHERIT_DIR | TRIM_ACL_INHERIT_NO_PROPAGATE | \
+	 TRIM_ACL_INHERIT_EXCLUDE)
+
+#define TRIM_ACL_XATTR_TAG_IS_ALLOW 0x0001
+#define TRIM_ACL_XATTR_TAG_IS_DENY 0x0002
+#define TRIM_ACL_XATTR_TAG_ALLOW_ALL (TRIM_ACL_XATTR_TAG_IS_ALLOW | TRIM_ACL_XATTR_TAG_IS_DENY)
+
+#define TRIM_ACL_XATTR_TAG_ID_USER 0x0004
+#define TRIM_ACL_XATTR_TAG_ID_GROUP 0x0008
+#define TRIM_ACL_XATTR_TAG_ID_EVERYONE 0x0010
+#define TRIM_ACL_XATTR_TAG_ID_OWNER 0x0020
+#define TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER 0x0040
+#define TRIM_ACL_XATTR_TAG_ID_SYSTEM 0x0080
+#define TRIM_ACL_XATTR_TAG_ID_ALL                                                                    \
+	(TRIM_ACL_XATTR_TAG_ID_USER | TRIM_ACL_XATTR_TAG_ID_GROUP | TRIM_ACL_XATTR_TAG_ID_EVERYONE | \
+	 TRIM_ACL_XATTR_TAG_ID_OWNER | TRIM_ACL_XATTR_TAG_ID_AUTHENTICATEDUSER | TRIM_ACL_XATTR_TAG_ID_SYSTEM)
+
+/*
+ * these two structs should be packed because btrfs-send will transfer raw xattr
+ * data including `trim_acl_xattr_{entry,header}` via trim_acl_to_xattr().
+ */
+typedef struct {
+	__le16 e_tag;
+	__le16 e_unused1;
+	__le32 e_perm;
+	__le16 e_inherit;
+	__le16 e_unused2;
+	__le32 e_id;
+	__le32 e_level;
+} __attribute__((__packed__)) trim_acl_xattr_entry;
+
+typedef struct {
+	__le16 a_version;
+	__le16 a_unused;
+	trim_acl_xattr_entry a_entries[0];
+} __attribute__((__packed__)) trim_acl_xattr_header;
+
+static inline size_t trim_acl_xattr_size(int count)
+{
+	return (sizeof(trim_acl_xattr_header) + (count * sizeof(trim_acl_xattr_entry)));
+}
+
+static inline int trim_acl_xattr_count(size_t size)
+{
+	if (size < sizeof(trim_acl_xattr_header))
+		return -1;
+
+	size -= sizeof(trim_acl_xattr_header);
+	if (size % sizeof(trim_acl_xattr_entry))
+		return -1;
+
+	return size / sizeof(trim_acl_xattr_entry);
+}
+
+#endif /* _UAPI_LINUX_TRIM_ACL_H */
