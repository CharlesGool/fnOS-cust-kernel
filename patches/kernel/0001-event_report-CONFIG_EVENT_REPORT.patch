+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 飞牛 fnOS 内核「事件上报」(CONFIG_EVENT_REPORT) —— 按 6.18.18.c1186-trim 二进制还原。
+ * 内核模块(目前只有 libata)用 er_emit() 上报事件: 放进队列(/sys/kernel/event_report/events 读出)
+ * 并经 netlink 协议 31 广播给本机用户态(飞牛 sysdiag 订阅)。
+ */
+#ifndef _LINUX_EVENT_REPORT_H
+#define _LINUX_EVENT_REPORT_H
+
+#include <linux/types.h>
+
+#define NETLINK_EVENT_REPORT	31
+
+enum control_subevent_id {
+	CONTROL_SUBEVENT_RESPONSE = 0,
+	CONTROL_SUBEVENT_BROADCAST = 1,
+};
+
+enum sata_subevent_type {
+	SATA_SUBEVENT_ERROR = 1,
+	SATA_SUBEVENT_WARNING = 2,
+	SATA_SUBEVENT_NOTICE = 3,
+	SATA_SUBEVENT_INFO = 4,
+	SATA_SUBEVENT_DEBUG = 5,
+};
+
+struct event_report {
+	__u16 event_id;
+	__u16 reserved;
+	__u32 data_len;
+	__u64 timestamp;
+	char data[];
+};
+
+struct ata_error_info {
+	char serial_number[21];
+	char error_desc[256];
+	__u32 error_mask;
+	__u32 serror;
+	__u32 print_id;
+} __packed;
+
+struct event_report *er_event_create(u16 event_id, void *data, size_t data_size);
+void er_event_destroy(struct event_report *ev);
+int er_emit(u16 event_type, u16 subevent_type, void *data, size_t len);
+
+int er_sysfs_read(char *buf, size_t buf_size, ssize_t *result);
+int er_sysfs_add(void);
+void er_sysfs_remove(void);
+
+int er_nl_init(void);
+void er_nl_exit(void);
+int er_nl_send_ev_broadcast(int msg_type, struct event_report *ev);
+
+#endif /* _LINUX_EVENT_REPORT_H */
