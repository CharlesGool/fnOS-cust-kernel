From e84cfa83c0d14642e3c2aef8f970f3edd0decaaf Mon Sep 17 00:00:00 2001
From: kcmp <kcmp@localhost>
Date: Tue, 24 Nov 2026 11:56:47 +0700
Subject: [PATCH 030/110] =?UTF-8?q?open:=20trimacl=20=E6=9D=83=E9=99=90?=
 =?UTF-8?q?=E9=92=A9=E5=AD=90=E5=92=8C=20faccessat2=20=E7=A7=81=E6=9C=89?=
 =?UTF-8?q?=E6=8E=A5=E5=8F=A3=E5=88=86=E6=B4=BE?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- chdir/fchdir/chroot/vfs_truncate: trimacl 文件系统走 trim_permission
- do_faccessat: mode 允许 trim 扩展权限位 (TRIM_PERM_FULL_CONTROL), trimacl
  走 trim_permission(mode|MAY_ACCESS), 否则先 aclv2_mode_to_posix_mode
- do_dentry_open: 卷路径 (d_is_vol_path) 上的普通文件禁止打开 (-EPERM)
- faccessat2: dfd 为 -0x5452..-0x5000 的魔数时分派到 trim_syscall_*
  (路径一律按 AT_FDCWD), 未用的返回 -EOPNOTSUPP:
  -21586 faccessat, -21585 realpath, -21584 set_external_disk_access(mode),
  -21583 get_external_disk_access, -21582 is_trimacl, -21581 is_mountpoint,
  -21580 set_ro_stat, -21579 get_perm, -21578 保留, -21577 may_delete,
  -21576 get_trimacl_xattr, -21575 get_posix_mode, -21574..-20480 保留

vmlinux fcmp: chdir/fchdir/chroot(x64/ia32)、faccessat2(x64/ia32)、
do_faccessat、vfs_truncate、do_dentry_open 全部一致。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 fs/open.c | 89 ++++++++++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 82 insertions(+), 7 deletions(-)

diff --git a/fs/open.c b/fs/open.c
index 3d5ff8f58..2152987fb 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -33,6 +33,8 @@
 #include <linux/compat.h>
 #include <linux/mnt_idmapping.h>
 #include <linux/filelock.h>
+#include <linux/trim_acl.h>
+#include <linux/trimvfs.h>
 
 #include "internal.h"
 
@@ -85,7 +87,10 @@ int vfs_truncate(const struct path *path, loff_t length)
 		return -EINVAL;
 
 	idmap = mnt_idmap(path->mnt);
-	error = inode_permission(idmap, inode, MAY_WRITE);
+	if (IS_TRIMACL(path->dentry))
+		error = trim_permission(idmap, path->dentry, MAY_WRITE);
+	else
+		error = inode_permission(idmap, inode, MAY_WRITE);
 	if (error)
 		return error;
 
@@ -472,7 +477,8 @@ static int do_faccessat(int dfd, const char __user *filename, int mode, int flag
 	unsigned int lookup_flags = LOOKUP_FOLLOW;
 	const struct cred *old_cred = NULL;
 
-	if (mode & ~S_IRWXO)	/* where's F_OK, X_OK, W_OK, R_OK? */
+	/* where's F_OK, X_OK, W_OK, R_OK? (TRIM ACL 还允许查询扩展权限位) */
+	if (mode & ~TRIM_PERM_FULL_CONTROL)
 		return -EINVAL;
 
 	if (flags & ~(AT_EACCESS | AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH))
@@ -506,7 +512,13 @@ static int do_faccessat(int dfd, const char __user *filename, int mode, int flag
 			goto out_path_release;
 	}
 
-	res = inode_permission(mnt_idmap(path.mnt), inode, mode | MAY_ACCESS);
+	if (IS_TRIMACL(path.dentry)) {
+		res = trim_permission(mnt_idmap(path.mnt), path.dentry, mode | MAY_ACCESS);
+	} else {
+		/* 扩展权限位换算成 rwx */
+		mode = aclv2_mode_to_posix_mode(mode);
+		res = inode_permission(mnt_idmap(path.mnt), inode, mode | MAY_ACCESS);
+	}
 	/* SuS v2 requires we report a read only fs too */
 	if (res || !(mode & S_IWOTH) || special_file(inode->i_mode))
 		goto out_path_release;
@@ -541,9 +553,58 @@ SYSCALL_DEFINE3(faccessat, int, dfd, const char __user *, filename, int, mode)
 	return do_faccessat(dfd, filename, mode, 0);
 }
 
+/*
+ * fnOS 私有接口: faccessat2() 的 dfd 传下面的魔数时, 转去执行 trim 私有功能
+ * (路径一律相对当前目录解析). -0x5452 是 "TR".
+ * -0x5452 到 -0x5000 (-20480) 整段保留, 未用的返回 -EOPNOTSUPP.
+ */
+enum {
+	TRIM_SYSCALL_FACCESSAT = -0x5452,	/* -21586 */
+	TRIM_SYSCALL_REALPATH,			/* -21585 */
+	TRIM_SYSCALL_SET_EXTERNAL_DISK_ACCESS,	/* -21584, 参数在 mode */
+	TRIM_SYSCALL_GET_EXTERNAL_DISK_ACCESS,	/* -21583 */
+	TRIM_SYSCALL_IS_TRIMACL,		/* -21582 */
+	TRIM_SYSCALL_IS_MOUNTPOINT,		/* -21581 */
+	TRIM_SYSCALL_SET_RO_STAT,		/* -21580 */
+	TRIM_SYSCALL_GET_PERM,			/* -21579 */
+	TRIM_SYSCALL_RESERVED_8,		/* -21578, 未用 */
+	TRIM_SYSCALL_MAY_DELETE,		/* -21577 */
+	TRIM_SYSCALL_GET_TRIMACL_XATTR,		/* -21576 */
+	TRIM_SYSCALL_GET_POSIX_MODE,		/* -21575 */
+	TRIM_SYSCALL_RESERVED_FIRST,		/* -21574 */
+	TRIM_SYSCALL_RESERVED_LAST = -0x5000,	/* -20480 */
+};
+
 SYSCALL_DEFINE4(faccessat2, int, dfd, const char __user *, filename, int, mode,
 		int, flags)
 {
+	switch (dfd) {
+	case TRIM_SYSCALL_FACCESSAT:
+		return trim_syscall_faccessat(AT_FDCWD, filename, mode, flags);
+	case TRIM_SYSCALL_REALPATH:
+		return trim_syscall_realpath(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_SET_EXTERNAL_DISK_ACCESS:
+		return trim_syscall_set_external_disk_access(mode);
+	case TRIM_SYSCALL_GET_EXTERNAL_DISK_ACCESS:
+		return trim_syscall_get_external_disk_access();
+	case TRIM_SYSCALL_IS_TRIMACL:
+		return trim_syscall_is_trimacl(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_IS_MOUNTPOINT:
+		return trim_syscall_is_mountpoint(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_SET_RO_STAT:
+		return trim_syscall_set_ro_stat(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_GET_PERM:
+		return trim_syscall_get_perm(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_MAY_DELETE:
+		return trim_syscall_may_delete(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_GET_TRIMACL_XATTR:
+		return trim_syscall_get_trimacl_xattr(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_GET_POSIX_MODE:
+		return trim_syscall_get_posix_mode(AT_FDCWD, filename, flags);
+	case TRIM_SYSCALL_RESERVED_8:
+	case TRIM_SYSCALL_RESERVED_FIRST ... TRIM_SYSCALL_RESERVED_LAST:
+		return -EOPNOTSUPP;
+	}
 	return do_faccessat(dfd, filename, mode, flags);
 }
 
@@ -562,7 +623,10 @@ SYSCALL_DEFINE1(chdir, const char __user *, filename)
 	if (error)
 		goto out;
 
-	error = path_permission(&path, MAY_EXEC | MAY_CHDIR);
+	if (IS_TRIMACL(path.dentry))
+		error = trim_permission(mnt_idmap(path.mnt), path.dentry, MAY_EXEC);
+	else
+		error = path_permission(&path, MAY_EXEC | MAY_CHDIR);
 	if (error)
 		goto dput_and_out;
 
@@ -589,7 +653,10 @@ SYSCALL_DEFINE1(fchdir, unsigned int, fd)
 	if (!d_can_lookup(fd_file(f)->f_path.dentry))
 		return -ENOTDIR;
 
-	error = file_permission(fd_file(f), MAY_EXEC | MAY_CHDIR);
+	if (IS_TRIMACL(file_dentry(fd_file(f))))
+		error = trim_permission(file_mnt_idmap(fd_file(f)), file_dentry(fd_file(f)), MAY_EXEC);
+	else
+		error = file_permission(fd_file(f), MAY_EXEC | MAY_CHDIR);
 	if (!error)
 		set_fs_pwd(current->fs, &fd_file(f)->f_path);
 	return error;
@@ -605,7 +672,10 @@ SYSCALL_DEFINE1(chroot, const char __user *, filename)
 	if (error)
 		goto out;
 
-	error = path_permission(&path, MAY_EXEC | MAY_CHDIR);
+	if (IS_TRIMACL(path.dentry))
+		error = trim_permission(mnt_idmap(path.mnt), path.dentry, MAY_EXEC);
+	else
+		error = path_permission(&path, MAY_EXEC | MAY_CHDIR);
 	if (error)
 		goto dput_and_out;
 
@@ -904,9 +974,14 @@ static int do_dentry_open(struct file *f,
 			  int (*open)(struct inode *, struct file *))
 {
 	static const struct file_operations empty_fops = {};
-	struct inode *inode = f->f_path.dentry->d_inode;
+	struct inode *inode;
 	int error;
 
+	/* 卷路径(存储池挂载点等)上的普通文件不允许打开 */
+	if (d_is_reg(f->f_path.dentry) && d_is_vol_path(f->f_path.dentry))
+		return -EPERM;
+
+	inode = f->f_path.dentry->d_inode;
 	path_get(&f->f_path);
 	f->f_inode = inode;
 	f->f_mapping = inode->i_mapping;
