+	.getattr		= trimafs2_getattr,			\
+	.listxattr		= trimafs2_listxattr,			\
+	.set_acl		= trimafs2_set_acl,			\
+	.fileattr_set		= trimafs2_fileattr_set,		\
+	.fileattr_get		= trimafs2_fileattr_get,		\
+	.is_trimacl		= trimafs2_is_trimacl,			\
+	.trim_permission	= trimafs2_trimacl_permission,		\
+	.trim_acl_to_mode	= trimafs2_trim_acl_to_mode,		\
+	.get_trimacl_xattr_all	= trimafs2_get_trimacl_xattr_all,	\
