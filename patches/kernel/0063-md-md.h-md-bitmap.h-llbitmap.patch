+
 	/*
 	 * Temporarily store rdev that will be finally removed when
 	 * reconfig_mutex is unlocked, protected by reconfig_mutex.
@@ -632,6 +704,11 @@ struct mddev {
 
 	/* The sequence number for sync thread */
 	atomic_t sync_seq;
+
+	struct md_degradation_free_recover *dfr;	/* fnnas */
+	unsigned long			failures;	/* fnnas: enum md_failure */
+	bool				allow_fast_resync:1;
+	bool				enable_requested_resync_hints:1;
 };
 
 enum recovery_flags {
@@ -675,10 +752,14 @@ enum recovery_flags {
