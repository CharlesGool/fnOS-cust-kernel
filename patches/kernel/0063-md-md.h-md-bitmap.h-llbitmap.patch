@@ -880,6 +972,8 @@ struct md_thread {
 
 struct md_io_clone {
 	struct mddev	*mddev;
+	struct md_rdev	*rdev;		/* fnnas: degradation free recover */
+	bool		dfr_bio;
 	struct bio	*orig_bio;
