+};
+
+/* fnnas: bits in mddev->failures */
+enum md_failure {
+	MD_FAILURE_RESYNC,
+	NR_MD_FAILURES,
+};
+
+/* fnnas: bits in md_degradation_free_recover->flags */
+enum md_dfr_flags {
+	DFR_F_ENABLED,
+	DFR_F_PLUG,
+	DFR_F_WAITED,
+	DFR_F_SYNC_TAKEOVER,
+};
+
+/*
+ * fnnas: degradation free recover, an offline member disk keeps its slot
+ * for a while instead of being kicked out of the array.
+ */
+struct md_degradation_free_recover {
+	struct mddev		*mddev;
+	spinlock_t		lock;
+	unsigned long		flags;		/* enum md_dfr_flags */
+	atomic_t		pending;
+	struct bio_list		dfr_bios;
+	struct timer_list	dfr_timer;
+	struct work_struct	dfr_unplug_work;
+	struct work_struct	dfr_wait_work;
+	wait_queue_head_t	unplug_wait;
+	struct md_thread	*probe;
+	unsigned int		dfr_timeout;
+};
+
 /*
  * mddev->curr_resync stores the current sector of the resync but
  * also has some overloaded values.
@@ -445,6 +505,7 @@ struct mddev {
