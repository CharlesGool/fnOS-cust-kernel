 	struct kernfs_node		*sysfs_completed;	/*handle for 'sync_completed' */
 	struct kernfs_node		*sysfs_degraded;	/*handle for 'degraded' */
+	struct kernfs_node		*sysfs_failures;	/* fnnas: handle for 'failures' */
 	struct kernfs_node		*sysfs_level;		/*handle for 'level' */
 
 	/* used for delayed sysfs removal */
@@ -624,6 +686,16 @@ struct mddev {
 	struct md_cluster_operations *cluster_ops;
 	unsigned int			good_device_nr;	/* good device num within cluster raid */
 
+	/* fnnas private */
+	int				flush_plug_threshold;
+	unsigned char			resync_mode;
+	struct md_resync_hint_tree	resync_rh_tree;	/* requested resync hints */
+	struct mutex			resync_rh_mutex;
