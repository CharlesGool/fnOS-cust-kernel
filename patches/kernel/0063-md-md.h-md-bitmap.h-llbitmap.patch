 };
 
 enum mddev_sb_flags {
@@ -386,6 +401,51 @@ struct serial_info {
 	sector_t _subtree_last; /* highest sector in subtree of rb node */
 };
 
+/* fnnas: range hints for requested resync / skipped sync */
+struct md_resync_hint {
+	sector_t		h_start;
+	sector_t		h_end;
+	struct rb_node		node;
+};
+
+struct md_resync_hint_tree {
+	struct rb_root_cached	root;
