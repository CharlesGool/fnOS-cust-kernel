diff --git a/drivers/md/md-bitmap.c b/drivers/md/md-bitmap.c
index cef236893..ba6036162 100644
--- a/drivers/md/md-bitmap.c
+++ b/drivers/md/md-bitmap.c
@@ -1730,6 +1730,16 @@ static void bitmap_start_write(struct mddev *mddev, sector_t offset,
 	}
 }
 
+static void bitmap_end_write(struct mddev *mddev, sector_t offset,
+			     unsigned long sectors);
+
+static void bitmap_end_discard(struct mddev *mddev, sector_t offset,
+			       unsigned long sectors,
+			       enum md_bitmap_discard_result result)
+{
+	bitmap_end_write(mddev, offset, sectors);
+}
+
 static void bitmap_end_write(struct mddev *mddev, sector_t offset,
 			     unsigned long sectors)
 {
@@ -3091,7 +3101,7 @@ static struct bitmap_operations bitmap_ops = {
 	.start_write		= bitmap_start_write,
 	.end_write		= bitmap_end_write,
 	.start_discard		= bitmap_start_write,
-	.end_discard		= bitmap_end_write,
+	.end_discard		= bitmap_end_discard,
 
 	.start_sync		= bitmap_start_sync,
 	.end_sync		= bitmap_end_sync,
diff --git a/drivers/md/md-bitmap.h b/drivers/md/md-bitmap.h
index 890276d9c..f3111f552 100644
--- a/drivers/md/md-bitmap.h
+++ b/drivers/md/md-bitmap.h
@@ -81,6 +81,17 @@ struct md_bitmap_stats {
 typedef void (md_bitmap_fn)(struct mddev *mddev, sector_t offset,
 			    unsigned long sectors);
 
+/* fnnas: result of the discard io, passed to bitmap_operations->end_discard */
+enum md_bitmap_discard_result {
+	MD_BITMAP_DISCARD_SUCCESS,
+	MD_BITMAP_DISCARD_UNSUPPORTED,
+	MD_BITMAP_DISCARD_FAILED,
+};
+
+typedef void (md_bitmap_end_discard_fn)(struct mddev *mddev, sector_t offset,
+					unsigned long sectors,
+					enum md_bitmap_discard_result result);
+
 struct bitmap_operations {
 	struct md_submodule_head head;
 
@@ -94,6 +105,18 @@ struct bitmap_operations {
 	void (*write_all)(struct mddev *mddev);
 	void (*dirty_bits)(struct mddev *mddev, unsigned long s,
 			   unsigned long e);
+	/* Prepare a range for this bitmap implementation. */
+	void (*prepare_range)(struct mddev *mddev,
+			      sector_t *offset,
+			      unsigned long *sectors,
+			      bool discard);
+	void (*reshape_finish)(struct mddev *mddev);
+	int (*reshape_can_start)(struct mddev *mddev);
+	void (*reshape_mark)(struct mddev *mddev, sector_t old_pos,
+			     sector_t new_pos);
+	/* fnnas */
+	bool (*reshape_can_skip)(struct mddev *mddev, sector_t start,
+				 sector_t end);
 	void (*unplug)(struct mddev *mddev, bool sync);
 	void (*daemon_work)(struct mddev *mddev);
 
@@ -104,7 +127,7 @@ struct bitmap_operations {
 	md_bitmap_fn *start_write;
 	md_bitmap_fn *end_write;
 	md_bitmap_fn *start_discard;
-	md_bitmap_fn *end_discard;
+	md_bitmap_end_discard_fn *end_discard;
 
 	sector_t (*skip_sync_blocks)(struct mddev *mddev, sector_t offset);
 	bool (*blocks_synced)(struct mddev *mddev, sector_t offset);
diff --git a/drivers/md/md-llbitmap.c b/drivers/md/md-llbitmap.c
index 903ce6bb2..e447f7222 100644
--- a/drivers/md/md-llbitmap.c
+++ b/drivers/md/md-llbitmap.c
@@ -208,6 +208,20 @@ enum llbitmap_state {
 	BitNeedSync,
 	/* data is synchronizing */
 	BitSyncing,
+	/*
+	 * Proactive sync requested for unwritten region (raid456 only).
+	 * Triggered via sysfs when user wants to pre-build XOR parity
+	 * for regions that have never been written.
+	 */
+	BitNeedSyncUnwritten,
+	/* Proactive sync in progress for unwritten region */
+	BitSyncingUnwritten,
+	/*
+	 * XOR parity has been pre-built for a region that has never had
+	 * user data written. When user writes to this region, it transitions
+	 * to BitDirty.
+	 */
+	BitCleanUnwritten,
 	BitStateCount,
 	BitNone = 0xff,
 };
@@ -227,11 +241,21 @@ enum llbitmap_action {
 	BitmapActionDaemon,
 	/* Data is deleted */
 	BitmapActionDiscard,
+	/* fnnas: discard io is done, see enum md_bitmap_discard_result */
+	BitmapActionDiscardSuccess,
+	BitmapActionDiscardUnsupported,
+	BitmapActionDiscardFailed,
 	/*
 	 * Bitmap is stale, mark all bits in addition to BitUnwritten to
 	 * BitNeedSync.
 	 */
 	BitmapActionStale,
+	/*
+	 * Proactive sync trigger for raid456 - builds XOR parity for
+	 * Unwritten regions without requiring user data write first.
+	 */
+	BitmapActionProactiveSync,
+	BitmapActionClearUnwritten,
 	BitmapActionCount,
 	/* Init state is BitUnwritten */
 	BitmapActionInit,
@@ -249,6 +273,8 @@ struct llbitmap_page_ctl {
 	unsigned long flags;
 	wait_queue_head_t wait;
 	struct percpu_ref active;
+	/* fnnas: sequential write detection */
+	u16 last_seq[8];
 	/* Per block size dirty state, maximum 64k page / 1 sector = 128 */
 	unsigned long dirty[];
 };
@@ -267,6 +293,11 @@ struct llbitmap {
 	unsigned long chunksize;
 	/* total number of chunks */
 	unsigned long chunks;
+	/* total number of sectors tracked by current bitmap geometry */
+	sector_t sync_size;
+	unsigned long reshape_chunksize;
+	unsigned long reshape_chunks;
+	sector_t reshape_sync_size;
 	unsigned long last_end_sync;
 	/*
 	 * time in seconds that dirty bits will be cleared if the page is not
@@ -276,13 +307,37 @@ struct llbitmap {
 	/* fires on first BitDirty state */
 	struct timer_list pending_timer;
 	struct work_struct daemon_work;
+	/*
+	 * Serialize reshape checkpoint remapping against normal I/O bitmap
+	 * updates without blocking concurrent I/O updates on each other.
+	 */
+	rwlock_t reshape_lock;
 
 	unsigned long flags;
 	__u64	events_cleared;
+	/* fnnas: enum llbitmap_resync_mode */
+	u32 resync_mode;
+	/* fnnas: number of bits in each state */
+	atomic_t state_count[BitStateCount];
 
 	/* for slow disks */
 	atomic_t behind_writes;
 	wait_queue_head_t behind_wait;
+	/* fnnas */
+	bool seq_infect;
+};
+
+/* fnnas: llbitmap->resync_mode */
+enum llbitmap_resync_mode {
+	LLBITMAP_RESYNC_MODE_RESYNC,
+	LLBITMAP_RESYNC_MODE_RECOVERY,
+};
+
+struct llbitmap_reshape_range {
+	sector_t offset;
+	unsigned long sectors;
+	sector_t start;
+	sector_t end;
 };
 
 struct llbitmap_unplug_work {
@@ -1121,7 +1176,8 @@ static void llbitmap_start_discard(struct mddev *mddev, sector_t offset,
 }
 
 static void llbitmap_end_discard(struct mddev *mddev, sector_t offset,
-				 unsigned long sectors)
+				 unsigned long sectors,
+				 enum md_bitmap_discard_result result)
 {
 	struct llbitmap *llbitmap = mddev->bitmap;
 	unsigned long start = DIV_ROUND_UP_SECTOR_T(offset, llbitmap->chunksize);
diff --git a/drivers/md/md.c b/drivers/md/md.c
index c54f5f34b..45ff61770 100644
--- a/drivers/md/md.c
+++ b/drivers/md/md.c
@@ -68,6 +68,7 @@
 #include "md.h"
 #include "md-bitmap.h"
 #include "md-cluster.h"
+#include "raid5.h"
 
 static const char *action_name[NR_SYNC_ACTIONS] = {
 	[ACTION_RESYNC]		= "resync",
@@ -9310,11 +9311,13 @@ static void md_bitmap_start(struct mddev *mddev,
 
 static void md_bitmap_end(struct mddev *mddev, struct md_io_clone *md_io_clone)
 {
-	md_bitmap_fn *fn = unlikely(md_io_clone->rw == STAT_DISCARD) ?
-			   mddev->bitmap_ops->end_discard :
-			   mddev->bitmap_ops->end_write;
-
-	fn(mddev, md_io_clone->offset, md_io_clone->sectors);
+	if (unlikely(md_io_clone->rw == STAT_DISCARD))
+		mddev->bitmap_ops->end_discard(mddev, md_io_clone->offset,
+					       md_io_clone->sectors,
+					       MD_BITMAP_DISCARD_SUCCESS);
+	else
+		mddev->bitmap_ops->end_write(mddev, md_io_clone->offset,
+					     md_io_clone->sectors);
 }
 
 static void md_end_clone_io(struct bio *bio)
