diff --git a/block/blk-lib.c b/block/blk-lib.c
index 352e3c0f8..ad978fa80 100644
--- a/block/blk-lib.c
+++ b/block/blk-lib.c
@@ -369,3 +369,74 @@ int blkdev_issue_secure_erase(struct block_device *bdev, sector_t sector,
 	return ret;
 }
 EXPORT_SYMBOL(blkdev_issue_secure_erase);
+
+/**
+ * blkdev_hint_unused - tell the device that a range of sectors is unused
+ * @bdev:	blockdev to issue the hint to
+ * @sector:	start sector
+ * @nr_sects:	number of sectors
+ * @gfp_mask:	memory allocation flags (for bio_alloc)
+ *
+ * Description:
+ *    Send REQ_OP_UNUSED_HINT bios for the range, so that a raid driver can
+ *    skip resync/recovery of space that the filesystem does not use.
+ *    Devices that do not support it are silently ignored.
+ */
+int blkdev_hint_unused(struct block_device *bdev, sector_t sector,
+		       sector_t nr_sects, gfp_t gfp_mask)
+{
+	struct request_queue *q;
+	unsigned int granularity, max_sectors;
+	struct bio *bio = NULL;
+	struct blk_plug plug;
+	sector_t start;
+	int ret = 0;
+
+	blk_start_plug(&plug);
+	q = bdev_get_queue(bdev);
+	if (!q) {
+		ret = -ENXIO;
+		goto out;
+	}
+	if (!blk_queue_unused_hint(q)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	granularity = queue_logical_block_size(q) >> SECTOR_SHIFT;
+	start = __ALIGN_MASK(sector, (sector_t)(granularity - 1));
+	if (start != sector) {
+		if (start - sector < nr_sects)
+			nr_sects = sector + nr_sects - start;
+		else
+			nr_sects = 0;
+	}
+
+	max_sectors = round_down(round_down(UINT_MAX,
+			queue_logical_block_size(q)) >> SECTOR_SHIFT, granularity);
+
+	while (nr_sects) {
+		bio = blk_next_bio(bio, bdev, 0, REQ_OP_UNUSED_HINT, gfp_mask);
+		bio->bi_iter.bi_sector = start;
+		if (nr_sects > max_sectors) {
+			bio->bi_iter.bi_size = max_sectors << SECTOR_SHIFT;
+			nr_sects -= max_sectors;
+			start += max_sectors;
+		} else {
+			bio->bi_iter.bi_size = nr_sects << SECTOR_SHIFT;
+			nr_sects = 0;
+		}
+		cond_resched();
+	}
+
+	if (bio) {
+		ret = submit_bio_wait(bio);
+		if (ret == -EOPNOTSUPP)
+			ret = 0;
+		bio_put(bio);
+	}
+out:
+	blk_finish_plug(&plug);
+	return ret;
+}
+EXPORT_SYMBOL(blkdev_hint_unused);
diff --git a/block/blk-merge.c b/block/blk-merge.c
index 5d895c789..61feab8f4 100644
--- a/block/blk-merge.c
+++ b/block/blk-merge.c
@@ -205,6 +205,26 @@ struct bio *bio_split_discard(struct bio *bio, const struct queue_limits *lim,
 	return __bio_split_discard(bio, lim, nsegs, max_sectors);
 }
 
+/*
+ * Unused hints carry no data, only a sector range, so they only have to be
+ * split at the max bio size, aligned to the logical block size.
+ */
+struct bio *blk_bio_unused_hint_split(struct bio *bio,
+		const struct queue_limits *lim, unsigned *nsegs)
+{
+	unsigned int granularity = lim->logical_block_size >> SECTOR_SHIFT;
+	unsigned int max_sectors;
+
+	*nsegs = 1;
+
+	max_sectors = round_down(bio_allowed_max_sectors(lim), granularity);
+	if (bio_sectors(bio) <= max_sectors)
+		return bio;
+
+	return bio_split(bio, max_sectors, GFP_NOIO,
+			 &bio->bi_bdev->bd_disk->bio_split);
+}
+
 static inline unsigned int blk_boundary_sectors(const struct queue_limits *lim,
 						bool is_atomic)
 {
@@ -490,6 +510,7 @@ unsigned int blk_recalc_rq_segments(struct request *rq)
 	switch (bio_op(rq->bio)) {
 	case REQ_OP_DISCARD:
 	case REQ_OP_SECURE_ERASE:
+	case REQ_OP_UNUSED_HINT:
 		if (queue_max_discard_segments(rq->q) > 1) {
 			struct bio *bio = rq->bio;
 
diff --git a/block/blk.h b/block/blk.h
index d2017c787..595308c65 100644
--- a/block/blk.h
+++ b/block/blk.h
@@ -392,6 +392,8 @@ ssize_t part_timeout_store(struct device *, struct device_attribute *,
 
 struct bio *bio_split_discard(struct bio *bio, const struct queue_limits *lim,
 		unsigned *nsegs);
+struct bio *blk_bio_unused_hint_split(struct bio *bio,
+		const struct queue_limits *lim, unsigned *nsegs);
 struct bio *bio_split_write_zeroes(struct bio *bio,
 		const struct queue_limits *lim, unsigned *nsegs);
 struct bio *bio_split_rw(struct bio *bio, const struct queue_limits *lim,
@@ -448,6 +450,8 @@ static inline struct bio *__bio_split_to_limits(struct bio *bio,
 		return bio_split_discard(bio, lim, nr_segs);
 	case REQ_OP_WRITE_ZEROES:
 		return bio_split_write_zeroes(bio, lim, nr_segs);
+	case REQ_OP_UNUSED_HINT:
+		return blk_bio_unused_hint_split(bio, lim, nr_segs);
 	default:
 		/* other operations can't be split */
 		*nr_segs = 0;
