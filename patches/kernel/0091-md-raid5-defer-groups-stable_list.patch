+		old = conf->defer_group_disk_cnt_max;
+		conf->defer_group_disk_cnt_max = new;
+		err = adjust_raid5_defer_groups(mddev);
+		if (err)
+			conf->defer_group_disk_cnt_max = old;
+		else
+			pr_err("md: %s: change defer group disk cnt max to %d\n",
+			       mdname(mddev), conf->defer_group_disk_cnt_max);
+	}
+	mddev_unlock_and_resume(mddev);
+	return err ?: len;
