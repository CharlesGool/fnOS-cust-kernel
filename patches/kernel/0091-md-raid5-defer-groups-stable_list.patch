+{
+	struct r5conf *conf;
+	unsigned long new;
+	int old;
+	int err;
+
+	if (len >= PAGE_SIZE)
+		return -EINVAL;
+	if (kstrtoul(page, 10, &new))
+		return -EINVAL;
+	if (new == 0 || new > DEFER_GROUP_DISK_CNT_MAX)
+		return -EINVAL;
