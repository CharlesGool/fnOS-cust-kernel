+static ssize_t
+raid5_store_defer_mode(struct mddev *mddev, const char *page, size_t len)
+{
+	struct r5conf *conf;
+	unsigned long new;
+	int err;
+
+	if (len >= PAGE_SIZE)
+		return -EINVAL;
+	if (kstrtoul(page, 10, &new))
+		return -EINVAL;
+	new = !!new;
+
+	err = mddev_suspend_and_lock(mddev);
+	if (err)
+		return err;
+	conf = mddev->private;
+	if (!conf) {
+		err = -ENODEV;
+	} else if (!conf->defer_groups) {
+		pr_err("md: %s: defer_groups did not allocated, refuse to adjust defer_mode\n",
+		       mdname(mddev));
+		err = -ENODEV;
+	} else if (new != conf->defer_mode) {
+		conf->defer_mode = new;
+		pr_err("md: %s: change defer mode to %d\n",
+		       mdname(mddev), conf->defer_mode);
+	}
+	mddev_unlock_and_resume(mddev);
+	return err ?: len;
+}
