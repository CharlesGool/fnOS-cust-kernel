+/*
+ * fnnas: deferred io dispatch groups, see group_handle_deferred_bios().
+ */
+static void ext_flush_deferred_bios(struct md_thread *thread)
+{
+	struct blk_plug plug;
+	struct mddev *mddev = thread->mddev;
+	struct r5conf *conf = mddev->private;
+	struct r5defer *group = thread->private;
+	int pending_cnt;
+
+	/* timeout wakeup, or the thread runs before the group is ready */
+	if (!conf->defer_mode || !group)
+		return;
+
+	blk_start_plug(&plug);
+	do {
+		if (conf->defer_skip_sort)
+			pending_cnt = group_flush_deferred_bios(group);
+		else
+			pending_cnt = group_handle_deferred_bios(group, conf);
+		cond_resched();
+	} while (pending_cnt >= conf->defer_flush_threshold);
+	blk_finish_plug(&plug);
+}
+
+static void free_raid5_defer_groups(struct mddev *mddev, int group_cnt,
+				    struct r5defer *defer_groups)
+{
+	int i;
+	struct r5defer *group;
+
+	if (!defer_groups)
+		return;
+
+	for (i = 0; i < group_cnt; ++i) {
+		group = &defer_groups[i];
+
+		WARN_ON(group->pending_data_cnt != 0);
+		WARN_ON(!bio_list_empty(&group->pending_bios));
+		WARN_ON(!list_empty(&group->pending_list));
+
+		md_unregister_thread(mddev, &group->defer_thread);
+		kfree(group->pending_data);
+		group->pending_data = NULL;
+	}
+
+	kfree(defer_groups);
+}
+
+static int alloc_raid5_defer_groups(struct mddev *mddev, int *group_cnt,
+				    struct r5defer **defer_groups)
+{
+	int i, j;
+	char name[TASK_COMM_LEN];
+	struct r5defer *group;
+	struct r5defer *groups;
+
+	if (*group_cnt <= 0 || *group_cnt > mddev->raid_disks) {
+		pr_err("%s: bad defer group count: %d, abort\n",
+		       mdname(mddev), *group_cnt);
+		return -EINVAL;
+	}
+
+	if (*group_cnt > DEFER_GROUP_CNT_MAX) {
+		pr_err("%s: bad defer group count: %d, wrap count to %d\n",
+		       mdname(mddev), *group_cnt, DEFER_GROUP_CNT_MAX);
+		*group_cnt = DEFER_GROUP_CNT_MAX;
+	}
+
+	groups = kcalloc(*group_cnt, sizeof(struct r5defer), GFP_NOIO);
+	if (!groups)
+		return -ENOMEM;
+
+	for (i = 0; i < *group_cnt; ++i) {
+		group = &groups[i];
+
+		INIT_LIST_HEAD(&group->free_list);
+		INIT_LIST_HEAD(&group->pending_list);
+		bio_list_init(&group->pending_bios);
+		spin_lock_init(&group->pending_bios_lock);
+		group->pending_data_cnt = 0;
+
+		group->pending_data = kcalloc(DEFER_MAX_SORT_ENT_CNT,
+					      sizeof(struct r5pending_data),
+					      GFP_NOIO);
+		if (!group->pending_data)
+			goto abort;
+		for (j = 0; j < DEFER_MAX_SORT_ENT_CNT; ++j)
+			list_add(&group->pending_data[j].sibling,
+				 &group->free_list);
+
+		sprintf(name, "defer%d", i);
+		group->defer_thread = md_register_thread(ext_flush_deferred_bios,
+							 mddev, name);
+		if (!group->defer_thread) {
+			pr_err("%s: failed to create defer_thread\n",
+			       mdname(mddev));
+			goto abort;
+		}
+		group->defer_thread->private = group;
+	}
+
+	*defer_groups = groups;
+	return 0;
+
+abort:
+	free_raid5_defer_groups(mddev, *group_cnt, groups);
+	return -ENOMEM;
+}
+
+/* fnnas: regroup the member disks after raid_disks or disk_cnt_max changed */
+static int adjust_raid5_defer_groups(struct mddev *mddev)
+{
+	int err;
+	int old_group_cnt, new_group_cnt;
+	struct r5defer *old_groups;
+	struct r5defer *new_groups = NULL;
+	struct r5conf *conf = mddev->private;
+
+	old_groups = conf->defer_groups;
+	old_group_cnt = conf->defer_group_cnt;
+	new_group_cnt = (mddev->raid_disks - 1) /
+			conf->defer_group_disk_cnt_max + 1;
+
+	if (new_group_cnt == old_group_cnt ||
+	    (new_group_cnt >= DEFER_GROUP_CNT_MAX &&
+	     old_group_cnt >= DEFER_GROUP_CNT_MAX))
+		return 0;
+
+	err = alloc_raid5_defer_groups(mddev, &new_group_cnt, &new_groups);
+	if (err) {
+		pr_err("md: %s: failed to adjust defer groups from %d to %d\n",
+		       mdname(mddev), old_group_cnt, new_group_cnt);
+		return err;
+	}
+
+	conf->defer_groups = new_groups;
+	conf->defer_group_cnt = new_group_cnt;
+	free_raid5_defer_groups(mddev, old_group_cnt, old_groups);
+	return 0;
+}
+
+static ssize_t
+raid5_show_defer_group_cnt(struct mddev *mddev, char *page)
+{
+	struct r5conf *conf;
+	int ret = 0;
+
+	spin_lock(&mddev->lock);
+	conf = mddev->private;
+	if (conf)
+		ret = sprintf(page, "%d\n", conf->defer_group_cnt);
+	spin_unlock(&mddev->lock);
+	return ret;
+}
+
+static ssize_t
+raid5_store_defer_group_cnt(struct mddev *mddev, const char *page, size_t len)
+{
+	struct r5conf *conf;
+	unsigned int new;
+	int old_group_cnt;
+	struct r5defer *old_groups;
+	struct r5defer *new_groups = NULL;
+	int err;
+
+	if (len >= PAGE_SIZE)
+		return -EINVAL;
+	if (kstrtouint(page, 10, &new))
+		return -EINVAL;
+
+	err = mddev_suspend_and_lock(mddev);
+	if (err)
+		return err;
+	conf = mddev->private;
+	if (!conf) {
+		err = -ENODEV;
+		goto out;
+	}
+	if (new == 0 || new > DEFER_GROUP_CNT_MAX || new > mddev->raid_disks) {
+		err = -EINVAL;
+		goto out;
+	}
+	if (new == conf->defer_group_cnt)
+		goto out;
+
+	old_groups = conf->defer_groups;
+	old_group_cnt = conf->defer_group_cnt;
+	err = alloc_raid5_defer_groups(mddev, (int *)&new, &new_groups);
+	if (err) {
+		pr_err("md: %s: failed to change defer groups\n",
+		       mdname(mddev));
+		goto out;
+	}
+
+	conf->defer_groups = new_groups;
+	conf->defer_group_cnt = new;
+	free_raid5_defer_groups(mddev, old_group_cnt, old_groups);
+	pr_warn("md: %s: change defer groups from %d to %d\n",
+		mdname(mddev), old_group_cnt, conf->defer_group_cnt);
+out:
+	mddev_unlock_and_resume(mddev);
+	return err ?: len;
+}
