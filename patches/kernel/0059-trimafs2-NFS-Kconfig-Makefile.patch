+# SPDX-License-Identifier: GPL-2.0-only
+config TRIMAFS2_FS
+	tristate "TRIM aggregate stacking filesystem"
+	depends on FS_TRIM_ACL && EXPORTFS
+	select FS_STACK
+	help
+	  飞牛 fnOS 的聚合堆叠文件系统(文件系统类型 "trimafs"). 上层是一棵
+	  内存目录树, root 用绝对路径 symlink 把下层目录挂成"桥", 桥下的
+	  对象全部转发到下层文件系统, 并支持 TRIM ACL 和 NFS 导出.
+
+	  不确定就选 N.
