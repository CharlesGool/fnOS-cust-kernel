 			     &dd_idx, sh);
 }
 
+/*
+ * fnnas: fail all bios of @bi chain that belong to @dev, the bios are
+ * completed through stripe_end_bio() so that md can account them.
+ */
+static void stripe_fail_bio_list(struct r5conf *conf, struct stripe_head *sh,
+				 struct r5dev *dev, struct bio *bi)
+{
+	while (bi && bi->bi_iter.bi_sector <
+	       dev->sector + RAID5_STRIPE_SECTORS(conf)) {
+		struct bio *nextbi = r5_next_bio(conf, bi, dev->sector);
+
+		if (op_is_write(bio_op(bi)))
+			md_write_end(conf->mddev);
+		bi->bi_status = BLK_STS_IOERR;
+		stripe_end_bio(sh, bi);
+		bi = nextbi;
+	}
+}
