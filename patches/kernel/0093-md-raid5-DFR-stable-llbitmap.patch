+		else if (test_bit(R5_UPTODATE, &dev->flags) &&
 			 test_bit(R5_Expanded, &dev->flags))
 			/* If we've reshaped into here, we assume it is Insync.
 			 * We will shortly update recovery_offset to make
@@ -5148,6 +5153,63 @@ static void break_stripe_batch_list(struct stripe_head *head_sh,
 		set_bit(STRIPE_HANDLE, &head_sh->state);
 }
 
+/*
+ * fnnas: the stripe hit a member disk that is in degradation free recover
+ * (DFR), fail all pending bios of the stripe so that md can retry them.
+ */
+static void handle_dfr_stripe(struct r5conf *conf, struct stripe_head *sh)
+{
+	int i;
+
+	clear_bit(STRIPE_DELAYED, &sh->state);
+	break_stripe_batch_list(sh, 0);
+	BUG_ON(sh->batch_head);
+
+	for (i = sh->disks; i--; ) {
+		struct r5dev *dev = &sh->dev[i];
+		struct bio *bi;
+
+		spin_lock_irq(&sh->stripe_lock);
+		bi = dev->towrite;
+		dev->towrite = NULL;
+		sh->overwrite_disks = 0;
+		spin_unlock_irq(&sh->stripe_lock);
+
+		log_stripe_write_finished(sh);
+
+		if (test_and_clear_bit(R5_Overlap, &dev->flags))
+			wake_up_bit(&dev->flags, R5_Overlap);
+
+		stripe_fail_bio_list(conf, sh, dev, bi);
+
+		bi = dev->written;
+		dev->written = NULL;
+		if (test_and_clear_bit(R5_SkipCopy, &dev->flags)) {
+			WARN_ON(test_bit(R5_UPTODATE, &dev->flags));
+			dev->page = dev->orig_page;
+		}
+		stripe_fail_bio_list(conf, sh, dev, bi);
+
+		spin_lock_irq(&sh->stripe_lock);
+		bi = dev->toread;
+		dev->toread = NULL;
+		spin_unlock_irq(&sh->stripe_lock);
+		if (test_and_clear_bit(R5_Overlap, &dev->flags))
+			wake_up_bit(&dev->flags, R5_Overlap);
+		stripe_fail_bio_list(conf, sh, dev, bi);
+
+		bi = dev->read;
+		dev->read = NULL;
+		stripe_fail_bio_list(conf, sh, dev, bi);
+
+		clear_bit(R5_LOCKED, &dev->flags);
+	}
+
+	if (test_and_clear_bit(STRIPE_FULL_WRITE, &sh->state))
+		if (atomic_dec_and_test(&conf->pending_full_writes))
+			md_wakeup_thread(conf->mddev->thread);
+}
+
 static void handle_stripe(struct stripe_head *sh)
 {
 	struct stripe_head_state s;
@@ -5175,6 +5237,12 @@ static void handle_stripe(struct stripe_head *sh)
 		return;
 	}
 
+	if (test_bit(STRIPE_DFR, &sh->state)) {
+		handle_dfr_stripe(conf, sh);
+		clear_bit_unlock(STRIPE_ACTIVE, &sh->state);
+		return;
+	}
+
 	if (test_and_clear_bit(STRIPE_BATCH_ERR, &sh->state))
 		break_stripe_batch_list(sh, 0);
 
@@ -5209,7 +5277,7 @@ static void handle_stripe(struct stripe_head *sh)
 
 	if (s.handle_bad_blocks ||
 	    (md_is_rdwr(conf->mddev) &&
-	     test_bit(MD_SB_CHANGE_PENDING, &conf->mddev->sb_flags))) {
+	     md_sb_pending(conf->mddev))) {
 		set_bit(STRIPE_HANDLE, &sh->state);
 		goto finish;
 	}
@@ -5270,6 +5338,24 @@ static void handle_stripe(struct stripe_head *sh)
 		BUG_ON(sh->qd_idx >= 0 &&
 		       !test_bit(R5_UPTODATE, &sh->dev[sh->qd_idx].flags) &&
 		       !test_bit(R5_Discard, &sh->dev[sh->qd_idx].flags));
+		set_bit(STRIPE_STABLE_STATE, &sh->state);
+		/*
+		 * fnnas: while recovering, also write the up-to-date blocks of
+		 * the failed (recovering) devices.
+		 */
+		if ((test_bit(MD_RECOVERY_RUNNING, &conf->mddev->recovery) &&
+		     test_bit(MD_RECOVERY_RECOVER, &conf->mddev->recovery)) ||
+		    md_llbitmap_sync_target(conf->mddev, sh->sector) >= 0)
+			for (i = 0; i < s.failed; i++) {
+				struct r5dev *dev = &sh->dev[s.failed_num[i]];
+
+				if (test_bit(R5_UPTODATE, &dev->flags) &&
+				    !test_bit(R5_LOCKED, &dev->flags)) {
+					set_bit(R5_LOCKED, &dev->flags);
+					s.locked++;
+					set_bit(R5_Wantwrite, &dev->flags);
+				}
+			}
 		for (i = disks; i--; ) {
 			struct r5dev *dev = &sh->dev[i];
 			if (test_bit(R5_LOCKED, &dev->flags) &&
