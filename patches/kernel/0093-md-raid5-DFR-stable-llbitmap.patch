@@ -4948,23 +4958,18 @@ static void analyse_stripe(struct stripe_head *sh, struct stripe_head_state *s)
 				set_bit(R5_Insync, &dev->flags);
 				set_bit(R5_ReadError, &dev->flags);
 			}
-		} else if (test_bit(In_sync, &rdev->flags))
+		} else if (md_llbitmap_sync_target(conf->mddev, sh->sector) == i)
+			/*
+			 * fnnas: llbitmap is rebuilding this device's data for
