 		 * still be locked - so just clear all R5_LOCKED flags
@@ -3932,6 +3930,18 @@ handle_failed_sync(struct r5conf *conf, struct stripe_head *sh,
 		wake_up_bit(&sh->dev[sh->pd_idx].flags, R5_Overlap);
 	s->syncing = 0;
