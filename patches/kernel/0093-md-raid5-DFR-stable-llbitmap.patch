-			bio_io_error(bi);
-			bi = bi2;
-		}
+		stripe_fail_bio_list(conf, sh, &sh->dev[i], bi);
 
 		/* fail any reads if this device is non-operational and
 		 * the data has not reached the cache yet.
@@ -3897,14 +3902,7 @@ handle_failed_stripe(struct r5conf *conf, struct stripe_head *sh,
 				wake_up_bit(&sh->dev[i].flags, R5_Overlap);
 			if (bi)
 				s->to_read--;
