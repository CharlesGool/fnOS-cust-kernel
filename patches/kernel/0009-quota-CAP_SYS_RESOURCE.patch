 fs/quota/dquot.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/fs/quota/dquot.c b/fs/quota/dquot.c
index c91076c3f..45cb0e816 100644
--- a/fs/quota/dquot.c
+++ b/fs/quota/dquot.c
@@ -1304,13 +1304,13 @@ static void flush_warnings(struct dquot_warn *warn)
 	}
 }
 
+/*
+ * fnOS: CAP_SYS_RESOURCE no longer bypasses quota limits. NAS services
+ * write on behalf of users as root, so the limits must hold for them too.
+ */
 static int ignore_hardlimit(struct dquot *dquot)
 {
-	struct mem_dqinfo *info = &sb_dqopt(dquot->dq_sb)->info[dquot->dq_id.type];
-
-	return capable(CAP_SYS_RESOURCE) &&
-	       (info->dqi_format->qf_fmt_id != QFMT_VFS_OLD ||
-		!(info->dqi_flags & DQF_ROOT_SQUASH));
+	return 0;
 }
 
 static int dquot_add_inodes(struct dquot *dquot, qsize_t inodes,
