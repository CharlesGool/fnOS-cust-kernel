@@ -5209,6 +5272,14 @@ int bond_update_slave_arr(struct bonding *bond, struct slave *skipslave)
 	}
 	rcu_read_unlock();
 
+	/* New set of slaves: restart the smooth weighted round robin */
+	if (bond->params.ad_packet_wrr) {
+		spin_lock_bh(&bond->ad_wrr_lock);
+		for (i = 0; i < usable_slaves->count; i++)
+			usable_slaves->arr[i]->ad_wrr_current = 0;
+		spin_unlock_bh(&bond->ad_wrr_lock);
+	}
+
 	bond_set_slave_arr(bond, usable_slaves, all_slaves);
 	return ret;
