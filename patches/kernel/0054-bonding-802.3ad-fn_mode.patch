+/* fnOS 802.3ad extensions: weight of a slave is its link speed in Mb/s */
+static u64 bond_ad_slave_weight(const struct slave *slave)
+{
+	u32 speed = slave->speed;
+
+	if (speed == 0 || speed == SPEED_UNKNOWN)
+		return SPEED_1000;
+	return speed;
+}
+
+/* Smooth weighted round robin over the usable slaves (per packet). */
+static struct slave *bond_ad_wrr_slave_get(struct bonding *bond,
+					   struct bond_up_slave *slaves)
+{
+	unsigned int count = slaves->count, i;
+	struct slave *best = NULL;
+	s64 total = 0;
+
+	spin_lock_bh(&bond->ad_wrr_lock);
+	for (i = 0; i < count; i++) {
+		struct slave *slave = slaves->arr[i];
+		s64 weight = bond_ad_slave_weight(slave);
+
+		total += weight;
+		slave->ad_wrr_current += weight;
+		if (!best || slave->ad_wrr_current > best->ad_wrr_current)
+			best = slave;
+	}
+	if (best)
+		best->ad_wrr_current -= total;
+	spin_unlock_bh(&bond->ad_wrr_lock);
+
+	return best;
+}
+
+/* Map the flow hash onto the slaves in proportion to their speeds. */
+static struct slave *bond_ad_speed_weighted_slave_get(struct bond_up_slave *slaves,
+						      u32 hash)
+{
+	unsigned int count = slaves->count, i;
+	u64 total = 0, point;
+
+	for (i = 0; i < count; i++)
+		total += bond_ad_slave_weight(slaves->arr[i]);
+
+	if (total) {
+		point = (u64)hash % total;
+		for (i = 0; i < count; i++) {
+			u64 weight = bond_ad_slave_weight(slaves->arr[i]);
+
+			if (point < weight)
+				return slaves->arr[i];
+			point -= weight;
+		}
+	}
+
+	return slaves->arr[hash % count];
+}
+
 /* Build the usable slaves array in control path for modes that use xmit-hash
  * to determine the slave interface -
  * (a) BOND_MODE_8023AD
@@ -5159,6 +5221,7 @@ int bond_update_slave_arr(struct bonding *bond, struct slave *skipslave)
