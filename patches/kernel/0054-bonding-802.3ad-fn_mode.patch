@@ -5237,6 +5308,13 @@ static struct slave *bond_xmit_3ad_xor_slave_get(struct bonding *bond,
 	if (unlikely(!count))
 		return NULL;
 
+	if (BOND_MODE(bond) == BOND_MODE_8023AD) {
+		if (bond->params.ad_packet_wrr)
+			return bond_ad_wrr_slave_get(bond, slaves);
+		if (bond->params.ad_mixed_speed)
+			return bond_ad_speed_weighted_slave_get(slaves, hash);
+	}
