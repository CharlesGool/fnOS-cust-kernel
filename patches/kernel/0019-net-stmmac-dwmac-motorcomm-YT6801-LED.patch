diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-motorcomm.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-motorcomm.c
new file mode 100644
index 000000000..316002197
--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-motorcomm.c
@@ -0,0 +1,767 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DWMAC glue driver for Motorcomm PCI Ethernet controllers
+ *
+ * Copyright (c) 2025-2026 Yao Zi <me@ziyao.cc>
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/dev_printk.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/phy.h>
+#include <linux/slab.h>
+#include <linux/stmmac.h>
+
+#include "dwmac4.h"
+#include "stmmac.h"
+
+#define DRIVER_NAME "dwmac-motorcomm"
+
+#define PCI_VENDOR_ID_MOTORCOMM			0x1f0a
+
+/* Register definition */
+#define EPHY_CTRL				0x1004
+/* Clearing this bit asserts resets for internal MDIO bus and PHY */
+#define  EPHY_MDIO_PHY_RESET			BIT(0)
+#define OOB_WOL_CTRL				0x1010
+#define  OOB_WOL_CTRL_DIS			BIT(0)
+#define MGMT_INT_CTRL0				0x1100
+#define INT_MODERATION				0x1108
+#define  INT_MODERATION_RX			GENMASK(11, 0)
+#define  INT_MODERATION_TX			GENMASK(27, 16)
+#define EFUSE_OP_CTRL_0				0x1500
+#define  EFUSE_OP_MODE				GENMASK(1, 0)
+#define   EFUSE_OP_ROW_READ			0x1
+#define  EFUSE_OP_START				BIT(2)
+#define  EFUSE_OP_ADDR				GENMASK(15, 8)
+#define EFUSE_OP_CTRL_1				0x1504
+#define  EFUSE_OP_DONE				BIT(1)
+#define  EFUSE_OP_RD_DATA			GENMASK(31, 24)
+#define SYS_RESET				0x152c
+#define  SYS_RESET_RESET			BIT(31)
+#define GMAC_OFFSET				0x2000
+
+/* Constants */
+#define EFUSE_READ_TIMEOUT_US			20000
+#define EFUSE_PATCH_REGION_OFFSET		18
+#define EFUSE_PATCH_MAX_NUM			39
+#define EFUSE_ADDR_MACA0LR			0x1520
+#define EFUSE_ADDR_MACA0HR			0x1524
+
+/* LED configuration stored in eFuse */
+#define EFUSE_LED_SOLUTION_OFFSET		0x00
+#define  EFUSE_LED_SOLUTION			GENMASK(4, 0)
+#define  EFUSE_LED_SOLUTION_COMMON		0x1f
+#define EFUSE_LED_AREA0_END			0xff
+#define EFUSE_LED_AREA1_END			0xd1
+#define EFUSE_LED_REGS_PER_STATE		5
+
+/* Internal PHY extended registers */
+#define YTPHY_PAGE_SELECT			0x1e
+#define YTPHY_PAGE_DATA				0x1f
+#define YTPHY_SPECIFIC_FUNC_CTRL		0x10
+#define YTPHY_EXT_REG_57			0x57
+#define YTPHY_LED_GENERAL_CFG			0xa00b
+#define YTPHY_LED0_CFG				0xa00c
+#define YTPHY_LED1_CFG				0xa00d
+#define YTPHY_LED2_CFG				0xa00e
+#define YTPHY_LED_BLINK_CFG			0xa00f
+
+struct motorcomm_efuse_patch {
+	__le16 addr;
+	__le32 data;
+} __packed;
+
+enum motorcomm_led_state {
+	MOTORCOMM_LED_STATE_ACTIVE,
+	MOTORCOMM_LED_STATE_SUSPEND,
+	MOTORCOMM_LED_STATE_REMOVE,
+};
+
+/* LED register sets, in the order they are laid out in eFuse */
+struct motorcomm_led_cfg {
+	u16 disable[EFUSE_LED_REGS_PER_STATE];
+	u16 s5[EFUSE_LED_REGS_PER_STATE];
+	u16 s3[EFUSE_LED_REGS_PER_STATE];
+	u16 s0[EFUSE_LED_REGS_PER_STATE];
+	bool valid;
+};
+
+struct dwmac_motorcomm_priv {
+	void __iomem *base;
+	u16 ephy_ext57;
+	u8 led_solution;
+	struct motorcomm_led_cfg led;
+};
+
+static const u16 motorcomm_led_regs_blank[EFUSE_LED_REGS_PER_STATE];
+
+static int motorcomm_efuse_read_byte(struct dwmac_motorcomm_priv *priv,
+				     u8 offset, u8 *byte)
+{
+	u32 reg;
+	int ret;
+
+	writel(FIELD_PREP(EFUSE_OP_MODE, EFUSE_OP_ROW_READ)	|
+	       FIELD_PREP(EFUSE_OP_ADDR, offset)		|
+	       EFUSE_OP_START, priv->base + EFUSE_OP_CTRL_0);
+
+	ret = readl_poll_timeout(priv->base + EFUSE_OP_CTRL_1,
+				 reg, reg & EFUSE_OP_DONE, 2000,
+				 EFUSE_READ_TIMEOUT_US);
+
+	*byte = FIELD_GET(EFUSE_OP_RD_DATA, reg);
+
+	return ret;
+}
+
+static int motorcomm_efuse_read_patch(struct dwmac_motorcomm_priv *priv,
+				      u8 index,
+				      struct motorcomm_efuse_patch *patch)
+{
+	u8 *p = (u8 *)patch, offset;
+	int i, ret;
+
+	for (i = 0; i < sizeof(*patch); i++) {
+		offset = EFUSE_PATCH_REGION_OFFSET + sizeof(*patch) * index + i;
+
+		ret = motorcomm_efuse_read_byte(priv, offset, &p[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int motorcomm_efuse_get_patch_value(struct dwmac_motorcomm_priv *priv,
+					   u16 addr, u32 *value)
+{
+	struct motorcomm_efuse_patch patch;
+	int i, ret;
+
+	for (i = 0; i < EFUSE_PATCH_MAX_NUM; i++) {
+		ret = motorcomm_efuse_read_patch(priv, i, &patch);
+		if (ret)
+			return ret;
+
+		if (patch.addr == 0) {
+			return -ENOENT;
+		} else if (le16_to_cpu(patch.addr) == addr) {
+			*value = le32_to_cpu(patch.data);
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static int motorcomm_efuse_read_mac(struct device *dev,
+				    struct dwmac_motorcomm_priv *priv, u8 *mac)
+{
+	u32 maca0lr, maca0hr;
+	int ret;
+
+	ret = motorcomm_efuse_get_patch_value(priv, EFUSE_ADDR_MACA0LR,
+					      &maca0lr);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read maca0lr from eFuse\n");
+
+	ret = motorcomm_efuse_get_patch_value(priv, EFUSE_ADDR_MACA0HR,
+					      &maca0hr);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to read maca0hr from eFuse\n");
+
+	mac[0] = FIELD_GET(GENMASK(15, 8), maca0hr);
+	mac[1] = FIELD_GET(GENMASK(7, 0), maca0hr);
+	mac[2] = FIELD_GET(GENMASK(31, 24), maca0lr);
+	mac[3] = FIELD_GET(GENMASK(23, 16), maca0lr);
+	mac[4] = FIELD_GET(GENMASK(15, 8), maca0lr);
+	mac[5] = FIELD_GET(GENMASK(7, 0), maca0lr);
+
+	return 0;
+}
+
+static int motorcomm_efuse_read_be16(struct dwmac_motorcomm_priv *priv,
+				     u8 offset, u16 *val)
+{
+	u8 hi = 0, lo = 0;
+	int ret;
+
+	ret = motorcomm_efuse_read_byte(priv, offset, &hi);
+	if (ret)
+		return ret;
+
+	ret = motorcomm_efuse_read_byte(priv, offset - 1, &lo);
+	if (ret)
+		return ret;
+
+	*val = hi << 8 | lo;
+
+	return 0;
+}
+
+/*
+ * An LED area holds four register sets, each made of
+ * EFUSE_LED_REGS_PER_STATE big-endian 16-bit values, stored downwards from
+ * the end of the area.
+ */
+static int motorcomm_efuse_read_led_area(struct dwmac_motorcomm_priv *priv,
+					 u8 end, struct motorcomm_led_cfg *cfg)
+{
+	u16 *sets[] = { cfg->disable, cfg->s5, cfg->s3, cfg->s0 };
+	int i, j, ret;
+	u8 offset;
+
+	memset(cfg, 0, sizeof(*cfg));
+
+	for (i = 0; i < ARRAY_SIZE(sets); i++) {
+		offset = end;
+
+		for (j = EFUSE_LED_REGS_PER_STATE - 1; j >= 0; j--) {
+			ret = motorcomm_efuse_read_be16(priv, offset, &sets[i][j]);
+			if (ret)
+				return ret;
+
+			offset -= 2;
+		}
+
+		end -= EFUSE_LED_REGS_PER_STATE * 2;
+	}
+
+	return 0;
+}
+
+static bool motorcomm_led_cfg_is_blank(const struct motorcomm_led_cfg *cfg)
+{
+	return !memcmp(cfg->disable, motorcomm_led_regs_blank,
+		       sizeof(motorcomm_led_regs_blank)) &&
+	       !memcmp(cfg->s5, motorcomm_led_regs_blank,
+		       sizeof(motorcomm_led_regs_blank)) &&
+	       !memcmp(cfg->s3, motorcomm_led_regs_blank,
+		       sizeof(motorcomm_led_regs_blank)) &&
+	       !memcmp(cfg->s0, motorcomm_led_regs_blank,
+		       sizeof(motorcomm_led_regs_blank));
+}
+
+static int motorcomm_efuse_load_led_cfg(struct dwmac_motorcomm_priv *priv)
+{
+	struct motorcomm_led_cfg area0 = {}, area1 = {};
+	bool blank0, blank1;
+	u8 solution = 0;
+	int ret;
+
+	ret = motorcomm_efuse_read_byte(priv, EFUSE_LED_SOLUTION_OFFSET,
+					&solution);
+	if (ret)
+		return ret;
+
+	priv->led_solution = FIELD_GET(EFUSE_LED_SOLUTION, solution);
+	if (priv->led_solution != EFUSE_LED_SOLUTION_COMMON)
+		return 0;
+
+	ret = motorcomm_efuse_read_led_area(priv, EFUSE_LED_AREA0_END, &area0);
+	if (ret)
+		return ret;
+
+	ret = motorcomm_efuse_read_led_area(priv, EFUSE_LED_AREA1_END, &area1);
+	if (ret)
+		return ret;
+
+	blank0 = motorcomm_led_cfg_is_blank(&area0);
+	blank1 = motorcomm_led_cfg_is_blank(&area1);
+
+	/* The second area, once programmed, overrides the first one */
+	if (!blank0 && blank1) {
+		priv->led = area0;
+		priv->led.valid = true;
+	} else if (!blank0 && !blank1) {
+		priv->led = area1;
+		priv->led.valid = true;
+	}
+
+	return 0;
+}
+
+static int motorcomm_phy_write_ext(struct phy_device *phydev, u16 reg, u16 val)
+{
+	int ret;
+
+	ret = __phy_write(phydev, YTPHY_PAGE_SELECT, reg);
+	if (ret < 0)
+		return ret;
+
+	return __phy_write(phydev, YTPHY_PAGE_DATA, val);
+}
+
+static int motorcomm_phy_apply_common_led_locked(struct phy_device *phydev,
+						 const u16 *regs)
+{
+	int ret;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED_GENERAL_CFG, regs[0]);
+	if (ret < 0)
+		return ret;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED0_CFG, regs[1]);
+	if (ret < 0)
+		return ret;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED1_CFG, regs[2]);
+	if (ret < 0)
+		return ret;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED2_CFG, regs[3]);
+	if (ret < 0)
+		return ret;
+
+	return motorcomm_phy_write_ext(phydev, YTPHY_LED_BLINK_CFG, regs[4]);
+}
+
+static int motorcomm_phy_init_locked(struct phy_device *phydev,
+				     struct dwmac_motorcomm_priv *priv)
+{
+	int ret;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_EXT_REG_57,
+				      priv->ephy_ext57);
+	if (ret < 0)
+		return ret;
+
+	return __phy_modify(phydev, YTPHY_SPECIFIC_FUNC_CTRL, 0, BIT(3));
+}
+
+static int motorcomm_apply_led_state(struct net_device *ndev,
+				     enum motorcomm_led_state state)
+{
+	struct dwmac_motorcomm_priv *priv;
+	struct phy_device *phydev;
+	struct stmmac_priv *spriv;
+	u16 led0, led1, led2;
+	int ret;
+
+	if (!ndev)
+		return 0;
+
+	spriv = netdev_priv(ndev);
+	if (!spriv->mii || !spriv->plat)
+		return 0;
+
+	priv = spriv->plat->bsp_priv;
+	if (!priv)
+		return 0;
+
+	phydev = phy_find_first(spriv->mii);
+	if (!phydev)
+		return 0;
+
+	phy_lock_mdio_bus(phydev);
+
+	if (state == MOTORCOMM_LED_STATE_ACTIVE) {
+		ret = motorcomm_phy_init_locked(phydev, priv);
+		if (ret < 0)
+			goto out;
+	}
+
+	if (priv->led_solution == EFUSE_LED_SOLUTION_COMMON) {
+		if (!priv->led.valid)
+			goto out;
+
+		switch (state) {
+		case MOTORCOMM_LED_STATE_SUSPEND:
+			ret = motorcomm_phy_apply_common_led_locked(phydev,
+					priv->led.s3);
+			break;
+		case MOTORCOMM_LED_STATE_REMOVE:
+			ret = motorcomm_phy_apply_common_led_locked(phydev,
+					priv->led.s5);
+			break;
+		default:
+			ret = motorcomm_phy_apply_common_led_locked(phydev,
+					priv->led.s0);
+			break;
+		}
+		goto out;
+	}
+
+	/* Preset solutions: only keep LED0 on solution 3 when inactive */
+	if (state == MOTORCOMM_LED_STATE_SUSPEND ||
+	    state == MOTORCOMM_LED_STATE_REMOVE) {
+		ret = motorcomm_phy_write_ext(phydev, YTPHY_LED0_CFG,
+					      priv->led_solution == 3 ? 0x2600 : 0);
+		if (ret < 0)
+			goto out;
+
+		ret = motorcomm_phy_write_ext(phydev, YTPHY_LED1_CFG, 0);
+		if (ret < 0)
+			goto out;
+
+		ret = motorcomm_phy_write_ext(phydev, YTPHY_LED2_CFG, 0);
+		goto out;
+	}
+
+	switch (priv->led_solution) {
+	case 1:
+		led0 = 0;
+		led1 = 0;
+		led2 = 0;
+		break;
+	case 2:
+		led0 = 0x0020;
+		led1 = 0x0040;
+		led2 = 0x0007;
+		break;
+	case 3:
+		led0 = 0x2600;
+		led1 = 0x0040;
+		led2 = 0x0020;
+		break;
+	case 4:
+		led0 = 0x2600;
+		led1 = 0;
+		led2 = 0x1800;
+		break;
+	default:
+		led0 = 0x2600;
+		led1 = 0x1800;
+		led2 = 0;
+		break;
+	}
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED0_CFG, led0);
+	if (ret < 0)
+		goto out;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED1_CFG, led1);
+	if (ret < 0)
+		goto out;
+
+	ret = motorcomm_phy_write_ext(phydev, YTPHY_LED2_CFG, led2);
+	if (ret < 0)
+		goto out;
+
+	if (priv->led_solution == 2)
+		ret = motorcomm_phy_write_ext(phydev, YTPHY_LED_BLINK_CFG, 0xf);
+
+out:
+	phy_unlock_mdio_bus(phydev);
+
+	return ret;
+}
+
+static void motorcomm_deassert_mdio_phy_reset(struct dwmac_motorcomm_priv *priv)
+{
+	u32 reg = readl(priv->base + EPHY_CTRL);
+
+	reg |= EPHY_MDIO_PHY_RESET;
+
+	writel(reg, priv->base + EPHY_CTRL);
+}
+
+static void motorcomm_reset(struct dwmac_motorcomm_priv *priv)
+{
+	u32 reg = readl(priv->base + SYS_RESET);
+
+	reg &= ~SYS_RESET_RESET;
+	writel(reg, priv->base + SYS_RESET);
+
+	reg |= SYS_RESET_RESET;
+	writel(reg, priv->base + SYS_RESET);
+
+	motorcomm_deassert_mdio_phy_reset(priv);
+}
+
+static void motorcomm_init(struct dwmac_motorcomm_priv *priv)
+{
+	writel(0x0, priv->base + MGMT_INT_CTRL0);
+
+	writel(FIELD_PREP(INT_MODERATION_RX, 200) |
+	       FIELD_PREP(INT_MODERATION_TX, 200),
+	       priv->base + INT_MODERATION);
+
+	/*
+	 * OOB WOL must be disabled during normal operation, or DMA interrupts
+	 * cannot be delivered to the host.
+	 */
+	writel(OOB_WOL_CTRL_DIS, priv->base + OOB_WOL_CTRL);
+}
+
+static int motorcomm_suspend(struct device *dev, void *bsp_priv)
+{
+	struct pci_dev *pdev = to_pci_dev(dev);
+	int ret;
+
+	motorcomm_apply_led_state(dev_get_drvdata(dev),
+				  MOTORCOMM_LED_STATE_SUSPEND);
+
+	ret = pci_save_state(pdev);
+	if (ret)
+		return ret;
+
+	pci_disable_device(pdev);
+	pci_wake_from_d3(pdev, true);
+	return 0;
+}
+
+static int motorcomm_resume(struct device *dev, void *bsp_priv)
+{
+	struct dwmac_motorcomm_priv *priv = bsp_priv;
+	struct net_device *ndev = dev_get_drvdata(dev);
+	struct pci_dev *pdev = to_pci_dev(dev);
+	int ret;
+
+	pci_restore_state(pdev);
+	pci_set_power_state(pdev, PCI_D0);
+
+	ret = pci_enable_device(pdev);
+	if (ret)
+		return ret;
+
+	pci_set_master(pdev);
+
+	/*
+	 * When recovering from D3hot, EPHY_MDIO_PHY_RESET is automatically
+	 * asserted, and must be deasserted for normal operation.
+	 */
+	motorcomm_deassert_mdio_phy_reset(priv);
+	motorcomm_init(priv);
+
+	motorcomm_apply_led_state(ndev, MOTORCOMM_LED_STATE_ACTIVE);
+
+	return 0;
+}
+
+static int motorcomm_mac_finish(struct net_device *ndev, void *bsp_priv,
+				unsigned int mode, phy_interface_t interface)
+{
+	motorcomm_apply_led_state(ndev, MOTORCOMM_LED_STATE_ACTIVE);
+
+	return 0;
+}
+
+static struct plat_stmmacenet_data *
+motorcomm_default_plat_data(struct pci_dev *pdev)
+{
+	struct plat_stmmacenet_data *plat;
+	struct device *dev = &pdev->dev;
+
+	plat = devm_kzalloc(dev, sizeof(*plat), GFP_KERNEL);
+	if (!plat)
+		return NULL;
+
+	plat->mdio_bus_data = devm_kzalloc(dev, sizeof(*plat->mdio_bus_data),
+					   GFP_KERNEL);
+	if (!plat->mdio_bus_data)
+		return NULL;
+
+	plat->dma_cfg = devm_kzalloc(dev, sizeof(*plat->dma_cfg), GFP_KERNEL);
+	if (!plat->dma_cfg)
+		return NULL;
+
+	plat->axi = devm_kzalloc(dev, sizeof(*plat->axi), GFP_KERNEL);
+	if (!plat->axi)
+		return NULL;
+
+	plat->dma_cfg->pbl		= DEFAULT_DMA_PBL;
+	plat->dma_cfg->pblx8		= true;
+	plat->dma_cfg->txpbl		= 32;
+	plat->dma_cfg->rxpbl		= 32;
+	plat->dma_cfg->eame		= true;
+	plat->dma_cfg->mixed_burst	= true;
+
+	plat->axi->axi_wr_osr_lmt	= 1;
+	plat->axi->axi_rd_osr_lmt	= 1;
+	plat->axi->axi_mb		= true;
+	plat->axi->axi_blen[0]		= 4;
+	plat->axi->axi_blen[1]		= 8;
+	plat->axi->axi_blen[2]		= 16;
+	plat->axi->axi_blen[3]		= 32;
+
+	plat->bus_id		= pci_dev_id(pdev);
+	plat->phy_addr		= -1;
+	plat->phy_interface	= PHY_INTERFACE_MODE_GMII;
+	/*
+	 * YT6801 requires an 25MHz clock input/oscillator to function, which
+	 * is likely the source of CSR clock.
+	 */
+	plat->clk_csr		= STMMAC_CSR_20_35M;
+	plat->tx_coe		= 1;
+	plat->rx_coe		= 1;
+	plat->maxmtu		= JUMBO_LEN;
+	plat->rx_queues_to_use	= 1;
+	plat->tx_queues_to_use	= 1;
+	plat->clk_ref_rate	= 125000000;
+	plat->core_type		= DWMAC_CORE_GMAC4;
+	plat->mac_finish	= motorcomm_mac_finish;
+	plat->suspend		= motorcomm_suspend;
+	plat->resume		= motorcomm_resume;
+	plat->flags		= STMMAC_FLAG_TSO_EN |
+				  STMMAC_FLAG_EN_TX_LPI_CLK_PHY_CAP;
+
+	return plat;
+}
+
+static void motorcomm_free_irq(void *data)
+{
+	struct pci_dev *pdev = data;
+
+	pci_free_irq_vectors(pdev);
+}
+
+static int motorcomm_setup_irq(struct pci_dev *pdev,
+			       struct stmmac_resources *res,
+			       struct plat_stmmacenet_data *plat)
+{
+	int ret;
+
+	ret = pci_alloc_irq_vectors(pdev, 6, 6, PCI_IRQ_MSIX);
+	if (ret > 0) {
+		res->rx_irq[0]	= pci_irq_vector(pdev, 0);
+		res->tx_irq[0]	= pci_irq_vector(pdev, 4);
+		res->irq	= pci_irq_vector(pdev, 5);
+
+		plat->flags |= STMMAC_FLAG_MULTI_MSI_EN;
+	} else {
+		dev_info(&pdev->dev, "failed to allocate MSI-X vector: %d\n",
+			 ret);
+		dev_info(&pdev->dev, "try MSI instead\n");
+
+		ret = pci_alloc_irq_vectors(pdev, 1, 1, PCI_IRQ_MSI);
+		if (ret < 0)
+			return dev_err_probe(&pdev->dev, ret,
+					     "failed to allocate MSI\n");
+
+		res->irq = pci_irq_vector(pdev, 0);
+	}
+
+	return devm_add_action_or_reset(&pdev->dev, motorcomm_free_irq, pdev);
+}
+
+static u16 motorcomm_ephy_ext57_value(struct pci_dev *pdev)
+{
+	if ((pdev->subsystem_vendor == 0x1d05 &&
+	     pdev->subsystem_device == 0x137d) ||
+	    (pdev->subsystem_vendor == 0x2066 &&
+	     pdev->subsystem_device == 0x9806))
+		return 0x264c;
+
+	return 0x274c;
+}
+
+static int motorcomm_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct plat_stmmacenet_data *plat;
+	struct dwmac_motorcomm_priv *priv;
+	struct stmmac_resources res = {};
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->ephy_ext57 = motorcomm_ephy_ext57_value(pdev);
+
+	plat = motorcomm_default_plat_data(pdev);
+	if (!plat)
+		return -ENOMEM;
+
+	plat->bsp_priv = priv;
+
+	ret = pcim_enable_device(pdev);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to enable device\n");
+
+	priv->base = pcim_iomap_region(pdev, 0, DRIVER_NAME);
+	if (IS_ERR(priv->base))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->base),
+				     "failed to map IO region\n");
+
+	pci_set_master(pdev);
+
+	/*
+	 * Some PCIe addons cards based on YT6801 don't deliver MSI(X) with ASPM
+	 * enabled. Sadly there isn't a reliable way to read out OEM of the
+	 * card, so let's disable L1 state unconditionally for safety.
+	 */
+	ret = pci_disable_link_state(pdev, PCIE_LINK_STATE_L1);
+	if (ret)
+		dev_warn(&pdev->dev, "failed to disable L1 state: %d\n", ret);
+
+	motorcomm_reset(priv);
+
+	/*
+	 * After system reset, the eFuse controller needs time to load
+	 * its internal data. Without this delay, eFuse reads return
+	 * all zeros, causing MAC address detection to fail.
+	 */
+	usleep_range(2000, 5000);
+
+	ret = motorcomm_efuse_load_led_cfg(priv);
+	if (ret)
+		dev_warn(&pdev->dev, "failed to load LED config from eFuse: %d\n",
+			 ret);
+
+	ret = motorcomm_efuse_read_mac(&pdev->dev, priv, res.mac);
+	if (ret == -ENOENT) {
+		dev_warn(&pdev->dev, "eFuse contains no valid MAC address\n");
+		dev_warn(&pdev->dev, "fallback to random MAC address\n");
+
+		eth_random_addr(res.mac);
+	} else if (ret) {
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to read MAC address from eFuse\n");
+	}
+
+	ret = motorcomm_setup_irq(pdev, &res, plat);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to setup IRQ\n");
+
+	motorcomm_init(priv);
+
+	res.addr = priv->base + GMAC_OFFSET;
+
+	ret = stmmac_dvr_probe(&pdev->dev, plat, &res);
+	if (ret)
+		return ret;
+
+	motorcomm_apply_led_state(dev_get_drvdata(&pdev->dev),
+				  MOTORCOMM_LED_STATE_ACTIVE);
+
+	return 0;
+}
+
+static void motorcomm_remove(struct pci_dev *pdev)
+{
+	motorcomm_apply_led_state(dev_get_drvdata(&pdev->dev),
+				  MOTORCOMM_LED_STATE_REMOVE);
+
+	stmmac_dvr_remove(&pdev->dev);
+}
+
+static const struct pci_device_id dwmac_motorcomm_pci_id_table[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_MOTORCOMM, 0x6801) },
+	{ },
+};
+MODULE_DEVICE_TABLE(pci, dwmac_motorcomm_pci_id_table);
+
+static struct pci_driver dwmac_motorcomm_pci_driver = {
+	.name = DRIVER_NAME,
+	.id_table = dwmac_motorcomm_pci_id_table,
+	.probe = motorcomm_probe,
+	.remove = motorcomm_remove,
+	.driver = {
+		.pm = &stmmac_simple_pm_ops,
+	},
+};
+
+module_pci_driver(dwmac_motorcomm_pci_driver);
+
+MODULE_DESCRIPTION("DWMAC glue driver for Motorcomm PCI Ethernet controllers");
+MODULE_AUTHOR("Yao Zi <me@ziyao.cc>");
