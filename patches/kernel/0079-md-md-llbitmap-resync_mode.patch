+	       atomic_read(&llbitmap->state_count[BitNeedSyncUnwritten]);
+	/* the chunk that is syncing */
+	if (atomic_read(&llbitmap->state_count[BitSyncing]) +
+	    atomic_read(&llbitmap->state_count[BitSyncingUnwritten]))
+		bits++;
+	if (test_bit(MD_RECOVERY_RECOVER, &mddev->recovery))
+		bits += atomic_read(&llbitmap->state_count[BitClean]);
+
+	return bits << llbitmap->chunkshift;
+}
+
+/*
+ * For raid456 in LLBITMAP_RESYNC_MODE_RECOVERY, return the disk to rebuild
+ * by recovery for the chunk that need sync, otherwise return -1.
+ */
+int md_llbitmap_sync_target(struct mddev *mddev, sector_t offset)
+{
+	int target = mddev->raid_disks - 1;
+	struct llbitmap *llbitmap = mddev->bitmap;
+	enum llbitmap_state c;
+
+	if (!mddev->bitmap_ops || !llbitmap ||
+	    !mddev->bitmap_ops->enabled(llbitmap, false) ||
+	    mddev->bitmap_ops->head.id != ID_LLBITMAP)
+		return -1;
+
+	if (!raid_is_456(mddev) || mddev->degraded ||
+	    llbitmap->resync_mode != LLBITMAP_RESYNC_MODE_RECOVERY ||
+	    target < 0)
+		return -1;
+
+	c = llbitmap_read(llbitmap, offset >> llbitmap->chunkshift);
+	if (c != BitNeedSync && c != BitSyncing)
+		return -1;
+
+	return target;
+}
