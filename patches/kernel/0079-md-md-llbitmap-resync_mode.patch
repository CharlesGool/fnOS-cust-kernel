+/*
+ * Change one bit to @new and account it in llbitmap->state_count[], bits are
+ * updated locklessly, only the one who succeed to change the bit updates the
+ * counters.
+ */
+static void llbitmap_set_state(struct llbitmap *llbitmap, char *p,
+			       enum llbitmap_state new)
+{
+	u8 old = READ_ONCE(*p);
+
+	if (old == new || cmpxchg(p, old, new) != old)
+		return;
+
+	atomic_inc(&llbitmap->state_count[new]);
+	if (old < BitStateCount)
+		atomic_dec(&llbitmap->state_count[old]);
+}
