+/* check if all the bits that the range is mapped to are BitUnwritten */
+static bool llbitmap_range_unwritten(struct llbitmap *llbitmap, sector_t start,
+				     sector_t end, bool previous)
+{
+	unsigned long chunksize = previous ? llbitmap->chunksize :
+					     llbitmap->reshape_chunksize;
+	sector_t offset = start;
+	unsigned long sectors;
+	unsigned long bit;
+	unsigned long last;
+
+	if (start >= end)
+		return true;
+
+	sectors = end - start;
+	llbitmap_map_layout(llbitmap, &offset, &sectors, previous);
+	if (!sectors)
+		return true;
+
+	last = div64_u64(offset + sectors - 1, chunksize);
+	if (last >= llbitmap->chunks)
+		return false;
+
+	for (bit = div64_u64(offset, chunksize); bit <= last; bit++)
+		if (llbitmap_read(llbitmap, bit) != BitUnwritten)
+			return false;
+
+	return true;
+}
