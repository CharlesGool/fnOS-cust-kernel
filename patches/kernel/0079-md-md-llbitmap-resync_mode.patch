+static void llbitmap_count_bits(struct llbitmap *llbitmap)
+{
+	unsigned long i;
+
+	for (i = 0; i < BitStateCount; i++)
+		atomic_set(&llbitmap->state_count[i], 0);
+
+	for (i = 0; i < llbitmap->chunks; i++) {
+		u8 state = llbitmap_read(llbitmap, i);
+
+		if (state < BitStateCount)
+			atomic_inc(&llbitmap->state_count[state]);
+	}
+}
