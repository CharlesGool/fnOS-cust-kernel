Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/md/md.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/md/md.c b/drivers/md/md.c
index 65444eaf3..8c2e23e90 100644
--- a/drivers/md/md.c
+++ b/drivers/md/md.c
@@ -2475,6 +2475,13 @@ static int super_1_validate(struct mddev *mddev, struct md_rdev *freshest, struc
 		mddev->reshape_backwards = 0;
 
 		mddev->resync_offset = le64_to_cpu(sb->resync_offset);
+		/* fnnas: the array was converting to llbitmap when it stopped */
+		if (le32_to_cpu(sb->feature_map) & MD_FEATURE_LLBITMAP_CONVERTING) {
+			mddev->resync_offset = 0;
+			mddev->bitmap_id = ID_LLBITMAP;
+			set_bit(MD_ARRAY_FIRST_USE, &mddev->flags);
+			set_bit(MD_LLBITMAP_CONVERTING, &mddev->flags);
+		}
 		memcpy(mddev->uuid, sb->set_uuid, 16);
 
 		mddev->max_disks =  (4096-256)/2;
@@ -2694,6 +2701,10 @@ static void super_1_sync(struct mddev *mddev, struct md_rdev *rdev)
 		sb->feature_map = cpu_to_le32(MD_FEATURE_BITMAP_OFFSET);
 	}
 
+	if (test_bit(MD_LLBITMAP_CONVERTING, &mddev->flags))
+		sb->feature_map |= cpu_to_le32(MD_FEATURE_LLBITMAP_CONVERTING);
+	sb->ext_status = cpu_to_le32(mddev->ext_status);
+
 	if (rdev->raid_disk >= 0 && !test_bit(Journal, &rdev->flags) &&
 	    !test_bit(In_sync, &rdev->flags)) {
 		sb->feature_map |=
@@ -3090,6 +3101,9 @@ static int bind_rdev_to_array(struct md_rdev *rdev, struct mddev *mddev)
 	/* May as well allow recovery to be retried once */
 	mddev->recovery_disabled++;
 
+	if (rdev->ext_status & MD_SB_1_EXT_STATUS_FAST_RESCYNC)
+		mddev->ext_status |= MD_SB_1_EXT_STATUS_FAST_RESCYNC;
+
 	return 0;
 
  fail:
