 		if (IS_ERR(rdev)) {
 			pr_warn("md: md_import_device returned %ld\n",
 				PTR_ERR(rdev));
@@ -8144,9 +8213,9 @@ int md_add_new_disk(struct mddev *mddev, struct mdu_disk_info_s *info)
 		}
