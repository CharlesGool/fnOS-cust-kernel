__super_1_load/__super_90_load 带 silent, 静默时不打印;
坏块表遇到 0 或全 1 结束; 读出超级块 ext_status 到 rdev->ext_status;
md_import_device 加 refdev 参数, 打开和读超级块交给 md_open_candidate。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/md/md.c | 213 ++++++++++++++++++++++++++++++++----------------
 1 file changed, 141 insertions(+), 72 deletions(-)

diff --git a/drivers/md/md.c b/drivers/md/md.c
index 2a9b852de..e8ed4fd54 100644
--- a/drivers/md/md.c
+++ b/drivers/md/md.c
@@ -1772,7 +1772,8 @@ EXPORT_SYMBOL(md_check_no_bitmap);
 /*
  * load_super for 0.90.0
  */
-static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_version)
+static int __super_90_load(struct md_rdev *rdev, struct md_rdev *refdev,
+			   bool silent)
 {
 	mdp_super_t *sb;
 	int ret;
@@ -1795,16 +1796,18 @@ static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor
 	sb = page_address(rdev->sb_page);
 
 	if (sb->md_magic != MD_SB_MAGIC) {
-		pr_warn("md: invalid raid superblock magic on %pg\n",
-			rdev->bdev);
+		if (!silent)
+			pr_warn("md: invalid raid superblock magic on %pg\n",
+				rdev->bdev);
 		goto abort;
 	}
 
 	if (sb->major_version != 0 ||
 	    sb->minor_version < 90 ||
 	    sb->minor_version > 91) {
-		pr_warn("Bad version number %d.%d on %pg\n",
-			sb->major_version, sb->minor_version, rdev->bdev);
+		if (!silent)
+			pr_warn("Bad version number %d.%d on %pg\n",
+				sb->major_version, sb->minor_version, rdev->bdev);
 		goto abort;
 	}
 
@@ -1812,7 +1815,8 @@ static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor
 		goto abort;
 
 	if (md_csum_fold(calc_sb_csum(sb)) != md_csum_fold(sb->sb_csum)) {
-		pr_warn("md: invalid superblock checksum on %pg\n", rdev->bdev);
+		if (!silent)
+			pr_warn("md: invalid superblock checksum on %pg\n", rdev->bdev);
 		goto abort;
 	}
 
@@ -1838,13 +1842,15 @@ static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor
 		__u64 ev1, ev2;
 		mdp_super_t *refsb = page_address(refdev->sb_page);
 		if (!md_uuid_equal(refsb, sb)) {
-			pr_warn("md: %pg has different UUID to %pg\n",
-				rdev->bdev, refdev->bdev);
+			if (!silent)
+				pr_warn("md: %pg has different UUID to %pg\n",
+					rdev->bdev, refdev->bdev);
 			goto abort;
 		}
 		if (!md_sb_equal(refsb, sb)) {
-			pr_warn("md: %pg has same UUID but different superblock to %pg\n",
-				rdev->bdev, refdev->bdev);
+			if (!silent)
+				pr_warn("md: %pg has same UUID but different superblock to %pg\n",
+					rdev->bdev, refdev->bdev);
 			goto abort;
 		}
 		ev1 = md_event(sb);
@@ -1871,6 +1877,11 @@ static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor
 	return ret;
 }
 
+static int super_90_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_version)
+{
+	return __super_90_load(rdev, refdev, false);
+}
+
 static u64 md_bitmap_events_cleared(struct mddev *mddev)
 {
 	struct md_bitmap_stats stats;
@@ -2215,7 +2226,8 @@ static __le32 calc_sb_1_csum(struct mdp_superblock_1 *sb)
 	return cpu_to_le32(csum);
 }
 
-static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_version)
+static int __super_1_load(struct md_rdev *rdev, struct md_rdev *refdev,
+			  int minor_version, bool silent)
 {
 	struct mdp_superblock_1 *sb;
 	int ret;
@@ -2264,23 +2276,27 @@ static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_
 		return -EINVAL;
 
 	if (calc_sb_1_csum(sb) != sb->sb_csum) {
-		pr_warn("md: invalid superblock checksum on %pg\n",
-			rdev->bdev);
+		if (!silent)
+			pr_warn("md: invalid superblock checksum on %pg\n",
+				rdev->bdev);
 		return -EINVAL;
 	}
 	if (le64_to_cpu(sb->data_size) < 10) {
-		pr_warn("md: data_size too small on %pg\n",
-			rdev->bdev);
+		if (!silent)
+			pr_warn("md: data_size too small on %pg\n",
+				rdev->bdev);
 		return -EINVAL;
 	}
 	if (sb->pad0 ||
 	    sb->pad3[0] ||
 	    memcmp(sb->pad3, sb->pad3+1, sizeof(sb->pad3) - sizeof(sb->pad3[1]))) {
-		pr_warn("Some padding is non-zero on %pg, might be a new feature\n",
-			rdev->bdev);
+		if (!silent)
+			pr_warn("Some padding is non-zero on %pg, might be a new feature\n",
+				rdev->bdev);
 		if (check_new_feature)
 			return -EINVAL;
-		pr_warn("check_new_feature is disabled, data corruption possible\n");
+		if (!silent)
+			pr_warn("check_new_feature is disabled, data corruption possible\n");
 	}
 
 	rdev->preferred_minor = 0xffff;
@@ -2344,7 +2360,7 @@ static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_
 			u64 sector = bb >> 10;
 			sector <<= sb->bblog_shift;
 			count <<= sb->bblog_shift;
-			if (bb + 1 == 0)
+			if (!bb || bb + 1 == 0)
 				break;
 			if (!badblocks_set(&rdev->badblocks, sector, count, 1))
 				return -EINVAL;
@@ -2385,9 +2401,10 @@ static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_
 		    sb->level != refsb->level ||
 		    sb->layout != refsb->layout ||
 		    sb->chunksize != refsb->chunksize) {
-			pr_warn("md: %pg has strangely different superblock to %pg\n",
-				rdev->bdev,
-				refdev->bdev);
+			if (!silent)
+				pr_warn("md: %pg has strangely different superblock to %pg\n",
+					rdev->bdev,
+					refdev->bdev);
 			return -EINVAL;
 		}
 		ev1 = le64_to_cpu(sb->events);
@@ -2405,9 +2422,15 @@ static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_
 	if (sectors < le64_to_cpu(sb->data_size))
 		return -EINVAL;
 	rdev->sectors = le64_to_cpu(sb->data_size);
+	rdev->ext_status = le32_to_cpu(sb->ext_status);
 	return ret;
 }
 
+static int super_1_load(struct md_rdev *rdev, struct md_rdev *refdev, int minor_version)
+{
+	return __super_1_load(rdev, refdev, minor_version, false);
+}
+
 static int super_1_validate(struct mddev *mddev, struct md_rdev *freshest, struct md_rdev *rdev)
 {
 	struct mdp_superblock_1 *sb = page_address(rdev->sb_page);
@@ -2911,6 +2934,11 @@ static struct super_type super_types[] = {
 	},
 };
 
+int validate_rdev_super(struct mddev *mddev, struct md_rdev *rdev)
+{
+	return super_types[mddev->major_version].validate_super(mddev, NULL, rdev);
+}
+
 static void sync_super(struct mddev *mddev, struct md_rdev *rdev)
 {
 	if (mddev->sync_super) {
@@ -4235,6 +4263,81 @@ int md_rdev_init(struct md_rdev *rdev)
 }
 EXPORT_SYMBOL_GPL(md_rdev_init);
 
+int md_open_candidate(struct md_rdev *rdev, dev_t devt, void *holder,
+		      int super_format, int super_minor,
+		      struct md_rdev *refdev, bool silent)
+{
+	struct file *bdev_file;
+	struct block_device *bdev;
+	struct page *page;
+	int err;
+
+	bdev_file = bdev_file_open_by_dev(devt, BLK_OPEN_READ | BLK_OPEN_WRITE,
+					  holder, NULL);
+	if (IS_ERR(bdev_file)) {
+		if (!silent)
+			pr_warn("md: could not open device unknown-block(%u,%u).\n",
+				MAJOR(devt), MINOR(devt));
+		return PTR_ERR(bdev_file);
+	}
+	bdev = file_bdev(bdev_file);
+
+	if (!(bdev_nr_bytes(bdev) >> BLOCK_SIZE_BITS)) {
+		if (!silent)
+			pr_warn("md: %pg has zero or unknown size, marking faulty!\n",
+				bdev);
+		err = -EINVAL;
+		goto out_fput;
+	}
+
+	page = alloc_page(GFP_KERNEL);
+	if (!page) {
+		err = -ENOMEM;
+		goto out_fput;
+	}
+	rdev->bdev_file = bdev_file;
+	rdev->bdev = bdev;
+	rdev->sb_page = page;
+
+	if (super_format < 0)
+		return 0;
+
+	if (super_format == 0)
+		err = __super_90_load(rdev, refdev, silent);
+	else if (super_format == 1)
+		err = __super_1_load(rdev, refdev, super_minor, silent);
+	else
+		err = -EINVAL;
+
+	if (err == -EINVAL) {
+		if (!silent) {
+			if (refdev)
+				pr_warn("md: %pg is not compatible with array member %pg, not importing!\n",
+					rdev->bdev, refdev->bdev);
+			else
+				pr_warn("md: %pg does not have a valid v%d.%d superblock, not importing!\n",
+					rdev->bdev, super_format, super_minor);
+		}
+		goto out_clear;
+	}
+	if (err < 0) {
+		if (!silent)
+			pr_warn("md: could not read %pg's sb, not importing!\n",
+				rdev->bdev);
+		goto out_clear;
+	}
+	return 0;
+
+out_clear:
+	rdev->sb_page = NULL;
+	rdev->bdev = NULL;
+	rdev->bdev_file = NULL;
+	put_page(page);
+out_fput:
+	fput(bdev_file);
+	return err;
+}
+
 /*
  * Import a device. If 'super_format' >= 0, then sanity check the superblock
  *
@@ -4245,10 +4348,10 @@ EXPORT_SYMBOL_GPL(md_rdev_init);
  *
  * a faulty rdev _never_ has rdev->sb set.
  */
-static struct md_rdev *md_import_device(dev_t newdev, int super_format, int super_minor)
+static struct md_rdev *md_import_device(dev_t newdev, int super_format,
