+		rdev = md_import_device(dev, -1, 0, NULL);
 		if (IS_ERR(rdev)) {
 			pr_warn("md: error, md_import_device() returned %ld\n",
 				PTR_ERR(rdev));
@@ -8348,7 +8417,7 @@ static int hot_add_disk(struct mddev *mddev, dev_t dev)
 		return -EINVAL;
 	}
 
