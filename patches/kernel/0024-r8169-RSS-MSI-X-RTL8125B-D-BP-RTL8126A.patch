 					/* Unlimited maximum PCI burst. */
 #define	RX_DMA_BURST			(7 << RXCFG_DMA_SHIFT)
@@ -417,6 +431,7 @@ enum rtl8125_registers {
 	INT_CFG0_8125		= 0x34,
