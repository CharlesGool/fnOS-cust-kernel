 }
 
@@ -4513,6 +4660,11 @@ static void rtl8169_mark_as_last_descriptor_default(struct RxDesc *desc)
 	desc->opts1 |= cpu_to_le32(RingEnd);
 }
 
+static void rtl8169_mark_as_last_descriptor_v3(struct RxDescV3 *descv3)
+{
+	descv3->dword4.opts1 |= cpu_to_le32(RingEnd);
+}
+
 static void rtl8169_mark_as_last_descriptor_rss(struct RxDescRss *descrss)
 {
 	descrss->RxDescOpts.opts1 |= cpu_to_le32(RingEnd);
@@ -4521,6 +4673,9 @@ static void rtl8169_mark_as_last_descriptor_rss(struct RxDescRss *descrss)
 static void rtl8169_mark_as_last_descriptor(struct rtl8169_private *tp, struct RxDesc *desc)
 {
 	switch (tp->InitRxDescType) {
+	case RX_DESC_RING_TYPE_RSS_V3:
+		rtl8169_mark_as_last_descriptor_v3((struct RxDescV3 *)desc);
+		break;
 	case RX_DESC_RING_TYPE_RSS:
 		rtl8169_mark_as_last_descriptor_rss((struct RxDescRss *)desc);
 		break;
@@ -4546,7 +4701,8 @@ static int rtl8169_rx_fill(struct rtl8169_private *tp, struct rtl8169_rx_ring *r
 	}
 
 	/* mark as last descriptor in the ring */
-	rtl8169_mark_as_last_descriptor(tp, &ring->RxDescArray[NUM_RX_DESC - 1]);
+	rtl8169_mark_as_last_descriptor(tp, rtl8169_get_rxdesc(tp, ring->RxDescArray,
+							       NUM_RX_DESC - 1));
 
