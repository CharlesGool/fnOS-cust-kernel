+#define INT_CFG0_MSIX_ENTRY_NUM_MODE	BIT(5)
 	IntrMask_8125		= 0x38,
 	IntrStatus_8125		= 0x3c,
 	IntrMask1_8125		= 0x800,
@@ -440,7 +455,10 @@ enum rtl8125_registers {
 };
 
 enum rtl8127_msix_id {
+	MSIX_ID_V2_LINKCHG	= 21,
 	MSIX_ID_V4_LINKCHG	= 29,
+	MSIX_ID_V5_LINKCHG	= 18,
+	MSIX_ID_V6_LINKCHG	= 29,
 };
 
 enum rtl8127_rss_register_content {
@@ -494,6 +512,11 @@ enum rtl_register_content {
 	RxRUNT_RSS	= (1 << 21),
 	RxCRC_RSS	= (1 << 20),
 
+	RxRWT_V3	= (1 << 18),
+	RxRES_V3	= (1 << 20),
+	RxRUNT_V3	= (1 << 19),
+	RxCRC_V3	= (1 << 17),
+
 	/* ChipCmdBits */
 	StopReq		= 0x80,
 	CmdReset	= 0x10,
@@ -596,6 +619,14 @@ enum rtl_register_content {
 
 	/* magic enable v2 */
 	MagicPacket_v2	= (1 << 16),	/* Wake up when receives a Magic Packet */
+	ISRIMR_V2_ROK_Q0	= (1 << 0),
+	ISRIMR_TOK_Q0		= (1 << 16),
+	ISRIMR_V2_LINKCHG	= (1 << 21),
+	ISRIMR_V4_ROK_Q0	= (1 << 0),
+	ISRIMR_V4_LINKCHG	= (1 << 29),
+	ISRIMR_V5_ROK_Q0	= (1 << 0),
+	ISRIMR_V5_TOK_Q0	= (1 << 16),
+	ISRIMR_V5_LINKCHG	= (1 << 18),
 	ISRIMR_V6_LINKCHG	= (1 << 29),
 	ISRIMR_V6_TOK_Q0	= (1 << 8),
 	ISRIMR_V6_ROK_Q0	= (1 << 0),
@@ -607,6 +638,8 @@ enum rtl_desc_bit {
 	RingEnd		= (1 << 30), /* End of descriptor ring */
 	FirstFrag	= (1 << 29), /* First segment of a packet */
 	LastFrag	= (1 << 28), /* Final segment of a packet */
+	FirstFrag_V3	= (1 << 25), /* First segment of a packet (desc v3) */
+	LastFrag_V3	= (1 << 24), /* Final segment of a packet (desc v3) */
 };
 
 /* Generic case. */
@@ -656,6 +689,11 @@ enum rtl_rx_desc_bit {
 #define RxProtoIP	(PID1 | PID0)
 #define RxProtoMask	RxProtoIP
 
+	RxUDPT_v3	= (1 << 29),
+	RxTCPT_v3	= (1 << 28),
+	RxUDPF_v3	= (1 << 25), /* UDP/IP checksum failed */
+	RxTCPF_v3	= (1 << 24), /* TCP/IP checksum failed */
+
 	RxUDPT_v4	= (1 << 19),
 	RxTCPT_v4	= (1 << 18),
 	RxUDPF_v4	= (1 << 16), /* UDP/IP checksum failed */
@@ -702,6 +740,26 @@ struct RxDescRss {
 	} RxDescOpts;
 };
 
+struct RxDescV3 {
+	struct {
+		__le32 reserved1;
+		__le32 reserved2;
+	} dword1;
+
+	struct {
+		__le32 rss_result;
+		__le16 header_buffer_len;
+		__le16 header_info;
+	} dword2;
+
+	__le64 addr;
+
+	struct {
+		__le32 opts2;
+		__le32 opts1;
+	} dword4;
+};
+
 enum features {
 	RTL_FEATURE_MSI		= (1 << 1),
 	RTL_FEATURE_MSIX	= (1 << 2),
@@ -817,6 +875,7 @@ struct rtl8169_irq {
 enum rx_desc_ring_type {
 	RX_DESC_RING_TYPE_UNKNOWN = 0,
 	RX_DESC_RING_TYPE_DEAFULT,
+	RX_DESC_RING_TYPE_RSS_V3,
 	RX_DESC_RING_TYPE_RSS,
 	RX_DESC_RING_TYPE_MAX
 };
@@ -1685,9 +1744,12 @@ static bool rtl_dash_is_enabled(struct rtl8169_private *tp)
 
 static bool rtl_check_rss_support(struct rtl8169_private *tp)
 {
-	if (tp->mac_version == RTL_GIGA_MAC_VER_80)
+	switch (tp->mac_version) {
+	case RTL_GIGA_MAC_VER_63 ... RTL_GIGA_MAC_VER_80:
 		return true;
-	return false;
+	default:
+		return false;
+	}
 }
 
 static enum rtl_dash_type rtl_get_dash_type(struct rtl8169_private *tp)
@@ -1997,6 +2059,9 @@ static void rtl8169_rx_vlan_tag(struct rtl8169_private *tp,
 	u32 opts2;
 
 	switch (tp->InitRxDescType) {
+	case RX_DESC_RING_TYPE_RSS_V3:
+		opts2 = le32_to_cpu(((struct RxDescV3 *)desc)->dword4.opts2);
+		break;
 	case RX_DESC_RING_TYPE_RSS:
 		opts2 = le32_to_cpu(((struct RxDescRss *)desc)->RxDescOpts.opts2);
 		break;
@@ -2728,7 +2793,9 @@ static void rtl_init_rxcfg(struct rtl8169_private *tp)
 		break;
 	case RTL_GIGA_MAC_VER_63 ... RTL_GIGA_MAC_VER_LAST:
 		RTL_W32(tp, RxConfig, RX_FETCH_DFLT_8125 | RX_DMA_BURST |
-			RX_PAUSE_SLOT_ON);
+			RX_PAUSE_SLOT_ON |
+			(tp->InitRxDescType == RX_DESC_RING_TYPE_RSS_V3 ?
+			 RX_DESC_V3_EN : 0));
 		break;
 	default:
 		RTL_W32(tp, RxConfig, RX128_INT_EN | RX_DMA_BURST);
@@ -2881,6 +2948,38 @@ static void rtl_software_parameter_initialize(struct rtl8169_private *tp)
 	tp->num_tx_rings = 1;
 
 	switch (tp->mac_version) {
+	case RTL_GIGA_MAC_VER_63:
+		tp->min_irq_nvecs = R8125B_MIN_IRQ;
+		tp->max_irq_nvecs = R8125_MAX_IRQ;
+		tp->HwSuppNumTxQueues = 1;
+		tp->HwSuppNumRxQueues = R8125_MAX_RX_QUEUES;
+		tp->HwSuppIndirTblEntries = RTL8127_MAX_INDIRECTION_TABLE_ENTRIES;
+		tp->HwSuppIsrVer = 2;
+		break;
+	case RTL_GIGA_MAC_VER_64:
+		tp->min_irq_nvecs = R8125D_MIN_IRQ;
+		tp->max_irq_nvecs = R8125_MAX_IRQ;
+		tp->HwSuppNumTxQueues = R8125_MAX_TX_QUEUES;
+		tp->HwSuppNumRxQueues = R8125_MAX_RX_QUEUES;
+		tp->HwSuppIndirTblEntries = RTL8127_MAX_INDIRECTION_TABLE_ENTRIES;
+		tp->HwSuppIsrVer = 5;
+		break;
+	case RTL_GIGA_MAC_VER_66:
+		tp->min_irq_nvecs = R8125BP_MIN_IRQ;
+		tp->max_irq_nvecs = R8125_MAX_IRQ;
+		tp->HwSuppNumTxQueues = R8125_MAX_TX_QUEUES;
+		tp->HwSuppNumRxQueues = R8125_MAX_RX_QUEUES;
+		tp->HwSuppIndirTblEntries = RTL8127_MAX_INDIRECTION_TABLE_ENTRIES;
+		tp->HwSuppIsrVer = 4;
+		break;
+	case RTL_GIGA_MAC_VER_70:
+		tp->min_irq_nvecs = R8126_MIN_IRQ;
+		tp->max_irq_nvecs = R8125_MAX_IRQ;
+		tp->HwSuppNumTxQueues = R8125_MAX_TX_QUEUES;
+		tp->HwSuppNumRxQueues = R8125_MAX_RX_QUEUES;
+		tp->HwSuppIndirTblEntries = RTL8127_MAX_INDIRECTION_TABLE_ENTRIES;
+		tp->HwSuppIsrVer = 3;
+		break;
 	case RTL_GIGA_MAC_VER_80:
 		tp->min_irq_nvecs = R8127_MIN_IRQ;
 		tp->max_irq_nvecs = R8127_MAX_IRQ;
@@ -4114,8 +4213,21 @@ static void rtl8125_hw_set_interrupt_type(struct rtl8169_private *tp)
 	u8 tmp;
 
 	tmp = RTL_R8(tp, INT_CFG0_8125);
-	tmp |= INT_CFG0_ENABLE_8125;
-	RTL_W8(tp, INT_CFG0_8125, tmp);
+
+	switch (tp->HwCurrIsrVer) {
+	case 4:
+	case 5:
+		tmp &= ~INT_CFG0_MSIX_ENTRY_NUM_MODE;
+		fallthrough;
+	case 2:
+	case 3:
+	case 6:
+		tmp |= INT_CFG0_ENABLE_8125;
+		RTL_W8(tp, INT_CFG0_8125, tmp);
+		break;
+	default:
+		break;
+	}
 }
 
 static void rtl_hw_start_8125_common(struct rtl8169_private *tp)
@@ -4151,8 +4263,8 @@ static void rtl_hw_start_8125_common(struct rtl8169_private *tp)
 	/* enable rx descriptor type v4 and set queue num for rss*/
 	if (tp->rss_enable) {
 		rtl8125_set_rx_q_num(tp);
-		rtl8125_set_tx_q_num(tp);
-		RTL_W8(tp, 0xd8, RTL_R8(tp, 0xd8) | 0x02);
+		if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS)
+			RTL_W8(tp, 0xd8, RTL_R8(tp, 0xd8) | 0x02);
 	}
 
 	if (tp->mac_version == RTL_GIGA_MAC_VER_80)
@@ -4169,6 +4281,8 @@ static void rtl_hw_start_8125_common(struct rtl8169_private *tp)
 	else
 		r8168_mac_ocp_modify(tp, 0xe63e, 0x0c30, 0x0020);
 
+	rtl8125_set_tx_q_num(tp);
+
 	r8168_mac_ocp_modify(tp, 0xc0b4, 0x0000, 0x000c);
 	r8168_mac_ocp_modify(tp, 0xeb6a, 0x00ff, 0x0033);
 	r8168_mac_ocp_modify(tp, 0xeb50, 0x03e0, 0x0040);
@@ -4407,8 +4521,13 @@ static void rtl_hw_start(struct  rtl8169_private *tp)
 	/* Initially a 10 us delay. Turned it into a PCI commit. - FR */
 	rtl_pci_commit(tp);
 
+	/* RX descriptor v3 has to be selected before the receiver is enabled */
+	if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS_V3)
+		rtl_init_rxcfg(tp);
+
 	RTL_W8(tp, ChipCmd, CmdTxEnb | CmdRxEnb);
-	rtl_init_rxcfg(tp);
+	if (tp->InitRxDescType != RX_DESC_RING_TYPE_RSS_V3)
+		rtl_init_rxcfg(tp);
 	rtl_set_tx_config_registers(tp);
 	rtl_set_rx_config_features(tp, tp->dev->features);
 	rtl_set_rx_mode(tp->dev);
@@ -4437,6 +4556,16 @@ static void rtl8169_mark_to_asic_rss(struct RxDescRss *descrss)
 	WRITE_ONCE(descrss->RxDescOpts.opts1, cpu_to_le32(DescOwn | eor | R8169_RX_BUF_SIZE));
 }
 
+static void rtl8169_mark_to_asic_v3(struct RxDescV3 *descv3)
+{
+	u32 eor = le32_to_cpu(descv3->dword4.opts1) & RingEnd;
+
+	descv3->dword4.opts2 = 0;
+	/* Force memory writes to complete before releasing descriptor */
+	dma_wmb();
+	WRITE_ONCE(descv3->dword4.opts1, cpu_to_le32(DescOwn | eor | R8169_RX_BUF_SIZE));
+}
+
 static void rtl8169_mark_to_asic_default(struct RxDesc *desc)
 {
 	u32 eor = le32_to_cpu(desc->opts1) & RingEnd;
@@ -4450,6 +4579,9 @@ static void rtl8169_mark_to_asic_default(struct RxDesc *desc)
 static void rtl8169_mark_to_asic(struct rtl8169_private *tp, struct RxDesc *desc)
 {
 	switch (tp->InitRxDescType) {
+	case RX_DESC_RING_TYPE_RSS_V3:
+		rtl8169_mark_to_asic_v3((struct RxDescV3 *)desc);
+		break;
 	case RX_DESC_RING_TYPE_RSS:
 		rtl8169_mark_to_asic_rss((struct RxDescRss *)desc);
 		break;
@@ -4459,6 +4591,15 @@ static void rtl8169_mark_to_asic(struct rtl8169_private *tp, struct RxDesc *desc
 	}
 }
 
+static struct RxDesc *rtl8169_get_rxdesc(struct rtl8169_private *tp,
+					  struct RxDesc *desc_base, u32 index)
+{
+	if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS_V3)
+		return (struct RxDesc *)((struct RxDescV3 *)desc_base + index);
+
+	return desc_base + index;
+}
+
 static struct page *rtl8169_alloc_rx_data(struct rtl8169_private *tp,
 					  struct rtl8169_rx_ring *ring, unsigned int index)
 {
@@ -4466,7 +4607,7 @@ static struct page *rtl8169_alloc_rx_data(struct rtl8169_private *tp,
 	int node = dev_to_node(d);
 	dma_addr_t mapping;
 	struct page *data;
-	struct RxDesc *desc = ring->RxDescArray + index;
+	struct RxDesc *desc = rtl8169_get_rxdesc(tp, ring->RxDescArray, index);
 
 	data = alloc_pages_node(node, GFP_KERNEL, get_order(R8169_RX_BUF_SIZE));
 	if (!data)
@@ -4480,7 +4621,11 @@ static struct page *rtl8169_alloc_rx_data(struct rtl8169_private *tp,
 	}
 
 	ring->RxDescPhyAddr[index] = mapping;
-	if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS) {
+	if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS_V3) {
+		struct RxDescV3 *descv3 = (struct RxDescV3 *)desc;
+
+		descv3->addr = cpu_to_le64(mapping);
+	} else if (tp->InitRxDescType == RX_DESC_RING_TYPE_RSS) {
 		struct RxDescRss *descrss = (struct RxDescRss *)(ring->RxDescArray) + index;
 
 		descrss->addr = cpu_to_le64(mapping);
@@ -4497,14 +4642,16 @@ static void rtl8169_rx_clear(struct rtl8169_private *tp, struct rtl8169_rx_ring
 	int i;
 
 	for (i = 0; i < NUM_RX_DESC && ring->Rx_databuff[i]; i++) {
+		struct RxDesc *desc = rtl8169_get_rxdesc(tp, ring->RxDescArray, i);
+
 		dma_unmap_page(tp_to_dev(tp),
 			       ring->RxDescPhyAddr[i],
 			       R8169_RX_BUF_SIZE, DMA_FROM_DEVICE);
 		__free_pages(ring->Rx_databuff[i], get_order(R8169_RX_BUF_SIZE));
 		ring->Rx_databuff[i] = NULL;
 		ring->RxDescPhyAddr[i] = 0;
-		ring->RxDescArray[i].addr = 0;
-		ring->RxDescArray[i].opts1 = 0;
+		memset(desc, 0, tp->InitRxDescType == RX_DESC_RING_TYPE_RSS_V3 ?
