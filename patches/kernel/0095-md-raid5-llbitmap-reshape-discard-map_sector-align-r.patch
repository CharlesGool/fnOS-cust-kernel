+	 * Too many stripes queued on the plug: flush it so the stripes get
+	 * handled, but try not to split a chunk across two flushes.
+	 */
+	for (;;) {
+		blk_cb = blk_check_plugged(raid5_unplug, mddev,
+					   sizeof(struct raid5_plug_cb));
+		if (!blk_cb) {
+			raid5_release_stripe(sh);
