+/*
+ * fnnas: while reshaping, move the default worker thread count along with the
+ * number of disks, unless the user has changed it.
+ */
+static void raid5_adjust_group_threads(struct mddev *mddev)
+{
+	struct r5conf *conf = mddev->private;
+	struct r5worker_group *new_groups = NULL, *old_groups;
+	int group_cnt = 0;
+	int old_cnt, new_cnt;
+
+	if (conf->level != 5 && conf->level != 6)
+		return;
+	old_cnt = raid5_default_worker_cnt(conf->previous_raid_disks);
+	if (old_cnt != conf->worker_cnt_per_group)
+		return;
+	new_cnt = raid5_default_worker_cnt(mddev->raid_disks);
+	if (new_cnt == old_cnt)
+		return;
+
+	old_groups = conf->worker_groups;
+	if (old_groups)
+		flush_workqueue(raid5_wq);
+	if (alloc_thread_groups(conf, new_cnt, &group_cnt, &new_groups)) {
+		pr_err("md: %s: failed to adjust group_thread_cnt from %d to %d\n",
+		       mdname(mddev), old_cnt, new_cnt);
+		return;
+	}
+
+	spin_lock_irq(&conf->device_lock);
+	conf->group_cnt = group_cnt;
+	conf->worker_cnt_per_group = new_cnt;
+	conf->worker_groups = new_groups;
+	spin_unlock_irq(&conf->device_lock);
+	if (old_groups)
+		kfree(old_groups[0].workers);
+	kfree(old_groups);
+}
