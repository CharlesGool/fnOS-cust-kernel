Subject: [PATCH 027/110] =?UTF-8?q?net:=20mdio:=20=E8=BF=98=E5=8E=9F?=
 =?UTF-8?q?=E8=AF=BB=20PHY=20ID=20=E5=89=8D=E6=8C=89=E9=9C=80=E5=A4=8D?=
 =?UTF-8?q?=E4=BD=8D=20PHY=20(reset-before-id-read)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

飞牛 vmlinux 里 fwnode_mdiobus_register_phy / mdiobus_register_device
与官方不同: 子节点带 "reset-before-id-read" 时, 先用 "PHY pre-ID reset"
拉一次 reset GPIO(按 reset-assert-us / reset-deassert-us 延时)再读 ID,
并置 phy->mdio.reset_state = 0, mdiobus_register_device 只在
reset_state < 0 时才拉低复位, 避免注册时再复位一次。

来源: ImmortalWrt target/linux/generic/hack-6.18/
705-net-phy-reset-PHY-before-reading-its-ID-when-requested.patch
(Tianling Shen), 原样打上(上下文有偏移)。与 r8169 devname、YT6801
backport 同属 ImmortalWrt 补丁这一批。
对比(fcmp, work-net vmlinux): fwnode_mdiobus_register_phy、
mdiobus_register_device、fwnode_mdiobus_phy_device_register 均一致。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/net/mdio/fwnode_mdio.c | 38 ++++++++++++++++++++++++++++++++++
 drivers/net/phy/mdio_bus.c     |  6 ++++--
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/drivers/net/mdio/fwnode_mdio.c b/drivers/net/mdio/fwnode_mdio.c
index 9b41d4697..84d09f452 100644
--- a/drivers/net/mdio/fwnode_mdio.c
+++ b/drivers/net/mdio/fwnode_mdio.c
@@ -7,8 +7,10 @@
  */
 
 #include <linux/acpi.h>
+#include <linux/delay.h>
 #include <linux/dev_printk.h>
 #include <linux/fwnode_mdio.h>
+#include <linux/gpio/consumer.h>
 #include <linux/of.h>
 #include <linux/phy.h>
 #include <linux/pse-pd/pse.h>
@@ -38,6 +40,36 @@ fwnode_find_pse_control(struct fwnode_handle *fwnode,
 	return psec;
 }
 
+static int fwnode_mdiobus_reset_phy_before_id_read(struct fwnode_handle *fwnode)
+{
+	struct gpio_desc *reset_gpio;
+	u32 assert_us = 0;
+	u32 deassert_us = 0;
+
+	if (!fwnode_property_read_bool(fwnode, "reset-before-id-read"))
+		return 1;
+
+	reset_gpio = fwnode_gpiod_get_index(fwnode, "reset", 0,
+					    GPIOD_OUT_HIGH, "PHY pre-ID reset");
+	if (IS_ERR(reset_gpio))
+		return PTR_ERR(reset_gpio);
+
+	fwnode_property_read_u32(fwnode, "reset-assert-us", &assert_us);
+	fwnode_property_read_u32(fwnode, "reset-deassert-us", &deassert_us);
+
+	if (assert_us)
+		fsleep(assert_us);
+
+	gpiod_set_value_cansleep(reset_gpio, 0);
+
+	if (deassert_us)
+		fsleep(deassert_us);
+
+	gpiod_put(reset_gpio);
+
+	return 0;
+}
+
 static struct mii_timestamper *
 fwnode_find_mii_timestamper(struct fwnode_handle *fwnode)
 {
@@ -133,6 +165,10 @@ int fwnode_mdiobus_register_phy(struct mii_bus *bus,
 	if (IS_ERR(mii_ts))
 		return PTR_ERR(mii_ts);
 
+	rc = fwnode_mdiobus_reset_phy_before_id_read(child);
+	if (rc < 0)
+		goto clean_mii_ts;
+
 	is_c45 = fwnode_device_is_compatible(child, "ethernet-phy-ieee802.3-c45");
 	if (is_c45 || fwnode_get_phy_id(child, &phy_id))
 		phy = get_phy_device(bus, addr, is_c45);
@@ -142,6 +178,8 @@ int fwnode_mdiobus_register_phy(struct mii_bus *bus,
 		rc = PTR_ERR(phy);
 		goto clean_mii_ts;
 	}
+	if (rc == 0)
+		phy->mdio.reset_state = 0;
 
 	if (is_acpi_node(child)) {
 		phy->irq = bus->irq[addr];
diff --git a/drivers/net/phy/mdio_bus.c b/drivers/net/phy/mdio_bus.c
index 435424113..8b1bce7c8 100644
--- a/drivers/net/phy/mdio_bus.c
+++ b/drivers/net/phy/mdio_bus.c
@@ -79,8 +79,10 @@ int mdiobus_register_device(struct mdio_device *mdiodev)
 			return err;
 		}
 
-		/* Assert the reset signal */
-		mdio_device_reset(mdiodev, 1);
+		if (mdiodev->reset_state < 0) {
+			/* Assert the reset signal */
+			mdio_device_reset(mdiodev, 1);
+		}
 	}
 
 	mdiodev->bus->mdio_map[mdiodev->addr] = mdiodev;
