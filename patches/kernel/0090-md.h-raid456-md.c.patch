只加声明, 实现在 md.c 子任务(work-md)里。原型取自飞牛 vmlinux BTF(btfproto.py):
- 上游 7.x 已有: md_sync_error、mddev_bio_split_at_reshape_offset(159)
- 飞牛私有: md_sb_pending、md_update_rdev_capabilities、md_mark_discard_unsupported、
  md_llbitmap_sync_target、md_speedup_resync、md_speedup_requested_resync、
  md_dfr_started、md_dfr_set_sync_takeover、md_rdev_in_dfr、md_start_dfr、md_stop_dfr、
  stripe_start_dfr、stripe_end_dfr、stripe_end_bio(DFR = degradation free recover)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/md/md.h | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/md/md.h b/drivers/md/md.h
index 7a2842803..25ad097ae 100644
--- a/drivers/md/md.h
+++ b/drivers/md/md.h
@@ -1070,6 +1070,29 @@ extern void mddev_destroy_serial_pool(struct mddev *mddev,
 struct md_rdev *md_find_rdev_nr_rcu(struct mddev *mddev, int nr);
 struct md_rdev *md_find_rdev_rcu(struct mddev *mddev, dev_t dev);
 
+/* md.c helpers used by raid456 (fnnas) */
+extern void md_sync_error(struct mddev *mddev);
+struct bio *mddev_bio_split_at_reshape_offset(struct mddev *mddev,
+					      struct bio *bio,
+					      unsigned int *max_sectors,
+					      struct bio_set *bs);
+extern bool md_sb_pending(struct mddev *mddev);
+extern void md_update_rdev_capabilities(struct mddev *mddev);
+extern void md_mark_discard_unsupported(struct bio *bio);
+extern int md_llbitmap_sync_target(struct mddev *mddev, sector_t offset);
+extern sector_t md_speedup_resync(struct mddev *mddev, sector_t sector_nr);
+extern sector_t md_speedup_requested_resync(struct mddev *mddev,
+					    sector_t sector_nr);
+extern bool md_dfr_started(struct mddev *mddev);
+extern void md_dfr_set_sync_takeover(struct mddev *mddev);
+extern bool md_rdev_in_dfr(struct mddev *mddev, struct md_rdev *rdev);
+extern bool md_start_dfr(struct md_rdev *rdev, struct bio *bio);
+extern void md_stop_dfr(struct md_rdev *rdev);
+struct stripe_head;
+extern bool stripe_start_dfr(struct md_rdev *rdev, struct stripe_head *sh);
+extern void stripe_end_dfr(struct stripe_head *sh);
+extern void stripe_end_bio(struct stripe_head *sh, struct bio *bio);
+
 static inline bool is_rdev_broken(struct md_rdev *rdev)
 {
 	return !disk_live(rdev->bdev->bd_disk);
