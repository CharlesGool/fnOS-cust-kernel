+/*
+ * FIHINTUNUSED (fnOS): tell the block device which ranges are unused, the same
+ * walk as FITRIM but sending unused hints instead of discards.
+ */
+static noinline int btrfs_ioctl_hint_unused(struct file *file, void __user *arg)
+{
+	struct btrfs_fs_info *fs_info = inode_to_fs_info(file_inode(file));
+	struct btrfs_device *device;
+	struct fstrim_range range = { 0 };
+	u64 num_devices = 0;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(device, &fs_info->fs_devices->devices,
+				dev_list) {
+		if (!device->bdev ||
+		    !blk_queue_unused_hint(bdev_get_queue(device->bdev)))
+			continue;
+		num_devices++;
+	}
+	rcu_read_unlock();
+
+	if (!num_devices)
+		return -EOPNOTSUPP;
+	if (copy_from_user(&range, arg, sizeof(range)))
+		return -EFAULT;
+	if (range.len < fs_info->sb->s_blocksize)
+		return -EINVAL;
+
+	ret = btrfs_trim_fs(fs_info, &range, TRIM_SEND_HINT);
+	if (!ret)
+		btrfs_info(fs_info, "total send %llu bytes hints", range.len);
+
+	return ret;
+}
