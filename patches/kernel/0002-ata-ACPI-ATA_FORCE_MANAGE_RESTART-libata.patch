diff --git a/drivers/ata/libata-acpi.c b/drivers/ata/libata-acpi.c
index f2140fc06..15e18d50d 100644
--- a/drivers/ata/libata-acpi.c
+++ b/drivers/ata/libata-acpi.c
@@ -245,6 +245,73 @@ void ata_acpi_bind_dev(struct ata_device *dev)
 				   ata_acpi_dev_uevent);
 }
 
+/**
+ * ata_acpi_dev_manage_restart - if the disk should be stopped (spun down) on
+ *                               system restart.
+ * @dev: target ATA device
+ *
+ * RETURNS:
+ * true if the disk should be stopped, otherwise false.
+ */
+bool ata_acpi_dev_manage_restart(struct ata_device *dev)
+{
+	struct device *tdev;
+
+	/*
+	 * If ATA_FLAG_ACPI_SATA is set, the acpi fwnode is attached to the
+	 * ata_device instead of the ata_port.
+	 */
+	if (dev->link->ap->flags & ATA_FLAG_ACPI_SATA)
+		tdev = &dev->tdev;
+	else
+		tdev = &dev->link->ap->tdev;
+
+	if (!is_acpi_device_node(tdev->fwnode))
+		return false;
+	return acpi_bus_power_manageable(ACPI_HANDLE(tdev));
+}
+
+/**
+ * ata_acpi_port_power_on - set the power state of the ata port to D0
+ * @ap: target ATA port
+ *
+ * This function is called at the beginning of ata_port_probe().
+ */
+void ata_acpi_port_power_on(struct ata_port *ap)
+{
+	acpi_handle handle;
+	int i;
+
+	/*
+	 * If ATA_FLAG_ACPI_SATA is set, the acpi fwnode is attached to the
+	 * ata_device instead of the ata_port.
+	 */
+	if (ap->flags & ATA_FLAG_ACPI_SATA) {
+		for (i = 0; i < ATA_MAX_DEVICES; i++) {
+			struct ata_device *dev = &ap->link.device[i];
+
+			if (!is_acpi_device_node(dev->tdev.fwnode))
+				continue;
+			handle = ACPI_HANDLE(&dev->tdev);
+			if (!acpi_bus_power_manageable(handle))
+				continue;
+			if (acpi_bus_set_power(handle, ACPI_STATE_D0))
+				ata_dev_err(dev,
+					    "acpi: failed to set power state to D0\n");
+		}
+		return;
+	}
+
+	if (!is_acpi_device_node(ap->tdev.fwnode))
+		return;
+	handle = ACPI_HANDLE(&ap->tdev);
+	if (!acpi_bus_power_manageable(handle))
+		return;
+
+	if (acpi_bus_set_power(handle, ACPI_STATE_D0))
+		ata_port_err(ap, "acpi: failed to set power state to D0\n");
+}
+
 /**
  * ata_acpi_dissociate - dissociate ATA host from ACPI objects
  * @host: target ATA host
diff --git a/drivers/ata/libata-core.c b/drivers/ata/libata-core.c
index 29394d18e..30cc0b93d 100644
--- a/drivers/ata/libata-core.c
+++ b/drivers/ata/libata-core.c
@@ -6119,6 +6119,8 @@ void ata_port_probe(struct ata_port *ap)
 	struct ata_eh_info *ehi = &ap->link.eh_info;
 	unsigned long flags;
 
+	ata_acpi_port_power_on(ap);
+
 	/* kick EH for boot probing */
 	spin_lock_irqsave(ap->lock, flags);
 
diff --git a/drivers/ata/libata-er.c b/drivers/ata/libata-er.c
new file mode 100755
index 000000000..7a5c80eea
--- /dev/null
+++ b/drivers/ata/libata-er.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * libata 事件上报: ata_dev_err()/ata_link_warn() 等打印的同时, 把 err/warn 级别的
+ * 消息连同硬盘序列号经 er_emit() 上报给 event_report(飞牛 sysdiag 订阅)。
+ * 按飞牛 6.18.18.c1186-trim 二进制还原。
+ */
+#include <linux/kernel.h>
+#include <linux/export.h>
+#include <linux/string.h>
+#include <linux/libata.h>
+#include <linux/event_report.h>
+
+#define ER_EVENT_SATA	0x50
+
+static void er_report_ata_dev(const struct ata_device *dev, const char *level,
+			      const char *fmt, va_list args)
+{
+	struct ata_error_info info;
+	unsigned int i;
+	u32 print_id;
+	u16 subevent;
+	char *p;
+	int len;
+
+	if (!dev)
+		return;
+
+	if (!strcmp(level, "err"))
+		subevent = SATA_SUBEVENT_ERROR;
+	else if (!strcmp(level, "warn"))
+		subevent = SATA_SUBEVENT_WARNING;
+	else
+		return;
+
+	memset(&info, 0, sizeof(info));
+
+	/* IDENTIFY 里的序列号(同 ata_id_string): 每个字高字节在前 */
+	for (i = 0; i < ATA_ID_SERNO_LEN / 2; i++) {
+		u16 w = dev->id[ATA_ID_SERNO + i];
+
+		info.serial_number[i * 2] = w >> 8;
+		info.serial_number[i * 2 + 1] = w & 0xff;
+	}
+	info.serial_number[ATA_ID_SERNO_LEN] = '\0';
+
+	/* 去掉开头的空白 */
+	for (i = 0; i < ATA_ID_SERNO_LEN; i++)
+		if (info.serial_number[i] != ' ' && info.serial_number[i] != '\t')
+			break;
+	if (i > 0)
+		memmove(info.serial_number, info.serial_number + i,
+			sizeof(info.serial_number) - i);
+
+	/* 去掉结尾的空格; 序列号为空就不报 */
+	len = strlen(info.serial_number);
+	p = &info.serial_number[len - 1];
+	while (len > 0 && *p-- == ' ')
+		len--;
+	if (!len)
+		return;
+	info.serial_number[len] = '\0';
+
+	vsnprintf(info.error_desc, sizeof(info.error_desc), fmt, args);
+
+	print_id = -1;
+	if (dev->link && dev->link->ap)
+		print_id = dev->link->ap->print_id;
+	info.print_id = print_id;
+
+	er_emit(ER_EVENT_SATA, subevent, &info, sizeof(info));
+}
+
+#define DEFINE_ATA_DEV_REPORT(lvl)						\
+void ata_dev_##lvl##_report(const struct ata_device *dev, const char *fmt, ...)	\
+{										\
+	va_list args;								\
+										\
+	va_start(args, fmt);							\
+	er_report_ata_dev(dev, #lvl, fmt, args);				\
+	va_end(args);								\
+}										\
+EXPORT_SYMBOL_GPL(ata_dev_##lvl##_report)
+
+DEFINE_ATA_DEV_REPORT(err);
+DEFINE_ATA_DEV_REPORT(warn);
+DEFINE_ATA_DEV_REPORT(notice);
+DEFINE_ATA_DEV_REPORT(info);
+DEFINE_ATA_DEV_REPORT(debug);
+
+/* 注意: 飞牛原版对 link 上每个设备复用同一个 va_list(没有 va_copy), 这里照原样还原 */
+static void er_report_ata_link(const struct ata_link *link, const char *level,
+			       const char *fmt, va_list args)
+{
+	struct ata_device *dev;
+
+	if (!link)
+		return;
+
+	ata_for_each_dev(dev, (struct ata_link *)link, ALL) {
+		if (dev->class == ATA_DEV_NONE)
+			continue;
+		er_report_ata_dev(dev, level, fmt, args);
+	}
+}
+
+#define DEFINE_ATA_LINK_REPORT(lvl)						\
+void ata_link_##lvl##_report(const struct ata_link *link, const char *fmt, ...)	\
+{										\
+	va_list args;								\
+										\
+	va_start(args, fmt);							\
+	er_report_ata_link(link, #lvl, fmt, args);				\
+	va_end(args);								\
+}										\
+EXPORT_SYMBOL_GPL(ata_link_##lvl##_report)
+
+DEFINE_ATA_LINK_REPORT(err);
+DEFINE_ATA_LINK_REPORT(warn);
+DEFINE_ATA_LINK_REPORT(notice);
+DEFINE_ATA_LINK_REPORT(info);
+DEFINE_ATA_LINK_REPORT(debug);
diff --git a/drivers/ata/libata-scsi.c b/drivers/ata/libata-scsi.c
