diff --git a/fs/btrfs/trim_acl.c b/fs/btrfs/trim_acl.c
new file mode 100644
index 000000000..dbd11ed9b
--- /dev/null
+++ b/fs/btrfs/trim_acl.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * btrfs 的 Trim-ACL 支持 (飞牛私有): trim acl 存在扩展属性 "system.trim_acl",
+ * trim flags 存在 "system.trim_flags" (处理器在 fs/trim_flags.c)。
+ * Copyright (C) T.R.I.M Inc.
+ */
+#include <linux/fs.h>
+#include <linux/xattr.h>
+#include <linux/slab.h>
+#include <linux/trim_acl.h>
+#include "ctree.h"
+#include "btrfs_inode.h"
+#include "xattr.h"
+
+ssize_t btrfs_get_trim_flags(struct inode *inode, void *buffer, size_t size)
+{
+	return btrfs_getxattr(inode, TRIM_INODE_FLAGS_XATTR, buffer, size);
+}
+
+int btrfs_set_trim_flags(struct inode *inode, const void *value, size_t size,
+			 int flags)
+{
+	if (btrfs_root_readonly(BTRFS_I(inode)->root))
+		return -EROFS;
+	return btrfs_setxattr_trans(inode, TRIM_INODE_FLAGS_XATTR, value, size, flags);
+}
+
+/*
+ * Inode operation get_trim_acl(): 先查缓存, 没有缓存时读 xattr 并缓存结果。
+ */
+struct trim_acl *btrfs_get_trim_acl(struct mnt_idmap *idmap, struct inode *inode)
+{
+	struct trim_acl *acl;
+	char *value = NULL;
+	int size;
+
+	acl = get_cached_trim_acl(inode);
+	if (!is_uncached_trim_acl(acl))
+		return acl;
+
+	size = btrfs_getxattr(inode, TRIM_ACL_XATTR_ACCESS, "", 0);
+	if (size > 0) {
+		value = kzalloc(size, GFP_NOFS);
+		if (!value)
+			return ERR_PTR(-ENOMEM);
+		size = btrfs_getxattr(inode, TRIM_ACL_XATTR_ACCESS, value, size);
+	}
+	if (size > 0)
+		acl = trim_acl_from_disk(value, size);
+	else if (size == -ENOENT || size == -ENODATA || size == 0)
+		acl = NULL;
+	else
+		acl = ERR_PTR(size);
+	kfree(value);
+
+	if (!IS_ERR(acl))
+		set_cached_trim_acl(inode, acl);
+
+	return acl;
+}
+
+static inline int __btrfs_set_trim_acl(struct inode *inode, struct trim_acl *acl)
+{
+	void *value = NULL;
+	size_t size = 0;
+	int ret;
+
+	if (acl) {
+		ret = trim_acl_valid(acl);
+		if (ret < 0)
+			return ret;
+		value = trim_acl_to_disk(acl, &size);
+		if (IS_ERR(value))
+			return PTR_ERR(value);
+	}
+
+	ret = btrfs_setxattr_trans(inode, TRIM_ACL_XATTR_ACCESS, value, size, 0);
+	kfree(value);
+	if (!ret)
+		set_cached_trim_acl(inode, acl);
+
+	return ret;
+}
+
+/*
+ * Inode operation set_trim_acl().
+ */
+int btrfs_set_trim_acl(struct mnt_idmap *idmap, struct inode *inode,
+		       struct trim_acl *acl)
+{
+	if (!inode)
+		return -EINVAL;
+	return __btrfs_set_trim_acl(inode, acl);
+}
+
+static int btrfs_xattr_trim_acl_get(const struct xattr_handler *handler,
+				    struct dentry *dentry, struct inode *unused,
+				    const char *name, void *buffer, size_t size)
+{
+	struct trim_acl *acl;
+	int ret;
+
+	acl = btrfs_get_trim_acl(&nop_mnt_idmap, d_inode(dentry));
+	if (IS_ERR(acl))
+		return PTR_ERR(acl);
+	if (!acl)
+		return -ENODATA;
+	ret = trim_acl_to_xattr(acl, buffer, size);
+	trim_acl_release(acl);
+
+	return ret;
+}
+
+static int btrfs_xattr_trim_acl_set(const struct xattr_handler *handler,
+				    struct mnt_idmap *idmap,
+				    struct dentry *dentry, struct inode *unused,
+				    const char *name, const void *value,
+				    size_t size, int flags)
+{
+	struct trim_acl *acl = NULL;
+	int ret;
+
+	if (value) {
+		acl = trim_acl_from_xattr(value, size);
+		if (IS_ERR(acl))
+			return PTR_ERR(acl);
+		if (acl) {
+			ret = trim_acl_valid(acl);
+			if (ret)
+				goto out;
+		}
+	}
+
+	ret = __btrfs_set_trim_acl(d_inode(dentry), acl);
+out:
+	trim_acl_release(acl);
+	return ret;
+}
+
+const struct xattr_handler btrfs_xattr_trimacl_access_handler = {
+	.name	= TRIM_ACL_XATTR_ACCESS,
+	.get	= btrfs_xattr_trim_acl_get,
+	.set	= btrfs_xattr_trim_acl_set,
+};
