+/*
+ * fnnas: map an array sector to the sector on @rdev (near layout), if @rdev
+ * holds no copy of the chunk the result is the start of the next stripe.
+ */
+static sector_t raid10_map_sector(struct mddev *mddev, struct md_rdev *rdev,
+				  sector_t offset)
+{
+	struct r10conf *conf = mddev->private;
+	int raid_disks = conf->geo.raid_disks;
+	int disk = rdev->raid_disk;
+	sector_t chunk, stripe;
+	int dev, first;
+	sector_t sector;
+
+	chunk = (offset >> conf->geo.chunk_shift) * conf->geo.near_copies;
+	stripe = div_u64_rem(chunk, raid_disks, &dev);
+	if (disk < dev)
+		stripe++;
+	first = disk - dev;
+	if (first < 0)
+		first += raid_disks;
+	sector = stripe << conf->geo.chunk_shift;
+	if (conf->geo.near_copies > first)
+		sector += offset & conf->geo.chunk_mask;
+
+	return sector + rdev->data_offset;
+}
+
+/* fnnas: shrink the array range to whole stripes and convert it to device sectors */
+static void raid10_align_chunk_addr_virt_to_dev(struct mddev *mddev,
+						sector_t virt_start,
+						sector_t virt_end,
+						sector_t *dev_start,
+						sector_t *dev_end)
+{
+	struct r10conf *conf = mddev->private;
+
+	if ((!dev_start && !dev_end) || conf->geo.far_copies != 1)
+		return;
+
+	if (dev_start) {
+		sector_t chunk = (virt_start >> conf->geo.chunk_shift) *
+				 conf->geo.near_copies;
+		u32 rem;
+		sector_t stripe = div_u64_rem(chunk, conf->geo.raid_disks, &rem);
+
+		if (rem || (virt_start & conf->geo.chunk_mask))
+			stripe++;
+		*dev_start = stripe << conf->geo.chunk_shift;
+	}
+
+	if (dev_end) {
+		sector_t chunk = (virt_end >> conf->geo.chunk_shift) *
+				 conf->geo.near_copies;
+
+		*dev_end = div_u64(chunk, conf->geo.raid_disks) <<
+			   conf->geo.chunk_shift;
+	}
+}
