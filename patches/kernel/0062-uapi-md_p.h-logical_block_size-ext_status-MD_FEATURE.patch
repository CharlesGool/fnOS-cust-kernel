与飞牛 linux-headers 包里的 include/uapi/linux/raid/md_p.h 逐字一致(直接取自 /k/fnos-headers):
  - mdp_superblock_1: pad3[32] 改为 __le32 logical_block_size + pad3[24] + __le32 ext_status;
    logical_block_size 来自上游 62ed1b582246 "md: allow configuring logical block size"(只取结构定义,
    md.c 里 lbs 的读写/sysfs 逻辑留给 md.c 子任务), ext_status 和 MD_SB_1_EXT_STATUS_FAST_RESCYNC
    是飞牛私有(快速重同步标记, 宏名拼写照飞牛)。
  - MD_FEATURE_LLBITMAP_CONVERTING(8192) 飞牛私有, 并入 MD_FEATURE_ALL。
磁盘格式: 超级块偏移 0x100+ 与飞牛相同; 上游最终版只有 lbs, 没有 ext_status。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/uapi/linux/raid/md_p.h | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/include/uapi/linux/raid/md_p.h b/include/uapi/linux/raid/md_p.h
index ac74133a4..0e89f4589 100644
--- a/include/uapi/linux/raid/md_p.h
+++ b/include/uapi/linux/raid/md_p.h
@@ -291,7 +291,11 @@ struct mdp_superblock_1 {
 	__le64	resync_offset;	/* data before this offset (from data_offset) known to be in sync */
 	__le32	sb_csum;	/* checksum up to devs[max_dev] */
 	__le32	max_dev;	/* size of devs[] array to consider */
-	__u8	pad3[64-32];	/* set to 0 when writing */
+	__le32  logical_block_size;	/* same as q->limits->logical_block_size */
+	__u8	pad3[64-40];	/* set to 0 when writing */
+
+#define MD_SB_1_EXT_STATUS_FAST_RESCYNC		(1 << 0)
+	__le32	ext_status;	/* extent status used for fnnas*/
 
 	/* device state information. Indexed by dev_number.
 	 * 2 bytes per device
@@ -326,6 +330,7 @@ struct mdp_superblock_1 {
 #define	MD_FEATURE_PPL			1024 /* support PPL */
 #define	MD_FEATURE_MULTIPLE_PPLS	2048 /* support for multiple PPLs */
 #define	MD_FEATURE_RAID0_LAYOUT		4096 /* layout is meaningful for RAID0 */
+#define	MD_FEATURE_LLBITMAP_CONVERTING	8192 /* llbitmap conversion in progress */
 #define	MD_FEATURE_ALL			(MD_FEATURE_BITMAP_OFFSET	\
 					|MD_FEATURE_RECOVERY_OFFSET	\
 					|MD_FEATURE_RESHAPE_ACTIVE	\
@@ -339,6 +344,7 @@ struct mdp_superblock_1 {
 					|MD_FEATURE_PPL			\
 					|MD_FEATURE_MULTIPLE_PPLS	\
 					|MD_FEATURE_RAID0_LAYOUT	\
+					|MD_FEATURE_LLBITMAP_CONVERTING\
 					)
 
 struct r5l_payload_header {
