+/*
+ * fnOS 回收站: unlinkat()/rmdir 的 dfd 可以传两个魔数, 含义同 AT_FDCWD,
+ * 另外指定是否进回收站. 普通 dfd 时, 白名单进程(trim 服务)才进回收站.
+ * trim_trashbin_flag: 0 = 直接删除, 1 = 白名单进程, 2 = 强制进回收站
+ */
+#define AT_FDCWD_NO_TRASHBIN	-7125
+#define AT_FDCWD_TRASHBIN	-7126
+
 int do_rmdir(int dfd, struct filename *name)
 {
 	int error;
@@ -4574,6 +4655,17 @@ int do_rmdir(int dfd, struct filename *name)
 	struct qstr last;
 	int type;
 	unsigned int lookup_flags = 0;
+	int trim_trashbin_flag;
+
+	if (dfd == AT_FDCWD_NO_TRASHBIN) {
+		dfd = AT_FDCWD;
+		trim_trashbin_flag = 0;
+	} else if (dfd == AT_FDCWD_TRASHBIN) {
+		dfd = AT_FDCWD;
+		trim_trashbin_flag = 2;
+	} else {
+		trim_trashbin_flag = trim_is_on_trashbin_whitelist();
+	}
 retry:
 	error = filename_parentat(dfd, name, lookup_flags, &path, &last, &type);
 	if (error)
@@ -4595,12 +4687,32 @@ int do_rmdir(int dfd, struct filename *name)
 	if (error)
 		goto exit2;
 
+	if (trim_trashbin_flag) {
+		int processed = 0;
+
+		inode_lock_nested(path.dentry->d_inode, I_MUTEX_PARENT);
+		dentry = lookup_one_qstr_excl(&last, path.dentry, lookup_flags);
+		inode_unlock(path.dentry->d_inode);
+		if (!IS_ERR(dentry)) {
+			if (dentry->d_inode)
+				error = trim_do_trashbin(path.mnt, path.dentry->d_inode, dentry, 1,
+							 trim_trashbin_flag, &processed);
+			dput(dentry);
+		}
+		/* 已移进回收站 */
+		if (processed)
+			goto exit5;
+	}
+
 	inode_lock_nested(path.dentry->d_inode, I_MUTEX_PARENT);
 	dentry = lookup_one_qstr_excl(&last, path.dentry, lookup_flags);
 	error = PTR_ERR(dentry);
 	if (IS_ERR(dentry))
 		goto exit3;
 	error = security_path_rmdir(&path, dentry);
+	if (error)
