 	if (!inode)
 		return -ENOENT;
 
-	error = may_create(idmap, dir, new_dentry);
+	error = may_create(idmap, dir, new_dentry, inode->i_mode);
 	if (error)
 		return error;
 
@@ -5048,6 +5193,31 @@ SYSCALL_DEFINE2(link, const char __user *, oldname, const char __user *, newname
 	return do_linkat(AT_FDCWD, getname(oldname), AT_FDCWD, getname(newname), 0);
 }
 
+/* btrfs 子卷的根目录(inode 号 256): 移动子卷不要求对它有写权限 */
+static inline bool not_btrfs_subvol_root(struct dentry *dentry)
+{
+	return dentry->d_sb->s_magic != BTRFS_SUPER_MAGIC ||
+	       d_inode(dentry)->i_ino != BTRFS_FIRST_FREE_OBJECTID;
+}
+
+/*
+ * 目录换父目录时要改 "..", 需要对被移动的目录有写权限.
+ * TRIM ACL 策略下不检查(移动权限已在 may_delete/may_create 里按 ACL 判过).
+ */
+static int may_write_moved_directory(struct mnt_idmap *idmap, struct dentry *dentry)
+{
+	if (IS_TRIMACL(dentry)) {
+		enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+		int error = trimacl_resolve_policy(dentry, 0, &policy);
+
+		if (error)
+			return error;
+		if (policy == TRIMACL_POLICY_TRIM)
+			return 0;
+	}
+	return inode_permission(idmap, d_inode(dentry), MAY_WRITE);
+}
+
 /**
  * vfs_rename - rename a filesystem object
  * @rd:		pointer to &struct renamedata info
@@ -5119,7 +5289,7 @@ int vfs_rename(struct renamedata *rd)
 		return error;
 
 	if (!target) {
-		error = may_create(rd->mnt_idmap, new_dir, new_dentry);
+		error = may_create(rd->mnt_idmap, new_dir, new_dentry, source->i_mode);
 	} else {
 		new_is_dir = d_is_dir(new_dentry);
 
@@ -5141,15 +5311,13 @@ int vfs_rename(struct renamedata *rd)
 	 * we'll need to flip '..'.
 	 */
 	if (new_dir != old_dir) {
-		if (is_dir) {
-			error = inode_permission(rd->mnt_idmap, source,
-						 MAY_WRITE);
+		if (is_dir && not_btrfs_subvol_root(old_dentry)) {
+			error = may_write_moved_directory(rd->mnt_idmap, old_dentry);
 			if (error)
 				return error;
 		}
-		if ((flags & RENAME_EXCHANGE) && new_is_dir) {
-			error = inode_permission(rd->mnt_idmap, target,
-						 MAY_WRITE);
+		if ((flags & RENAME_EXCHANGE) && new_is_dir && not_btrfs_subvol_root(new_dentry)) {
+			error = may_write_moved_directory(rd->mnt_idmap, new_dentry);
 			if (error)
 				return error;
 		}
