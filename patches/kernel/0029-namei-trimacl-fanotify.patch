 	if (error)
 		goto exit4;
 	error = vfs_rmdir(mnt_idmap(path.mnt), path.dentry->d_inode, dentry);
@@ -4608,6 +4720,7 @@ int do_rmdir(int dfd, struct filename *name)
 	dput(dentry);
 exit3:
