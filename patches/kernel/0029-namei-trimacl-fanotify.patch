+exit5:
 	mnt_drop_write(path.mnt);
 exit2:
 	path_put(&path);
@@ -4711,6 +4824,17 @@ int do_unlinkat(int dfd, struct filename *name)
 	struct inode *inode = NULL;
 	struct inode *delegated_inode = NULL;
 	unsigned int lookup_flags = 0;
+	int trim_trashbin_flag;
+
+	if (dfd == AT_FDCWD_NO_TRASHBIN) {
+		dfd = AT_FDCWD;
+		trim_trashbin_flag = 0;
+	} else if (dfd == AT_FDCWD_TRASHBIN) {
+		dfd = AT_FDCWD;
+		trim_trashbin_flag = 2;
+	} else {
+		trim_trashbin_flag = trim_is_on_trashbin_whitelist();
+	}
 retry:
 	error = filename_parentat(dfd, name, lookup_flags, &path, &last, &type);
 	if (error)
@@ -4723,6 +4847,23 @@ int do_unlinkat(int dfd, struct filename *name)
 	error = mnt_want_write(path.mnt);
 	if (error)
 		goto exit2;
+
+	if (trim_trashbin_flag) {
+		int processed = 0;
+
+		inode_lock_nested(path.dentry->d_inode, I_MUTEX_PARENT);
+		dentry = lookup_one_qstr_excl(&last, path.dentry, lookup_flags);
+		inode_unlock(path.dentry->d_inode);
+		if (!IS_ERR(dentry)) {
