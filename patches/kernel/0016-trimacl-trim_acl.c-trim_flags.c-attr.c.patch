 {
 	debugfs_create_u32("trimacl_debug_print_level", 0644, NULL, &trimacl_debug_level);
diff --git a/fs/trim_flags.c b/fs/trim_flags.c
new file mode 100755
index 000000000..3994cc1be
--- /dev/null
+++ b/fs/trim_flags.c
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * fnOS system.trim_flags: per-inode flags (TRIM_INODE_F_POSIX_ACL) and the
+ * TRIM-or-POSIX ACL policy.  Reconstructed from the fnOS 6.18.18.c1186-trim binary.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/fs.h>
+#include <linux/dcache.h>
+#include <linux/namei.h>
+#include <linux/seqlock.h>
+#include <linux/capability.h>
+#include <linux/xattr.h>
+#include <linux/export.h>
+#include <linux/trim_acl.h>
+#include <linux/trim_flags.h>
+#include <linux/trimvfs.h>
+
+
+void trim_inode_flags_forget(struct inode *inode)
+{
+	spin_lock(&inode->i_lock);
+	inode->i_trim_flags_generation++;
+	inode->i_trim_flags_state = TRIM_INODE_FLAGS_UNKNOWN;
+	spin_unlock(&inode->i_lock);
+}
+EXPORT_SYMBOL(trim_inode_flags_forget);
+
+void trim_inode_flags_init_new(struct inode *inode)
+{
+	if (!IS_TRIMACL_INODE(inode))
+		return;
+
+	spin_lock(&inode->i_lock);
+	if (inode->i_trim_flags_state == TRIM_INODE_FLAGS_UNKNOWN) {
+		inode->i_trim_flags_generation++;
+		atomic64_set(&inode->i_trim_flags, 0);
+		inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+	}
+	spin_unlock(&inode->i_lock);
+}
+EXPORT_SYMBOL(trim_inode_flags_init_new);
+
+static int trim_inode_flags_read_disk(struct inode *inode, u64 *flags, bool *found, bool *unsupported)
+{
+	struct trim_inode_flags_xattr_v1 *buf;
+	int retries = 3;
+	ssize_t size;
+	int ret;
+
+	if (!inode->i_op->get_trim_flags)
+		return -EOPNOTSUPP;
+retry:
+	size = inode->i_op->get_trim_flags(inode, NULL, 0);
+	if (size == -ENODATA || size == -ENOENT)
+		return 0;
+	if (size < 0)
+		return size;
+	if (size == 0 || size > XATTR_SIZE_MAX)
+		return -EUCLEAN;
+
+	buf = kmalloc(size, GFP_NOFS);
+	if (!buf)
+		return -ENOMEM;
+
+	size = inode->i_op->get_trim_flags(inode, buf, size);
+	if (size == -ERANGE) {
+		kfree(buf);
+		if (--retries)
+			goto retry;
+		return -EAGAIN;
+	}
+	if (size == -ENODATA || size == -ENOENT) {
+		ret = 0;
+		goto out;
+	}
+	if (size < 0) {
+		ret = size;
+		goto out;
+	}
+
+	*found = true;
+	if (size < sizeof(*buf)) {
+		ret = -EUCLEAN;
+		goto out;
+	}
+	if (le16_to_cpu(buf->version) != TRIM_INODE_FLAGS_XATTR_VERSION) {
+		if (unsupported)
+			*unsupported = true;
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (le16_to_cpu(buf->size) != sizeof(*buf) || size != sizeof(*buf) || buf->reserved) {
+		ret = -EUCLEAN;
+		goto out;
+	}
+	*flags = le64_to_cpu(buf->flags);
+	ret = 0;
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int trim_inode_flags_xattr_get(const struct xattr_handler *handler, struct dentry *unused,
+				      struct inode *inode, const char *name, void *buffer, size_t size)
+{
+	struct trim_inode_flags_xattr_v1 *xattr = buffer;
+	bool found = false;
+	u64 flags = 0;
+	int ret;
+
+	ret = trim_inode_flags_read_disk(inode, &flags, &found, NULL);
+	if (ret)
+		return ret;
+	if (!found)
+		return -ENODATA;
+	if (!buffer)
+		return sizeof(*xattr);
+	if (size < sizeof(*xattr))
+		return -ERANGE;
+
+	xattr->version = cpu_to_le16(TRIM_INODE_FLAGS_XATTR_VERSION);
+	xattr->size = cpu_to_le16(sizeof(*xattr));
+	xattr->reserved = 0;
+	xattr->flags = cpu_to_le64(flags);
+	return sizeof(*xattr);
+}
+
+int trim_inode_flags_load(struct inode *inode, u64 *flags)
+{
+	bool found = false, unsupported = false;
+	u64 disk_flags = 0;
+	unsigned int gen;
+	int ret;
+
+	for (;;) {
+		switch (READ_ONCE(inode->i_trim_flags_state)) {
+		case TRIM_INODE_FLAGS_VALID:
+			*flags = atomic64_read(&inode->i_trim_flags);
+			return 0;
+		case TRIM_INODE_FLAGS_CORRUPT:
+			return -EUCLEAN;
+		case TRIM_INODE_FLAGS_UNSUPPORTED:
+			return -EOPNOTSUPP;
+		}
+
+		found = false;
+		disk_flags = 0;
+		unsupported = false;
+		gen = READ_ONCE(inode->i_trim_flags_generation);
+		ret = trim_inode_flags_read_disk(inode, &disk_flags, &found, &unsupported);
+
+		spin_lock(&inode->i_lock);
+		if (inode->i_trim_flags_generation != gen ||
+		    inode->i_trim_flags_state != TRIM_INODE_FLAGS_UNKNOWN) {
+			/* Raced with an update, look again */
+			spin_unlock(&inode->i_lock);
+			continue;
+		}
+		if (!ret) {
+			atomic64_set(&inode->i_trim_flags, disk_flags);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+			*flags = disk_flags;
+		} else if (ret == -EUCLEAN) {
+			atomic64_set(&inode->i_trim_flags, 0);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_CORRUPT;
+		} else if (ret == -EOPNOTSUPP && unsupported) {
+			atomic64_set(&inode->i_trim_flags, 0);
+			inode->i_trim_flags_state = TRIM_INODE_FLAGS_UNSUPPORTED;
+		}
+		spin_unlock(&inode->i_lock);
+		return ret;
+	}
+}
+EXPORT_SYMBOL(trim_inode_flags_load);
+
+/* Top-level directories of a volume that always use POSIX ACLs */
+static bool trimacl_is_posix_top_dir(const char *name)
+{
+	return !strcmp(name, "docker") || !strcmp(name, "@appcenter") || !strcmp(name, "@appconf") ||
+	       !strcmp(name, "@appdata") || !strcmp(name, "@apphome") || !strcmp(name, "@appmeta") ||
+	       !strcmp(name, "@apptemp") || name[0] == '_';
+}
+
+/*
+ * Find the directory right below the root of the filesystem that
+ * contains @dentry (and the one below that).  Called under RCU.
+ */
+static void trimacl_top_dirs(struct dentry *dentry, struct dentry **top, struct dentry **second)
+{
+	struct dentry *root = dentry->d_sb->s_root;
+	struct dentry *d = dentry, *child = NULL, *grandchild = NULL;
+
+	if (!root)
+		return;
+	if (dentry && dentry != root) {
+		while (!IS_ROOT(d)) {
+			struct dentry *parent = d->d_parent;
+
+			grandchild = child;
+			child = d;
+			d = parent;
+			if (!parent || parent == root)
+				break;
+		}
+	}
+	if (d != root)
+		return;
+	*top = child;
+	*second = grandchild;
+}
+
+/*
+ * TRIM ACL or POSIX ACL for @dentry?  The filesystem can decide with
+ * ->is_trimacl, otherwise app/docker directories are POSIX and the
+ * TRIM_INODE_F_POSIX_ACL flag of the nearest ancestor decides.
+ */
+int trimacl_resolve_policy(struct dentry *dentry, unsigned int flags, enum trimacl_policy *policy)
+{
+	struct inode *inode = d_inode(dentry);
+	struct dentry *d, *top, *second;
+	unsigned int seq;
+	u64 tflags;
+	int ret;
+
+	if (!inode)
+		return -ENOENT;
+	if (!IS_TRIMACL_INODE(inode))
+		goto posix;
+
+	if (inode->i_op->is_trimacl) {
+		if (flags & MAY_NOT_BLOCK)
+			return -ECHILD;
+		ret = inode->i_op->is_trimacl(dentry);
+		if (ret < 0)
+			return ret;
+		*policy = ret ? TRIMACL_POLICY_TRIM : TRIMACL_POLICY_POSIX;
+		return 0;
+	}
+
+	for (;;) {
+		bool posix_dir = false;
+
+		top = second = NULL;
+		rcu_read_lock();
+		seq = read_seqbegin(&rename_lock);
+		trimacl_top_dirs(dentry, &top, &second);
+		if (top && d_is_dir(top))
+			posix_dir = trimacl_is_posix_top_dir(top->d_name.name);
+		if (!read_seqretry(&rename_lock, seq)) {
+			rcu_read_unlock();
+			if (posix_dir)
+				goto posix;
+			break;
+		}
+		rcu_read_unlock();
+	}
+
+retry:
+	tflags = 0;
+	*policy = TRIMACL_POLICY_TRIM;
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	ret = 0;
+	for (d = dentry;; d = d->d_parent) {
+		inode = d_inode(d);
+		if (!inode) {
+			ret = -ESTALE;
+			break;
+		}
+		if (inode->i_op->get_trim_flags) {
+			switch (READ_ONCE(inode->i_trim_flags_state)) {
+			case TRIM_INODE_FLAGS_UNKNOWN:
+				/* Load the flags outside RCU and look again */
+				if (flags & MAY_NOT_BLOCK)
+					goto echild;
+				if (!lockref_get_not_dead(&d->d_lockref)) {
+					if (read_seqretry(&rename_lock, seq))
+						goto resched;
+					rcu_read_unlock();
+					return -ESTALE;
+				}
+				if (read_seqretry(&rename_lock, seq)) {
+					rcu_read_unlock();
+					dput(d);
+					cond_resched();
+					goto retry;
+				}
+				rcu_read_unlock();
+				if (!d_inode(d)) {
+					dput(d);
+					return -ESTALE;
+				}
+				ret = trim_inode_flags_load(d_inode(d), &tflags);
+				dput(d);
+				if (ret)
+					return ret;
+				goto retry;
+			case TRIM_INODE_FLAGS_CORRUPT:
+				ret = -EUCLEAN;
+				goto done;
+			case TRIM_INODE_FLAGS_UNSUPPORTED:
+				ret = -EOPNOTSUPP;
+				goto done;
+			}
+			tflags = atomic64_read(&inode->i_trim_flags);
+			if (tflags & TRIM_INODE_F_POSIX_ACL) {
+				*policy = TRIMACL_POLICY_POSIX;
+				break;
+			}
+		}
+		if (IS_ROOT(d))
+			break;
+	}
+done:
+	if (read_seqretry(&rename_lock, seq)) {
+		if (flags & MAY_NOT_BLOCK)
+			goto echild;
+resched:
+		rcu_read_unlock();
+		cond_resched();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+
+echild:
+	rcu_read_unlock();
+	return -ECHILD;
+
+posix:
+	*policy = TRIMACL_POLICY_POSIX;
+	return 0;
+}
+EXPORT_SYMBOL(trimacl_resolve_policy);
+
+static int trim_inode_flags_xattr_set(const struct xattr_handler *handler, struct mnt_idmap *idmap,
+				      struct dentry *dentry, struct inode *inode, const char *name,
+				      const void *value, size_t size, int flags)
+{
+	struct trim_inode_flags_xattr_v1 xattr = {};
+	const struct trim_inode_flags_xattr_v1 *in = value;
+	u64 new_flags = 0;
+	int ret;
+
+	if (!inode->i_op->set_trim_flags)
+		return -EOPNOTSUPP;
+	if (!capable(CAP_SYS_ADMIN) && vol_is_admin_or_homeowner(idmap, dentry) <= 0)
+		return -EPERM;
+
+	if (value) {
+		if (size < sizeof(*in))
+			return -EUCLEAN;
+		if (le16_to_cpu(in->version) != TRIM_INODE_FLAGS_XATTR_VERSION)
+			return -EOPNOTSUPP;
+		if (le16_to_cpu(in->size) != sizeof(*in) || size != sizeof(*in) || in->reserved)
+			return -EUCLEAN;
+		new_flags = le64_to_cpu(in->flags);
+		xattr.version = cpu_to_le16(TRIM_INODE_FLAGS_XATTR_VERSION);
+		xattr.size = cpu_to_le16(sizeof(xattr));
+		xattr.flags = cpu_to_le64(new_flags);
+		value = &xattr;
+		size = sizeof(xattr);
+	} else {
+		size = 0;
+	}
+
+	ret = inode->i_op->set_trim_flags(inode, value, size, flags);
+	if (ret)
+		return ret;
+
+	spin_lock(&inode->i_lock);
+	inode->i_trim_flags_generation++;
+	atomic64_set(&inode->i_trim_flags, new_flags);
+	inode->i_trim_flags_state = TRIM_INODE_FLAGS_VALID;
+	spin_unlock(&inode->i_lock);
+	return ret;
+}
+
+const struct xattr_handler trim_inode_flags_xattr_handler = {
+	.name = TRIM_INODE_FLAGS_XATTR,
+	.get = trim_inode_flags_xattr_get,
+	.set = trim_inode_flags_xattr_set,
+};
+EXPORT_SYMBOL(trim_inode_flags_xattr_handler);
+
