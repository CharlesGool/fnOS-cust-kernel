+/*
+ * @d is a mount point candidate in the system root: "/vol<N>" returns
+ * TRIM_VOL_TYPE_MOUNTED and copies "vol<N>" to @vol_id, "/vol00" is the
+ * external disk directory, other "/vol0*" are system disk volumes.
+ */
+unsigned int is_mount_on_vol_d(struct dentry *dentry, char *vol_id)
+{
+	struct dentry *d[2];
+	struct dentry *p;
+	const char *name;
+	unsigned int seq, ret;
+
+	if (!dentry || !sb_is_system_root(dentry->d_sb))
+		return 0;
+
+retry:
+	memset(d, 0, sizeof(d));
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	for (p = dentry; !IS_ROOT(p); p = READ_ONCE(p->d_parent)) {
+		d[1] = d[0];
+		d[0] = p;
+	}
+	ret = 0;
+	if (d[0]) {
+		name = d[0]->d_name.name;
+		if (!strncmp(name, "vol", 3) && is_str_num(name + 3)) {
+			if (name[3] == '0') {
+				ret = strcmp(name + 3, "00") ? TRIM_VOL_TYPE_SYSTEM : TRIM_VOL_TYPE_EXTERNAL;
+			} else {
+				ret = TRIM_VOL_TYPE_PATH;
+				if (!d[1] && strlen(name) < sizeof(((struct super_block *)0)->vol_path)) {
+					if (vol_id)
+						strcpy(vol_id, name);
+					ret = TRIM_VOL_TYPE_MOUNTED;
+				}
+			}
+		}
+	}
+	if (read_seqretry(&rename_lock, seq)) {
+		rcu_read_unlock();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+unsigned int is_mount_on_vol(struct inode *inode, char *vol_id)
+{
