+
+/*
+ * Trim syscalls.  fnOS user space reaches them through faccessat2() with a
+ * magic dfd, see sys_faccessat2().
+ */
+#define TRIM_SYSCALL_AT_FLAGS	(AT_EACCESS | AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)
+
+static inline unsigned int trim_syscall_lookup_flags(int flags)
+{
+	unsigned int lookup_flags = (flags & AT_SYMLINK_NOFOLLOW) ? 0 : LOOKUP_FOLLOW;
+
+	if (flags & AT_EMPTY_PATH)
+		lookup_flags |= LOOKUP_EMPTY;
+	return lookup_flags;
+}
+
+/* Set (AT_SET_SB_TRIM_RO) or clear the trim read-only flag of a mounted fs */
+long trim_syscall_set_ro_stat(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	struct mount *mnt;
+	unsigned int lookup_flags;
+	struct super_block *sb;
+
+	if (flags & ~(TRIM_SYSCALL_AT_FLAGS | AT_SET_SB_TRIM_RO))
+		return -EINVAL;
+
+	lookup_flags = trim_syscall_lookup_flags(flags);
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
+	if (user_path_at(dfd, filename, lookup_flags, &path))
+		return 0;
+
+	mnt = real_mount(path.mnt);
+	if (mnt && mnt->mnt_mountpoint && path.mnt && strcmp(mnt->mnt_mountpoint->d_name.name, "/") &&
+	    (sb = path.mnt->mnt_sb)) {
+		if (flags & AT_SET_SB_TRIM_RO)
+			sb->s_flags |= SB_TRIM_RO;
+		else
+			sb->s_flags &= ~SB_TRIM_RO;
+	}
+	path_put(&path);
+	return 0;
+}
+
+long trim_syscall_is_mountpoint(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	int error;
+	bool ret;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	error = user_path_at(dfd, filename, trim_syscall_lookup_flags(flags), &path);
+	if (unlikely(error))
+		return 0;
+	ret = IS_ROOT(path.dentry);
+	path_put(&path);
+	return ret;
+}
+
+long trim_syscall_is_trimacl(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	unsigned int lookup_flags;
+	struct inode *inode;
+	int error;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	lookup_flags = trim_syscall_lookup_flags(flags);
+retry:
+	error = user_path_at(dfd, filename, lookup_flags, &path);
+	if (error)
+		return error;
+	inode = d_inode(path.dentry);
+	if (unlikely(inode->i_op->is_trimacl))
+		error = inode->i_op->is_trimacl(path.dentry);
+	else
+		error = is_trimacl(path.dentry);
+	path_put(&path);
+	if (retry_estale(error, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+	return error;
+}
+
+long trim_syscall_realpath(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	struct trim_realpath_t rp;
+	unsigned int lookup_flags;
+	char *buf, *p;
+	int ret;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	memset(&rp, 0, sizeof(rp));
+	lookup_flags = trim_syscall_lookup_flags(flags);
+	if (copy_from_user(&rp, filename, sizeof(rp)))
+		return -EFAULT;
+
+	ret = user_path_at(dfd, rp.filename, lookup_flags, &path);
+	if (unlikely(ret))
+		goto out;
+
+	buf = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto out_path;
+	}
+	p = d_path(&path, buf, PATH_MAX);
+	if (IS_ERR(p)) {
+		ret = -ENOENT;
+		goto out_free;
+	}
+	ret = 0;
+	if (copy_to_user(rp.resolved, p, buf + PATH_MAX - p))
+		ret = -EFAULT;
+out_free:
+	kfree(buf);
+out_path:
+	path_put(&path);
+out:
+	return ret;
+}
+
+#define TRIM_SYSCALL_GIDS	128
+
+long trim_syscall_faccessat(int dfd, const char __user *filename, int mode, int flags)
+{
+	struct path path = {};
+	struct trim_access_t ta = {};
+	gid_t gids[TRIM_SYSCALL_GIDS] = {};
+	gid_t *kgids = NULL, *buf;
+	unsigned int lookup_flags, size;
+	struct inode *inode;
+	int res;
+
+	if ((mode & ~TRIM_PERM_FULL_CONTROL) || (flags & ~TRIM_SYSCALL_AT_FLAGS))
+		return -EINVAL;
+
+	lookup_flags = trim_syscall_lookup_flags(flags);
+	if (copy_from_user(&ta, filename, sizeof(ta)))
+		return -EFAULT;
+
+	if (!(ta.flags & TRIM_ACCESS_FLAG_CURRENT_USER)) {
+		/* checking another user's access */
+		if (!capable(CAP_SYS_ADMIN))
+			return -EPERM;
+		if (ta.gid_count < 1 || ta.gid_count > NGROUPS_MAX)
+			return -EINVAL;
+		size = ta.gid_count * sizeof(gid_t);
+		if (likely(size <= sizeof(gids))) {
+			buf = gids;
+		} else {
+			kgids = kmalloc(size, GFP_KERNEL);
+			if (!kgids)
+				return -ENOMEM;
+			buf = kgids;
+		}
+		if (copy_from_user(buf, (const void __user *)ta.gids, size)) {
+			if (kgids)
+				kfree(kgids);
+			return -EFAULT;
+		}
+		ta.gids = buf;
+	}
+
+retry:
+	res = user_path_at(dfd, ta.filename, lookup_flags, &path);
+	if (res)
+		goto out;
+
+	inode = d_inode(path.dentry);
+
+	if ((mode & MAY_EXEC) && S_ISREG(inode->i_mode)) {
+		res = -EACCES;
+		if (path_noexec(&path))
+			goto out_path_release;
+	}
+
+	if (unlikely(inode->i_op->trim_access))
+		res = inode->i_op->trim_access(mnt_idmap(path.mnt), path.dentry, mode | MAY_ACCESS, &ta);
+	else
+		res = trim_access(mnt_idmap(path.mnt), path.dentry, mode | MAY_ACCESS, &ta);
+	/* SuS v2 requires we report a read only fs too */
+	if (res || !(mode & TRIM_PERM_FULL_WRITABLE) || special_file(inode->i_mode))
+		goto out_path_release;
+	if (__mnt_is_readonly(path.mnt))
+		res = -EROFS;
+
+out_path_release:
+	path_put(&path);
+	if (retry_estale(res, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+out:
+	if (kgids)
+		kfree(kgids);
+	return res;
+}
+
+long trim_syscall_get_perm(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	struct trim_access_t ta = {};
+	gid_t gids[TRIM_SYSCALL_GIDS] = {};
+	gid_t *kgids = NULL, *buf;
+	unsigned int lookup_flags, size;
+	struct inode *inode;
+	int perm;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return 0;
+
+	lookup_flags = trim_syscall_lookup_flags(flags);
+	if (copy_from_user(&ta, filename, sizeof(ta)))
+		return 0;
+
+	if (!(ta.flags & TRIM_ACCESS_FLAG_CURRENT_USER)) {
+		/* querying another user's permission */
+		if (!capable(CAP_SYS_ADMIN))
+			return 0;
+		if (ta.gid_count < 1 || ta.gid_count > NGROUPS_MAX)
+			return 0;
+		size = ta.gid_count * sizeof(gid_t);
+		if (likely(size <= sizeof(gids))) {
+			buf = gids;
+		} else {
+			kgids = kmalloc(size, GFP_KERNEL);
+			if (!kgids)
+				return 0;
+			buf = kgids;
+		}
+		if (copy_from_user(buf, (const void __user *)ta.gids, size)) {
+			if (kgids)
+				kfree(kgids);
+			return 0;
+		}
+		ta.gids = buf;
+	}
+
+retry:
+	if (user_path_at(dfd, ta.filename, lookup_flags, &path)) {
+		perm = 0;
+		goto out;
+	}
+	inode = d_inode(path.dentry);
+	if (unlikely(inode->i_op->get_permission))
+		perm = inode->i_op->get_permission(mnt_idmap(path.mnt), path.dentry, &ta);
+	else
+		perm = get_permission(mnt_idmap(path.mnt), path.dentry, &ta);
+	path_put(&path);
+	if (retry_estale(perm, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+out:
+	if (kgids)
+		kfree(kgids);
+	return perm;
+}
+
+long trim_syscall_may_delete(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	struct trim_access_t ta = {};
+	gid_t gids[TRIM_SYSCALL_GIDS] = {};
+	gid_t *kgids = NULL, *buf;
+	unsigned int lookup_flags, size;
+	struct inode *inode;
+	int res;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	lookup_flags = trim_syscall_lookup_flags(flags);
+	if (copy_from_user(&ta, filename, sizeof(ta)))
+		return -EFAULT;
+
+	if (!(ta.flags & TRIM_ACCESS_FLAG_CURRENT_USER)) {
+		/* checking another user's access */
+		if (!capable(CAP_SYS_ADMIN))
+			return -EPERM;
+		if (ta.gid_count < 1 || ta.gid_count > NGROUPS_MAX)
+			return -EINVAL;
+		size = ta.gid_count * sizeof(gid_t);
+		if (likely(size <= sizeof(gids))) {
+			buf = gids;
+		} else {
+			kgids = kmalloc(size, GFP_KERNEL);
+			if (!kgids)
+				return -ENOMEM;
+			buf = kgids;
+		}
+		if (copy_from_user(buf, (const void __user *)ta.gids, size)) {
+			if (kgids)
+				kfree(kgids);
+			return -EFAULT;
+		}
+		ta.gids = buf;
+	}
+
+retry:
+	res = user_path_at(dfd, ta.filename, lookup_flags, &path);
+	if (res)
+		goto out;
+	inode = d_inode(path.dentry);
+	if (unlikely(inode->i_op->trim_access_delete))
+		res = inode->i_op->trim_access_delete(mnt_idmap(path.mnt), path.dentry, &ta);
+	else
+		res = trim_access_delete(mnt_idmap(path.mnt), path.dentry, &ta);
+	path_put(&path);
+	if (retry_estale(res, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+out:
+	if (kgids)
+		kfree(kgids);
+	return res;
+}
+
+long trim_syscall_set_external_disk_access(int mode)
+{
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	g_external_disk_access = mode;
+	return 0;
+}
+
+long trim_syscall_get_external_disk_access(void)
+{
+	return g_external_disk_access;
+}
+
+long trim_syscall_get_trimacl_xattr(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	struct trim_get_trimacl_xattr_t x;
+	unsigned int lookup_flags;
+	struct inode *inode;
+	int error;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	memset(&x, 0, sizeof(x));
+	lookup_flags = trim_syscall_lookup_flags(flags);
+	if (copy_from_user(&x, filename, sizeof(x)))
+		return -EFAULT;
+
+	if (x.flags & TRIM_GET_TRIMACL_XATTR_FLAG_FD) {
+		CLASS(fd_raw, f)(x.fd);
+		struct file *file;
+
+		if (fd_empty(f))
+			return -EBADF;
+		file = fd_file(f);
+		inode = d_inode(file->f_path.dentry);
+		if (unlikely(inode->i_op->get_trimacl_xattr_all))
+			return inode->i_op->get_trimacl_xattr_all(file_mnt_idmap(file), file->f_path.dentry, x.flags,
+								   x.buffer, x.buffer_size);
+		return trimacl_get_trimacl_xattr_all(file_mnt_idmap(file), file->f_path.dentry, x.flags,
+						     x.buffer, x.buffer_size);
+	}
+
+retry:
+	error = user_path_at(dfd, x.filename, lookup_flags, &path);
+	if (error)
+		return error;
+	inode = d_inode(path.dentry);
+	if (unlikely(inode->i_op->get_trimacl_xattr_all))
+		error = inode->i_op->get_trimacl_xattr_all(mnt_idmap(path.mnt), path.dentry, x.flags, x.buffer,
+							    x.buffer_size);
+	else
+		error = trimacl_get_trimacl_xattr_all(mnt_idmap(path.mnt), path.dentry, x.flags, x.buffer,
+						      x.buffer_size);
+	path_put(&path);
+	if (retry_estale(error, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+	return error;
+}
+
+long trim_syscall_get_posix_mode(int dfd, const char __user *filename, int flags)
+{
+	struct path path = {};
+	int error;
+
+	if (flags & ~TRIM_SYSCALL_AT_FLAGS)
+		return -EINVAL;
+
+	error = user_path_at(dfd, filename, trim_syscall_lookup_flags(flags), &path);
+	if (error)
+		goto out;
+	error = d_inode(path.dentry)->i_mode;
+	path_put(&path);
+out:
+	return error;
+}
