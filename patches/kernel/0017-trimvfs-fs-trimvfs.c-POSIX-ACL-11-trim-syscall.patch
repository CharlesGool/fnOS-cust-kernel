+}
+
+/*
+ * Permission check on a volume: administrators get full access, the
+ * system user and users in their own (read-only) home get read access,
+ * external disks are for administrators only unless enabled.
+ */
+int posixacl_access_permission_check_vol(struct mnt_idmap *idmap, struct inode *inode, int mask, int vol_type,
+					 struct trim_access_t *ta)
+{
+	unsigned int mode = inode->i_mode;
+
+	/* Traversing directories on a volume is always allowed */
+	if (S_ISDIR(mode))
+		mask &= ~MAY_EXEC;
+	if (!(mask & 7))
+		return 0;
+
+	if (TA_UID(ta) == TRIM_SYSTEM_UID)
+		goto read_access;
+
+	/* External disks are for administrators unless enabled for everyone */
+	if (vol_type == TRIM_VOL_TYPE_EXTERNAL && !g_external_disk_access &&
+	    !ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		return -EACCES;
+
+	if (!(ta && (ta->flags & TRIM_ACCESS_FLAG_IGNORE_ADMINS)) &&
+	    ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		goto full_access;
+	goto check;
+
+full_access:
+	if (S_ISDIR(inode->i_mode))
+		return 0;
+	mask &= ~(MAY_READ | MAY_WRITE);
+	goto check;
+
+read_access:
+	mask &= ~(MAY_READ | (S_ISDIR(mode) ? MAY_EXEC : 0));
+
+check:
+	if (!(mask & 7))
+		return 0;
+	return posixacl_mode_check(idmap, inode, mode, mask, ta);
+}
+
+int trim_access(struct mnt_idmap *idmap, struct dentry *dentry, int mode, struct trim_access_t *ta)
+{
+	if (IS_TRIMACL(dentry)) {
+		return trim_generic_permission_ta(idmap, dentry, mode | MAY_ACCESS, ta);
+	} else {
+		int mask = aclv2_mode_to_posix_mode(mode) | MAY_ACCESS;
+
+		return posixacl_access_permission_check(idmap, d_inode(dentry), mask, ta);
+	}
+}
+EXPORT_SYMBOL(trim_access);
+
+int trim_access_delete(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM, parent_policy = TRIMACL_POLICY_TRIM;
+	struct dentry *parent = dentry->d_parent;
+	int ret;
+
+	if (!IS_TRIMACL(dentry))
+		return posixacl_access_permission_check(idmap, d_inode(parent), MAY_WRITE | MAY_EXEC, ta);
+
+	ret = trimacl_resolve_policy(dentry, 0, &policy);
+	if (ret)
+		return ret;
+	if (policy == TRIMACL_POLICY_POSIX) {
+		if (!ta)
+			return inode_permission(idmap, d_inode(dentry->d_parent), MAY_WRITE | MAY_EXEC);
+		return posixacl_access_permission_check(idmap, d_inode(dentry->d_parent), MAY_WRITE | MAY_EXEC, ta);
+	}
+
+	ret = trimacl_resolve_policy(dentry->d_parent, 0, &parent_policy);
+	if (ret)
+		return ret;
+	if (parent_policy != TRIMACL_POLICY_POSIX) {
+		ret = trim_generic_permission_ta(idmap, dentry, MAY_DEL, ta);
+		if (!ret)
+			return 0;
+	}
+	return trim_generic_permission_ta(idmap, dentry->d_parent, MAY_DEL_CHILD, ta);
+}
+EXPORT_SYMBOL(trim_access_delete);
+
+int posixacl_access_permission_check(struct mnt_idmap *idmap, struct inode *inode, int mask, struct trim_access_t *ta)
+{
+	int vol_type = is_vol(inode);
+	int ret;
+
+	if (vol_type)
+		ret = posixacl_access_permission_check_vol(idmap, inode, mask, vol_type, ta);
+	else
+		ret = posixacl_mode_check(idmap, inode, inode->i_mode, mask, ta);
+	return ret;
+}
+
+/*
+ * The rwx bits @ta gets on @inode by mode bits / POSIX ACL and volume rules.
+ */
+unsigned int posixacl_get_permission(struct mnt_idmap *idmap, struct inode *inode, struct trim_access_t *ta)
+{
+	const struct posix_acl_entry *pa, *pe, *mask_obj;
+	unsigned int mode = inode->i_mode;
+	unsigned int perm = 0;
+	struct user_namespace *fs_userns;
+	struct posix_acl *acl;
+	vfsuid_t vfsuid;
+	vfsgid_t vfsgid;
+	bool is_dir;
+	int vol_type;
+
+	if (ta_is_root(idmap, inode, ta)) {
+		if (S_ISDIR(mode) || (mode & S_IXUGO))
+			return MAY_READ | MAY_WRITE | MAY_EXEC;
+		perm = MAY_READ | MAY_WRITE;
+		goto calc;
+	}
+
+	vol_type = is_vol(inode);
+	if (!vol_type)
+		goto calc;
+
+	/* Traversing directories on a volume is always allowed */
+	is_dir = S_ISDIR(inode->i_mode);
+	perm = is_dir ? MAY_EXEC : 0;
+
+	if (TA_UID(ta) == TRIM_SYSTEM_UID) {
+		perm |= MAY_READ;
+		goto calc;
+	}
+
+	if (vol_type == TRIM_VOL_TYPE_EXTERNAL && !g_external_disk_access &&
+	    !ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID))
+		return 0;
+
+	if (!(ta && (ta->flags & TRIM_ACCESS_FLAG_IGNORE_ADMINS)) &&
+	    ta_in_group(idmap, i_user_ns(inode), ta, TRIM_ADMIN_GID)) {
+		if (S_ISDIR(inode->i_mode) || is_dir)
+			return MAY_READ | MAY_WRITE | MAY_EXEC;
+		perm = MAY_READ | MAY_WRITE;
+	}
+
+calc:
+	vfsuid = i_uid_into_vfsuid(idmap, inode);
+	if (ta_vfsuid_eq(ta, vfsuid))
+		return perm | ((mode >> 6) & 7);
+
+	if (IS_POSIXACL(inode) && (mode & S_IRWXG)) {
+		acl = get_inode_acl(inode, ACL_TYPE_ACCESS);
+		if (IS_ERR(acl))
+			return perm;
+		if (acl) {
+			fs_userns = i_user_ns(inode);
+			FOREACH_ACL_ENTRY(pa, acl, pe) {
+				switch (pa->e_tag) {
+				case ACL_USER_OBJ:
+					vfsuid = i_uid_into_vfsuid(idmap, inode);
+					if (ta_vfsuid_eq(ta, vfsuid))
+						goto entry_perm;
+					break;
+				case ACL_USER:
+					vfsuid = make_vfsuid(idmap, fs_userns, pa->e_uid);
+					if (ta_vfsuid_eq(ta, vfsuid))
+						goto mask;
+					break;
+				case ACL_GROUP_OBJ:
+					vfsgid = i_gid_into_vfsgid(idmap, inode);
+					if (ta_vfsgid_in_group(ta, vfsgid))
+						goto mask;
+					break;
+				case ACL_GROUP:
+					vfsgid = make_vfsgid(idmap, fs_userns, pa->e_gid);
+					if (ta_vfsgid_in_group(ta, vfsgid))
+						goto mask;
+					break;
+				case ACL_MASK:
+					break;
+				case ACL_OTHER:
+					goto entry_perm;
+				default:
+					goto release;
+				}
+			}
+			goto release;
+mask:
+			for (mask_obj = pa + 1; mask_obj != pe; mask_obj++) {
+				if (mask_obj->e_tag == ACL_MASK) {
+					perm |= (unsigned short)(pa->e_perm & mask_obj->e_perm);
+					goto release;
+				}
+			}
+entry_perm:
+			perm |= pa->e_perm;
+release:
+			posix_acl_release(acl);
+			return perm;
+		}
+	}
+
+	if (mode ^ (mode >> 3)) {
+		vfsgid = i_gid_into_vfsgid(idmap, inode);
+		if (ta_vfsgid_in_group(ta, vfsgid))
+			return perm | ((mode >> 3) & 7);
+	}
+	return perm | (mode & 7);
+}
+
+int get_permission(struct mnt_idmap *idmap, struct dentry *dentry, struct trim_access_t *ta)
+{
+	if (!IS_TRIMACL(dentry))
+		return posixacl_get_permission(idmap, d_inode(dentry), ta);
+	return trimacl_get_permission(idmap, dentry, ta);
+}
+EXPORT_SYMBOL(get_permission);
+
+/*
+ * May the caller change owner/ACL on a volume?  1: administrator,
+ * 2: owner of the home directory on a mounted volume, 0: no.
+ */
+int vol_is_admin_or_homeowner(struct mnt_idmap *idmap, struct dentry *dentry)
+{
+	struct user_namespace *ns;
+	unsigned int uid;
+	int vol_type;
+
+	if (!dentry)
+		return 0;
+
+	vol_type = is_vol_d(dentry);
+	if (!vol_type)
+		return 0;
+
+	ns = i_user_ns(d_inode(dentry));
+	if (vfsgid_in_group_p(make_vfsgid(idmap, ns, make_kgid(ns, TRIM_ADMIN_GID))))
+		return 1;
+
+	uid = __kuid_val(current_fsuid());
+	if (vol_type == TRIM_VOL_TYPE_MOUNTED) {
+		char uid_str[16] = { 0 };
+
+		sprintf(uid_str, "%u", uid);
+		return may_user_dir_d(dentry, uid_str) == TRIM_USER_DIR_FULL ? 2 : 0;
+	}
+	return 0;
+}
