+/* fnOS Administrators group and system user (same values as trim_acl.c) */
+#define TRIM_ADMIN_GID		1000
+#define TRIM_SYSTEM_UID		712
+/* volume types */
+#define TRIM_VOL_TYPE_MOUNTED	0x1	/* /volN mounted volume */
+#define TRIM_VOL_TYPE_SYSTEM	0x2	/* /vol0X on the system disk */
+#define TRIM_VOL_TYPE_EXTERNAL	0x110	/* /vol00: external disks */
+#define TRIM_VOL_TYPE_PATH	0xffff	/* anywhere below /volN */
+/* is_user_dir_d() results */
+#define TRIM_USER_DIR_READONLY	0x01
+#define TRIM_USER_DIR_OTHER	0x02
+#define TRIM_USER_DIR_READ	0x11
+#define TRIM_USER_DIR_FULL	0x12
+
+#define TRIM_TEAM_DIR		"@team"
+#define TRIM_LOCAL_DIR		".@#local"
+#define TRIM_TRASH_DIR		"trash"
+#define TRIM_TRASHBIN_XATTR	"user.trim-trashbin"
+#define TRIM_TEAM_TRASHBIN_XATTR "user.trim-team-trashbin-access"
+
+int trim_trashbin(const char *path);
+
+unsigned int g_external_disk_access;
+
+static unsigned int trim_system_root_fs_seq;
+static struct super_block *trim_system_root_sb;
+static seqcount_t trim_system_root_cache_seq;
+static DEFINE_SPINLOCK(trim_system_root_cache_lock);
+
+#define TA_UID(ta)	(TA_NOT_CURRENT(ta) ? (ta)->uid : __kuid_val(current_fsuid()))
+
+static inline bool ta_vfsuid_eq(struct trim_access_t *ta, vfsuid_t vfsuid)
+{
+	return vfsuid_eq_kuid(vfsuid, KUIDT_INIT(TA_UID(ta)));
+}
+
+static inline bool ta_vfsgid_in_group(struct trim_access_t *ta, vfsgid_t vfsgid)
+{
+	if (TA_NOT_CURRENT(ta))
+		return trim_is_in_group(__vfsgid_val(vfsgid), ta->gid_count, ta->gids);
+	return vfsgid_in_group_p(vfsgid);
+}
+
+static inline bool ta_in_group(struct mnt_idmap *idmap, struct user_namespace *ns, struct trim_access_t *ta,
+			       gid_t gid)
+{
+	if (TA_NOT_CURRENT(ta))
+		return trim_is_in_group(gid, ta->gid_count, ta->gids);
+	return vfsgid_in_group_p(make_vfsgid(idmap, ns, make_kgid(ns, gid)));
+}
+
+static inline bool ta_is_root(struct mnt_idmap *idmap, struct inode *inode, struct trim_access_t *ta)
+{
+	return (!TA_NOT_CURRENT(ta) && capable_wrt_inode_uidgid(idmap, inode, CAP_DAC_OVERRIDE)) ||
+	       (TA_NOT_CURRENT(ta) && ta->uid == 0);
+}
+
+/*
+ * Deletions done by the file sharing daemons always go to the trashbin.
+ */
+bool trim_is_on_trashbin_whitelist(void)
+{
+	static char *while_list[] = { "smbd", "nfsd", "webdav", "smbftpd", NULL };
+	int i;
+
+	for (i = 0; while_list[i]; i++)
+		if (!strcmp(current->group_leader->comm, while_list[i]))
+			return true;
+	return false;
+}
+EXPORT_SYMBOL(trim_is_on_trashbin_whitelist);
+
+/*
+ * /@team/<team>/.@#local/trash/... -> returns a reference to /@team/<team>
+ */
+static struct dentry *is_in_team_trashbin_dir_and_return_teamdir_dentry(struct dentry *dentry)
+{
+	struct dentry *d[4];
+	struct dentry *p, *ret;
+	unsigned int seq;
+
+retry:
+	memset(d, 0, sizeof(d));
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	for (p = dentry; !IS_ROOT(p); p = p->d_parent) {
+		d[3] = d[2];
+		d[2] = d[1];
+		d[1] = d[0];
+		d[0] = p;
+	}
+	ret = NULL;
+	if (!d[0] || strcmp(d[0]->d_name.name, TRIM_TEAM_DIR))
+		goto out;
+	if (!d[2] || strcmp(d[2]->d_name.name, TRIM_LOCAL_DIR))
+		goto out;
+	if (!d[3] || strcmp(d[3]->d_name.name, TRIM_TRASH_DIR))
+		goto out;
+	if (!d[1])
+		goto out;
+	if (!lockref_get_not_dead(&d[1]->d_lockref)) {
+		rcu_read_unlock();
+		goto retry;
+	}
+	ret = d[1];
+out:
+	if (read_seqretry(&rename_lock, seq)) {
+		if (ret)
+			dput(ret);
+		rcu_read_unlock();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+int is_trimacl(struct dentry *dentry)
+{
+	enum trimacl_policy policy = TRIMACL_POLICY_TRIM;
+	int ret;
+
+	ret = trimacl_resolve_policy(dentry, 0, &policy);
+	if (ret)
+		return ret;
+	return policy == TRIMACL_POLICY_TRIM;
+}
+EXPORT_SYMBOL(is_trimacl);
+
+/*
+ * Is @sb the superblock of the system root (init's "/")?  The answer is
+ * cached against init_fs.seq once the system is running.
+ */
+static bool sb_is_system_root(struct super_block *sb)
+{
+	struct super_block *root_sb, *cached_sb;
+	struct vfsmount *mnt;
+	unsigned int seq, cseq, cached_seq;
+	bool ret = false, hit = false;
+
+	if (!sb)
+		goto out;
+
+	seq = read_seqbegin(&init_fs.seq);
+	if (system_state > SYSTEM_FREEING_INITMEM) {
+		do {
+			cseq = read_seqcount_begin(&trim_system_root_cache_seq);
+			cached_seq = trim_system_root_fs_seq;
+			cached_sb = trim_system_root_sb;
+		} while (read_seqcount_retry(&trim_system_root_cache_seq, cseq));
+		if (cached_seq == seq && cached_sb) {
+			ret = cached_sb == sb;
+			hit = true;
+		}
+	}
+	if (!read_seqretry(&init_fs.seq, seq) && hit)
+		return ret;
+
+	rcu_read_lock();
+	do {
+		seq = read_seqbegin(&init_fs.seq);
+		mnt = init_fs.root.mnt;
+		root_sb = mnt ? mnt->mnt_sb : NULL;
+	} while (read_seqretry(&init_fs.seq, seq));
+
+	if (!root_sb || root_sb->s_type == &rootfs_fs_type) {
+		ret = false;
+		goto out_unlock;
+	}
+	if (system_state > SYSTEM_FREEING_INITMEM && !read_seqretry(&init_fs.seq, seq)) {
+		spin_lock(&trim_system_root_cache_lock);
+		write_seqcount_begin(&trim_system_root_cache_seq);
+		trim_system_root_sb = root_sb;
+		trim_system_root_fs_seq = seq;
+		write_seqcount_end(&trim_system_root_cache_seq);
+		spin_unlock(&trim_system_root_cache_lock);
+	}
+	ret = sb == root_sb;
+out_unlock:
+	rcu_read_unlock();
+out:
+	return ret;
+}
+
+/*
+ * Top level directory of @dentry named @uid_str: the user's own home,
+ * other numeric top level directories: other users' homes.
+ */
+static int may_user_dir_d(struct dentry *dentry, const char *uid_str)
+{
+	struct dentry *top, *p;
+	struct inode *inode;
+	unsigned int seq;
+	int ret;
+
+retry:
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	p = dentry;
+	do {
+		top = p;
+		p = READ_ONCE(p->d_parent);
+	} while (!IS_ROOT(p));
+	ret = 0;
+	inode = top->d_inode;
+	if (inode) {
+		if (!strcmp(top->d_name.name, uid_str))
+			ret = uid_eq(inode->i_uid, GLOBAL_ROOT_UID) ? TRIM_USER_DIR_READ : TRIM_USER_DIR_FULL;
+		else if (is_str_num(top->d_name.name))
+			ret = uid_eq(inode->i_uid, GLOBAL_ROOT_UID) ? TRIM_USER_DIR_READONLY : TRIM_USER_DIR_OTHER;
+	}
+	if (read_seqretry(&rename_lock, seq)) {
+		rcu_read_unlock();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+/* Is @dentry below a top level "vol<N>" directory? */
+static unsigned int __d_is_vol_path(struct dentry *dentry)
+{
+	struct dentry *d[2];
+	struct dentry *p;
+	const char *name;
+	unsigned int seq, ret;
+
+retry:
+	memset(d, 0, sizeof(d));
+	rcu_read_lock();
+	seq = read_seqbegin(&rename_lock);
+	for (p = dentry; !IS_ROOT(p); p = READ_ONCE(p->d_parent)) {
+		d[1] = d[0];
+		d[0] = p;
+	}
+	ret = 0;
+	if (d[0]) {
+		name = d[0]->d_name.name;
+		if (!strncmp(name, "vol", 3) && is_str_num(name + 3))
+			ret = TRIM_VOL_TYPE_PATH;
+	}
+	if (read_seqretry(&rename_lock, seq)) {
+		rcu_read_unlock();
+		goto retry;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+int is_vol(struct inode *inode)
+{
+	struct dentry *dentry;
+	int ret;
+
+	if (!inode)
+		return 0;
+
+	if (inode->i_sb) {
+		ret = trim_mounts_query_by_sb(inode->i_sb, NULL);
+		if (likely(ret))
+			return ret;
+	}
+
+	if (likely(!sb_is_system_root(inode->i_sb)))
+		return 0;
+
+	spin_lock(&inode->i_lock);
+	hlist_for_each_entry(dentry, &inode->i_dentry, d_u.d_alias) {
+		ret = __d_is_vol_path(dentry);
+		if (ret) {
+			spin_unlock(&inode->i_lock);
+			return ret;
+		}
+	}
+	spin_unlock(&inode->i_lock);
+	return 0;
+}
+EXPORT_SYMBOL(is_vol);
+
+static noinline unsigned int is_vol_path_d(struct dentry *dentry)
+{
+	unsigned int ret;
+
+	if (!dentry)
+		return 0;
+	ret = __d_is_vol_path(dentry);
+	if (ret && dentry->d_inode && sb_is_system_root(dentry->d_inode->i_sb))
+		return ret;
+	return 0;
+}
+
+int is_vol_d(struct dentry *dentry)
+{
+	int ret;
+
+	if (!dentry)
+		return 0;
+
+	if (dentry->d_inode && dentry->d_inode->i_sb) {
+		ret = trim_mounts_query_by_sb(dentry->d_inode->i_sb, NULL);
+		if (likely(ret))
+			return ret;
+	}
+	return is_vol_path_d(dentry);
+}
+EXPORT_SYMBOL(is_vol_d);
+
+/*
+ * Should the removal of @dentry go to the trashbin?  Only for user homes
+ * (/<uid>/...) and team folders (/@team/<team>/...) on a mounted volume.
+ * On success *processed is set and the path is handed to the trashbin
+ * daemon; the caller then skips the real unlink/rmdir.
+ */
+int trim_do_trashbin(struct vfsmount *mnt, struct inode *dir, struct dentry *dentry, int is_dir,
+		     int trim_trashbin_flag, int *processed)
+{
+	char vol_id[256] = { 0 };
+	struct dentry *d[3];
+	struct dentry *p, *target, *parent;
+	struct mnt_idmap *idmap;
+	char value[8];
+	unsigned int seq;
+	char *buf, *path;
+	int err = 0, len;
+
+	*processed = 0;
+	if (!d_inode(dentry) || d_is_negative(dentry) || !d_inode(dentry)->i_sb)
+		return 0;
+
+	if (trim_mounts_query_by_sb(d_inode(dentry)->i_sb, vol_id) == TRIM_VOL_TYPE_MOUNTED) {
+		idmap = mnt_idmap(mnt);
+retry:
+		memset(d, 0, sizeof(d));
+		rcu_read_lock();
+		seq = read_seqbegin(&rename_lock);
+		for (p = dentry; !IS_ROOT(p); p = READ_ONCE(p->d_parent)) {
+			d[2] = d[1];
+			d[1] = d[0];
+			d[0] = p;
+		}
+		target = NULL;
+		if (!d[0] || !d[1])
+			goto nomatch;
+		if (!is_str_num(d[0]->d_name.name) || !strcmp(d[1]->d_name.name, TRIM_LOCAL_DIR)) {
+			if (!d[2] || strcmp(d[0]->d_name.name, TRIM_TEAM_DIR) ||
+			    !strcmp(d[2]->d_name.name, TRIM_LOCAL_DIR))
+				goto nomatch;
+		}
+		if (trim_trashbin_flag != 2) {
+			target = strcmp(d[0]->d_name.name, TRIM_TEAM_DIR) ? d[0] : d[1];
+			if (!lockref_get_not_dead(&target->d_lockref)) {
+				rcu_read_unlock();
+				goto retry;
+			}
+		}
+		if (read_seqretry(&rename_lock, seq)) {
+			rcu_read_unlock();
+			if (target)
+				dput(target);
+			goto retry;
+		}
+		rcu_read_unlock();
+
+		if (target) {
+			memset(value, 0, sizeof(value));
+			if (d_inode(target) &&
+			    __vfs_getxattr(target, d_inode(target), TRIM_TRASHBIN_XATTR, value, sizeof(value)) > 0 &&
+			    value[0] == '0') {
+				/* trashbin disabled for this home / team folder */
+				dput(target);
+				goto check;
+			}
+			dput(target);
+		}
+
+		inode_lock(dir);
+		parent = dget_parent(dentry);
+		if (!d_inode(dentry) || d_is_negative(dentry) || d_inode(parent) != dir) {
+			dput(parent);
+			inode_unlock(dir);
+			return 0;
+		}
+		*processed = 1;
+		err = origin_may_delete(mnt_idmap(mnt), dir, dentry, is_dir);
+		dput(parent);
+		inode_unlock(dir);
+		goto check;
+nomatch:
+		if (read_seqretry(&rename_lock, seq)) {
+			rcu_read_unlock();
+			goto retry;
+		}
+		rcu_read_unlock();
+	}
+check:
+	if (!*processed)
+		return 0;
+	if (err)
+		return err;
+
+	buf = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	path = dentry_path_raw(dentry, buf, PATH_MAX);
+	if (IS_ERR(path)) {
+		err = PTR_ERR(path);
+		goto out;
+	}
+	/* prepend "/<vol_id>" */
+	len = strlen(vol_id);
+	err = -ENAMETOOLONG;
+	if (path - (len + 1) < buf)
+		goto out;
+	path -= len;
+	memcpy(path, vol_id, len);
+	*--path = '/';
+	err = trim_trashbin(path);
+out:
+	kfree(buf);
+	return err;
+}
+EXPORT_SYMBOL(trim_do_trashbin);
+
+bool is_str_num(const char *str)
+{
+	if (!*str)
+		return false;
+	for (; *str; str++)
+		if (*str < '0' || *str > '9')
+			return false;
+	return true;
+}
+
+/*
+ * posix_acl_permission() checking the user of @ta instead of current.
+ */
+int posixacl_access_permission(struct mnt_idmap *idmap, struct inode *inode, const struct posix_acl *acl, int want,
+			       struct trim_access_t *ta)
+{
+	const struct posix_acl_entry *pa, *pe, *mask_obj;
+	struct user_namespace *fs_userns = i_user_ns(inode);
+	int found = 0;
+	vfsuid_t vfsuid;
+	vfsgid_t vfsgid;
+
+	want &= MAY_READ | MAY_WRITE | MAY_EXEC;
+
+	FOREACH_ACL_ENTRY(pa, acl, pe) {
+		switch (pa->e_tag) {
+		case ACL_USER_OBJ:
+			/* (May have been checked already) */
+			vfsuid = i_uid_into_vfsuid(idmap, inode);
+			if (ta_vfsuid_eq(ta, vfsuid))
+				goto check_perm;
+			break;
+		case ACL_USER:
+			vfsuid = make_vfsuid(idmap, fs_userns, pa->e_uid);
+			if (ta_vfsuid_eq(ta, vfsuid))
+				goto mask;
+			break;
+		case ACL_GROUP_OBJ:
+			vfsgid = i_gid_into_vfsgid(idmap, inode);
+			if (ta_vfsgid_in_group(ta, vfsgid)) {
+				found = 1;
+				if ((pa->e_perm & want) == want)
+					goto mask;
+			}
+			break;
+		case ACL_GROUP:
+			vfsgid = make_vfsgid(idmap, fs_userns, pa->e_gid);
+			if (ta_vfsgid_in_group(ta, vfsgid)) {
+				found = 1;
+				if ((pa->e_perm & want) == want)
+					goto mask;
+			}
+			break;
+		case ACL_MASK:
+			break;
+		case ACL_OTHER:
+			if (found)
+				return -EACCES;
+			else
+				goto check_perm;
+		default:
+			return -EIO;
+		}
+	}
+	return -EIO;
+
+mask:
+	for (mask_obj = pa + 1; mask_obj != pe; mask_obj++) {
+		if (mask_obj->e_tag == ACL_MASK) {
+			if ((pa->e_perm & mask_obj->e_perm & want) == want)
+				return 0;
+			return -EACCES;
+		}
+	}
+
+check_perm:
+	if ((pa->e_perm & want) == want)
+		return 0;
+	return -EACCES;
+}
+
+/* check_acl() for @ta */
+static int posixacl_access_check_acl(struct mnt_idmap *idmap, struct inode *inode, int mask, struct trim_access_t *ta)
+{
+	struct posix_acl *acl;
+
+	if (mask & MAY_NOT_BLOCK) {
+		acl = get_cached_acl_rcu(inode, ACL_TYPE_ACCESS);
+		if (!acl)
+			return -EAGAIN;
+		/* no ->get_inode_acl() calls in RCU mode... */
+		if (is_uncached_acl(acl))
+			return -ECHILD;
+		return posixacl_access_permission(idmap, inode, acl, mask, ta);
+	}
+
+	acl = get_inode_acl(inode, ACL_TYPE_ACCESS);
+	if (IS_ERR(acl))
+		return PTR_ERR(acl);
+	if (acl) {
+		int error = posixacl_access_permission(idmap, inode, acl, mask, ta);
+
+		posix_acl_release(acl);
+		return error;
+	}
+	return -EAGAIN;
+}
+
+/* acl_permission_check() for @ta, without the "no ACL, everybody allowed" shortcut */
+static __always_inline int posixacl_mode_check(struct mnt_idmap *idmap, struct inode *inode, unsigned int mode,
+					       int mask, struct trim_access_t *ta)
+{
+	vfsuid_t vfsuid;
+
+	/* Are we the owner? If so, ACL's don't matter */
+	vfsuid = i_uid_into_vfsuid(idmap, inode);
+	if (ta_vfsuid_eq(ta, vfsuid)) {
+		mask &= 7;
+		mode >>= 6;
+		return (mask & ~mode) ? -EACCES : 0;
+	}
+
+	/* Do we have ACL's? */
+	if (IS_POSIXACL(inode) && (mode & S_IRWXG)) {
+		int error = posixacl_access_check_acl(idmap, inode, mask, ta);
+
+		if (error != -EAGAIN)
+			return error;
+	}
+
+	/* Only RWX matters for group/other mode bits */
+	mask &= 7;
+
+	/*
+	 * Are the group permissions different from
+	 * the other permissions in the bits we care
+	 * about? Need to check group ownership if so.
+	 */
+	if (mask & (mode ^ (mode >> 3))) {
+		vfsgid_t vfsgid = i_gid_into_vfsgid(idmap, inode);
+
+		if (ta_vfsgid_in_group(ta, vfsgid))
+			mode >>= 3;
+	}
+
+	/* Bits in 'mode' clear that we require? */
+	return (mask & ~mode) ? -EACCES : 0;
+}
