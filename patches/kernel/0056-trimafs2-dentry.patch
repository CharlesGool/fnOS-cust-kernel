+/* 上层内部对象的编号, 跳过 0 */
+u64 trimafs2_alloc_internal_id(struct super_block *sb)
+{
+	struct trimafs2_fs_info *fsi = sb->s_fs_info;
+	u64 id = atomic64_inc_return(&fsi->next_internal_id);
+
+	if (!id)
+		id = atomic64_inc_return(&fsi->next_internal_id);
+	return id;
+}
+
+/*
+ * 下层 (branch_id, ino) -> 上层 inode 号.
+ * ino_mode=64: 能直接拼就拼 (branch_id << 33 | ino), 否则 siphash 并置位 32;
+ * ino_mode=32: 32 位 ino 乘以按分支散列出的奇数, 否则 siphash 折叠成 32 位.
+ */
+u64 trimafs2_map_ino(struct super_block *sb, u64 branch_id, u64 lower_ino)
+{
+	struct trimafs2_fs_info *fsi = sb->s_fs_info;
+	u64 h;
+	u32 ino;
+
+	if (fsi->mount_opts.ino_mode == TRIMAFS2_INO_MODE_64) {
+		if (branch_id <= 0x7fffffff && !(lower_ino >> 32)) {
+			this_cpu_inc(trimafs2_ino_stats.ino64_direct);
+			return branch_id << 33 | lower_ino;
+		}
+		this_cpu_inc(trimafs2_ino_stats.ino64_fallback);
+		return siphash_2u64(branch_id, lower_ino, &fsi->ino_hash_key) | BIT_ULL(32);
+	}
+
+	if (lower_ino - 1 <= 0xfffffffeULL) {
+		this_cpu_inc(trimafs2_ino_stats.ino32_direct);
+		return (u32)lower_ino * (hash_64(branch_id ^ fsi->ino_mix_seed, 32) | 1);
+	}
+
+	this_cpu_inc(trimafs2_ino_stats.ino32_fallback);
+	h = siphash_2u64(branch_id, lower_ino, &fsi->ino_hash_key);
+	ino = (u32)h ^ (u32)(h >> 32);
+	if (!ino)
+		ino = (u32)h ?: 1;
+	return ino;
+}
+
+u64 trimafs2_dentry_ino(struct dentry *dentry)
+{
+	struct trimafs2_dentry_info *di = TRIMAFS2_D(dentry);
+	struct inode *inode = d_inode(dentry);
+
+	if (!inode)
+		return 0;
+	if (di && di->lower_dentry && di->branch && d_inode(di->lower_dentry))
+		return trimafs2_map_ino(dentry->d_sb, di->branch->branch_id,
+					d_inode(di->lower_dentry)->i_ino);
+	return inode->i_ino;
+}
+
+/* 上层目录和桥要一直留在 dcache 里, 额外持有一个引用 */
+void trimafs2_pin_dentry(struct dentry *dentry)
+{
+	struct trimafs2_fs_info *fsi = dentry->d_sb->s_fs_info;
+	struct trimafs2_dentry_info *di = TRIMAFS2_D(dentry);
+
+	if (WARN_ON_ONCE(!di))
+		return;
+
+	dget(dentry);
+	spin_lock(&fsi->pinned_lock);
+	if (WARN_ON_ONCE(di->pinned)) {
+		spin_unlock(&fsi->pinned_lock);
+		dput(dentry);
+		return;
+	}
+	di->pinned = true;
+	list_add(&di->pinned_node, &fsi->pinned_dentries);
+	spin_unlock(&fsi->pinned_lock);
+}
+
+/* 摘掉 pin 标记(不放引用), 返回原来是否 pin 着 */
+bool trimafs2_forget_dentry_pin(struct dentry *dentry)
+{
+	struct trimafs2_dentry_info *di = TRIMAFS2_D(dentry);
+	struct trimafs2_fs_info *fsi;
+	bool pinned;
+
+	if (!di)
+		return false;
+
+	fsi = dentry->d_sb->s_fs_info;
+	spin_lock(&fsi->pinned_lock);
+	pinned = di->pinned;
+	if (pinned) {
+		list_del_init(&di->pinned_node);
+		di->pinned = false;
+	}
+	spin_unlock(&fsi->pinned_lock);
+	return pinned;
+}
+
+void trimafs2_repin_dentry(struct dentry *dentry)
+{
+	struct trimafs2_dentry_info *di = TRIMAFS2_D(dentry);
+	struct trimafs2_fs_info *fsi;
+
+	if (!di)
+		return;
+
+	fsi = dentry->d_sb->s_fs_info;
+	spin_lock(&fsi->pinned_lock);
+	if (!di->pinned) {
+		di->pinned = true;
+		list_add(&di->pinned_node, &fsi->pinned_dentries);
+	}
+	spin_unlock(&fsi->pinned_lock);
+}
+
+void trimafs2_drop_pinned_dentries(struct super_block *sb)
+{
+	struct trimafs2_fs_info *fsi = sb->s_fs_info;
+
+	spin_lock(&fsi->pinned_lock);
+	while (!list_empty(&fsi->pinned_dentries)) {
+		struct trimafs2_dentry_info *di;
+		struct dentry *dentry;
+
+		di = list_first_entry(&fsi->pinned_dentries, struct trimafs2_dentry_info,
+				      pinned_node);
+		dentry = di->dentry;
+		list_del_init(&di->pinned_node);
+		di->pinned = false;
+		spin_unlock(&fsi->pinned_lock);
+		dput(dentry);
+		spin_lock(&fsi->pinned_lock);
+	}
+	spin_unlock(&fsi->pinned_lock);
+}
+
+void trimafs2_kill_sb(struct super_block *sb)
+{
+	trimafs2_destroy_branches(sb);
+	trimafs2_drop_pinned_dentries(sb);
+	kill_anon_super(sb);
+	if (sb->s_fs_info)
+		kfree(sb->s_fs_info);
+}
+
+static struct file_system_type trimafs2_fs_type = {
+	.owner			= THIS_MODULE,
+	.name			= "trimafs",
+	.init_fs_context	= trimafs2_init_fs_context,
+	.parameters		= trimafs2_fs_parameters,
+	.kill_sb		= trimafs2_kill_sb,
+	.fs_flags		= FS_USERNS_MOUNT,
+};
+MODULE_ALIAS_FS("trimafs");
+
+static const struct file_operations trimafs2_stats_fops = {
+	.owner		= THIS_MODULE,
+	.open		= trimafs2_stats_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int __init init_trimafs2_fs(void)
+{
+	int err;
+
+	trimafs2_inode_cachep = kmem_cache_create("trimafs2_inode",
+						  sizeof(struct trimafs2_inode_info), 0,
+						  SLAB_RECLAIM_ACCOUNT | SLAB_ACCOUNT,
+						  trimafs2_init_once);
+	if (!trimafs2_inode_cachep)
+		return -ENOMEM;
+
+	atomic64_set(&trimafs2_inode_count, 0);
+	atomic64_set(&trimafs2_inode_free_deferred, 0);
+	atomic64_set(&trimafs2_inode_free_done, 0);
+	atomic64_set(&trimafs2_dentry_path_release_queued, 0);
+	atomic64_set(&trimafs2_dentry_path_release_done, 0);
+
+	debugfs_create_u32("trimafs2_debug_print_level", 0644, NULL, &trimafs2_debug_level);
+	debugfs_create_file("trimafs2_stats", 0444, NULL, NULL, &trimafs2_stats_fops);
+
+	err = register_filesystem(&trimafs2_fs_type);
+	if (err) {
+		debugfs_lookup_and_remove("trimafs2_debug_print_level", NULL);
+		debugfs_lookup_and_remove("trimafs2_stats", NULL);
+		rcu_barrier();
+		kmem_cache_destroy(trimafs2_inode_cachep);
+	}
+	return err;
+}
+
+static void __exit exit_trimafs2_fs(void)
+{
+	unregister_filesystem(&trimafs2_fs_type);
+	debugfs_lookup_and_remove("trimafs2_debug_print_level", NULL);
+	debugfs_lookup_and_remove("trimafs2_stats", NULL);
+	rcu_barrier();
+	kmem_cache_destroy(trimafs2_inode_cachep);
+}
+
+MODULE_DESCRIPTION("TRIM aggregate stacking filesystem");
+MODULE_AUTHOR("TRIM");
+MODULE_LICENSE("GPL");
+
+module_init(init_trimafs2_fs);
+module_exit(exit_trimafs2_fs);
