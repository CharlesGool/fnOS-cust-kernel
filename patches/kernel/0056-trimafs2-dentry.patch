+	.destroy_inode	= trimafs2_destroy_inode,
+	.drop_inode	= inode_just_drop,
+	.evict_inode	= trimafs2_evict_inode,
+	.sync_fs	= trimafs2_sync_fs,
+	.statfs		= trimafs2_statfs,
+	.show_options	= trimafs2_show_options,
+};
