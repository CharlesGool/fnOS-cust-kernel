+/* 同步所有下层文件系统(同一个下层超级块只同步一次) */
+static int trimafs2_sync_fs(struct super_block *sb, int wait)
+{
+	struct trimafs2_fs_info *fsi = sb->s_fs_info;
+	struct vfsmount **mnts;
+	unsigned long index = 0;
+	unsigned int nr = 0, i;
+	int err = 0;
+
+	if (!wait)
+		return 0;
+
+	mnts = kcalloc(TRIMAFS2_MAX_SYNC_MNTS, sizeof(*mnts), GFP_KERNEL);
+	if (!mnts)
+		return -ENOMEM;
+
+	for (;;) {
+		struct trimafs2_branch *branch;
+		struct vfsmount *mnt;
+
+		xa_lock(&fsi->branches);
+		branch = xa_find(&fsi->branches, &index, ULONG_MAX, XA_PRESENT);
+		if (!branch) {
+			xa_unlock(&fsi->branches);
+			break;
+		}
+		index++;
+		if (!refcount_inc_not_zero(&branch->refs)) {
+			xa_unlock(&fsi->branches);
+			continue;
+		}
+		mnt = mntget(branch->lower_mnt);
+		xa_unlock(&fsi->branches);
+		trimafs2_branch_put(branch);
+
+		for (i = 0; i < nr; i++)
+			if (mnts[i]->mnt_sb == mnt->mnt_sb)
+				break;
+		if (i < nr) {
+			mntput(mnt);
+			continue;
+		}
+		if (nr == TRIMAFS2_MAX_SYNC_MNTS) {
+			mntput(mnt);
+			err = -E2BIG;
+			break;
+		}
+		mnts[nr++] = mnt;
+	}
+
+	for (i = 0; i < nr; i++) {
+		struct super_block *lower_sb = mnts[i]->mnt_sb;
+		int ret;
+
+		down_read(&lower_sb->s_umount);
+		ret = sync_filesystem(lower_sb);
+		up_read(&lower_sb->s_umount);
+		if (ret && !err)
+			err = ret;
+		mntput(mnts[i]);
+	}
+	kfree(mnts);
+	return err;
+}
+
+static const struct fs_context_operations trimafs2_context_ops = {
+	.free		= trimafs2_free_fc,
+	.parse_param	= trimafs2_parse_param,
+	.get_tree	= trimafs2_get_tree,
+};
+
+int trimafs2_init_fs_context(struct fs_context *fc)
+{
+	struct trimafs2_fs_info *fsi;
+
+	fsi = kzalloc(sizeof(*fsi), GFP_KERNEL);
+	if (!fsi)
+		return -ENOMEM;
+
+	fsi->mount_opts.mode = 0777;
+	fsi->mount_opts.trimacl = false;
+	fsi->mount_opts.ino_mode = TRIMAFS2_INO_MODE_32;
+	atomic64_set(&fsi->next_branch_id, 0);
+	atomic64_set(&fsi->next_internal_id, 0);
+	fsi->fh_gen = get_random_u32() ?: 1;
+	get_random_bytes(&fsi->ino_hash_key, sizeof(fsi->ino_hash_key));
+	fsi->ino_mix_seed = get_random_u64();
+	xa_init(&fsi->branches);
+	spin_lock_init(&fsi->stack_depth_lock);
+	spin_lock_init(&fsi->pinned_lock);
+	INIT_LIST_HEAD(&fsi->pinned_dentries);
+
+	fc->s_fs_info = fsi;
+	fc->ops = &trimafs2_context_ops;
+	return 0;
+}
+
+/*
+ * 桥: 直接返回下层的 statfs; 上层非目录: 返回内存文件系统的值;
+ * 上层目录: 遍历其下所有桥, 把各个下层文件系统的容量相加.
+ */
+static int trimafs2_statfs(struct dentry *dentry, struct kstatfs *buf)
+{
+	struct trimafs2_statfs_sum *sum;
+	struct trimafs2_statfs_frame *stack;
+	struct path lower_path;
+	unsigned int depth = 0, i;
+	int err;
+
+	if (trimafs2_has_lower(dentry)) {
+		lower_path = (struct path){};
+		trimafs2_get_lower_path(dentry, &lower_path);
+		err = vfs_statfs(&lower_path, buf);
+		path_put(&lower_path);
+		if (!err)
+			buf->f_type = TRIMAFS2_SUPER_MAGIC;
+		return err;
+	}
+
+	if (!d_is_dir(dentry)) {
+		buf->f_type = TRIMAFS2_SUPER_MAGIC;
+		buf->f_bsize = PAGE_SIZE;
+		buf->f_frsize = PAGE_SIZE;
+		buf->f_namelen = NAME_MAX;
+		buf->f_files = atomic64_read(&trimafs2_inode_count);
+		return 0;
+	}
+
+	sum = kzalloc(sizeof(*sum), GFP_KERNEL);
+	if (!sum)
+		return -ENOMEM;
+	stack = kcalloc(TRIMAFS2_MAX_STATFS_DEPTH, sizeof(*stack), GFP_KERNEL);
+	if (!stack) {
+		err = -ENOMEM;
+		goto out_sum;
+	}
+
+	stack[0].parent = dget(dentry);
+	for (;;) {
+		struct trimafs2_statfs_frame *frame = &stack[depth];
+		struct dentry *parent = frame->parent;
+		struct dentry *child;
+		bool found = !frame->cursor;
+
+		spin_lock(&parent->d_lock);
+		hlist_for_each_entry(child, &parent->d_children, d_sib) {
+			if (child == frame->cursor) {
+				found = true;
+				continue;
+			}
+			if (!found)
+				continue;
+			spin_lock(&child->d_lock);
+			if (d_really_is_negative(child)) {
+				spin_unlock(&child->d_lock);
+				continue;
+			}
+			dget_dlock(child);
+			spin_unlock(&child->d_lock);
+			spin_unlock(&parent->d_lock);
+			dput(frame->cursor);
+			frame->cursor = child;
+			goto visit;
+		}
+		spin_unlock(&parent->d_lock);
+
+		if (frame->cursor && !found) {
+			/* 游标已经离开父目录, 从头重扫这一层 */
+			dput(frame->cursor);
+			frame->cursor = NULL;
+			continue;
+		}
+
+		dput(frame->cursor);
+		dput(frame->parent);
+		frame->cursor = NULL;
+		frame->parent = NULL;
+		if (!depth)
+			break;
+		depth--;
+		continue;
+
+visit:
+		if (trimafs2_has_lower(child)) {
+			lower_path = (struct path){};
+			trimafs2_get_lower_path(child, &lower_path);
+			err = trimafs2_statfs_add_lower(sum, &lower_path);
+			path_put(&lower_path);
+			if (err)
+				goto out_unwind;
+		} else if (d_is_dir(child)) {
+			if (depth + 1 >= TRIMAFS2_MAX_STATFS_DEPTH) {
+				err = -ELOOP;
+				goto out_unwind;
+			}
+			depth++;
+			stack[depth].parent = dget(child);
+			stack[depth].cursor = NULL;
+		}
+	}
+	kfree(stack);
+
+	buf->f_type = TRIMAFS2_SUPER_MAGIC;
+	buf->f_bsize = PAGE_SIZE;
+	buf->f_blocks = sum->bytes_total >> PAGE_SHIFT;
+	buf->f_bfree = sum->bytes_free >> PAGE_SHIFT;
+	buf->f_bavail = sum->bytes_avail >> PAGE_SHIFT;
+	buf->f_files = sum->files ?: atomic64_read(&trimafs2_inode_count);
+	buf->f_ffree = sum->ffree;
+	buf->f_namelen = NAME_MAX;
+	buf->f_frsize = PAGE_SIZE;
+	kfree(sum);
+	return 0;
+
+out_unwind:
+	for (i = 0; i <= depth; i++) {
+		dput(stack[i].cursor);
+		dput(stack[i].parent);
+	}
+	kfree(stack);
+out_sum:
+	kfree(sum);
+	return err;
+}
+
+static const struct super_operations trimafs2_sops = {
