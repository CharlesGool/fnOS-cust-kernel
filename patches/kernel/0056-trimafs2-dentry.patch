+static const struct super_operations trimafs2_sops;
+
+static int trimafs2_fill_super(struct super_block *sb, struct fs_context *fc)
+{
+	struct trimafs2_fs_info *fsi = sb->s_fs_info;
+	struct inode *inode;
+
+	sb->s_maxbytes = MAX_LFS_FILESIZE;
+	sb->s_iflags |= SB_I_SKIP_SYNC;
+	sb->s_blocksize = PAGE_SIZE;
+	sb->s_blocksize_bits = PAGE_SHIFT;
+	sb->s_magic = TRIMAFS2_SUPER_MAGIC;
+	sb->s_op = &trimafs2_sops;
+	sb->s_export_op = &trimafs2_export_ops;
+	sb->s_time_gran = 1;
+	sb->s_stack_depth = 1;
+	sb->s_flags |= SB_POSIXACL;
+	if (fsi->mount_opts.trimacl)
+		sb->s_flags |= SB_TRIMACL;
+	sb->s_xattr = trimafs2_xattr_handlers;
+	set_default_d_op(sb, &trimafs2_dops);
+	sb->s_d_flags |= DCACHE_DONTCACHE;
+
+	inode = trimafs2_get_inode(sb, NULL, S_IFDIR | fsi->mount_opts.mode, 0);
+	if (!inode)
+		return -ENOMEM;
+	sb->s_root = d_make_root(inode);
+	if (!sb->s_root)
+		return -ENOMEM;
+	return 0;
+}
+
+static int trimafs2_show_options(struct seq_file *m, struct dentry *root)
+{
+	struct trimafs2_fs_info *fsi = root->d_sb->s_fs_info;
+
+	if (fsi->mount_opts.mode != 0777)
+		seq_printf(m, ",mode=%o", fsi->mount_opts.mode);
+	if (fsi->mount_opts.trimacl)
+		seq_puts(m, ",trimacl");
+	seq_printf(m, ",ino_mode=%u",
+		   fsi->mount_opts.ino_mode == TRIMAFS2_INO_MODE_32 ? 32 : 64);
+	return 0;
+}
+
+/* 每个下层超级块只累计一次 */
+static int trimafs2_statfs_add_lower(struct trimafs2_statfs_sum *sum, const struct path *path)
+{
+	struct super_block *sb = path->dentry->d_sb;
+	struct kstatfs st = {};
+	int i, err;
+
+	for (i = 0; i < TRIMAFS2_MAX_STATFS_SB; i++) {
+		if (sum->seen[i] == sb)
+			return 0;
+		if (!sum->seen[i])
+			break;
+	}
+	if (i == TRIMAFS2_MAX_STATFS_SB)
+		return -E2BIG;
+	sum->seen[i] = sb;
+
+	err = vfs_statfs(path, &st);
+	if (err)
+		return err;
+	sum->bytes_free += st.f_bfree * st.f_frsize;
+	sum->bytes_total += st.f_blocks * st.f_frsize;
+	sum->bytes_avail += st.f_bavail * st.f_frsize;
+	sum->files += st.f_files;
+	sum->ffree += st.f_ffree;
+	return 0;
+}
+
+static void trimafs2_free_fc(struct fs_context *fc)
+{
+	struct trimafs2_fs_info *fsi = fc->s_fs_info;
+
+	if (fsi)
+		kfree(fsi);
+}
+
+static void trimafs2_evict_inode(struct inode *inode)
+{
+	struct trimafs2_inode_info *ii = TRIMAFS2_I(inode);
+	struct inode *lower_inode = ii->lower_inode;
+
+	truncate_inode_pages_final(&inode->i_data);
+	clear_inode(inode);
+	if (lower_inode) {
+		ii->lower_inode = NULL;
+		iput(lower_inode);
+	}
+	ii->branch_id = 0;
+	ii->internal_id = 0;
+	ii->lower_dev = 0;
+	ii->lower_ino = 0;
+	ii->lower_generation = 0;
+	ii->lower_type = 0;
+}
+
+static void trimafs2_free_inode_rcu(struct rcu_head *rcu)
+{
+	struct trimafs2_inode_info *ii = container_of(rcu, struct trimafs2_inode_info, rcu);
+
+	atomic64_dec(&trimafs2_inode_count);
+	atomic64_inc(&trimafs2_inode_free_done);
+	kmem_cache_free(trimafs2_inode_cachep, ii);
+}
+
+static void trimafs2_destroy_inode(struct inode *inode)
+{
+	atomic64_inc(&trimafs2_inode_free_deferred);
+	call_rcu(&TRIMAFS2_I(inode)->rcu, trimafs2_free_inode_rcu);
+}
+
+static struct inode *trimafs2_alloc_inode(struct super_block *sb)
+{
+	struct trimafs2_inode_info *ii;
+
+	ii = alloc_inode_sb(sb, trimafs2_inode_cachep, GFP_KERNEL);
+	if (!ii)
+		return NULL;
+	ii->branch_id = 0;
+	ii->internal_id = 0;
+	ii->lower_dev = 0;
+	ii->lower_ino = 0;
+	ii->lower_generation = 0;
+	ii->lower_type = 0;
+	ii->lower_inode = NULL;
+	atomic64_inc(&trimafs2_inode_count);
+	return &ii->vfs_inode;
+}
+
+static const struct constant_table trimafs2_ino_mode_values[] = {
+	{ "32", TRIMAFS2_INO_MODE_32 },
+	{ "64", TRIMAFS2_INO_MODE_64 },
+	{}
+};
+
+const struct fs_parameter_spec trimafs2_fs_parameters[] = {
+	fsparam_u32oct("mode", Opt_mode),
+	fsparam_flag("trimacl", Opt_trimacl),
+	fsparam_enum("ino_mode", Opt_ino, trimafs2_ino_mode_values),
+	{}
+};
+
+static int trimafs2_parse_param(struct fs_context *fc, struct fs_parameter *param)
+{
+	struct trimafs2_fs_info *fsi = fc->s_fs_info;
+	struct fs_parse_result result;
+	int opt;
+
+	opt = fs_parse(fc, trimafs2_fs_parameters, param, &result);
+	if (opt == -ENOPARAM) {
+		opt = vfs_parse_fs_param_source(fc, param);
+		if (opt == -ENOPARAM)
+			return -EINVAL;
+		return opt;
+	}
+	if (opt < 0)
+		return opt;
+
+	switch (opt) {
+	case Opt_mode:
+		fsi->mount_opts.mode = result.uint_32 & S_IALLUGO;
+		break;
+	case Opt_trimacl:
+		fsi->mount_opts.trimacl = true;
+		break;
+	case Opt_ino:
+		fsi->mount_opts.ino_mode = result.uint_32;
+		break;
+	}
+	return 0;
+}
+
+static int trimafs2_stats_show(struct seq_file *m, void *v)
+{
+	u64 ino32_direct = 0, ino32_fallback = 0, ino64_direct = 0, ino64_fallback = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct trimafs2_ino_stats *st = per_cpu_ptr(&trimafs2_ino_stats, cpu);
+
+		ino32_direct += st->ino32_direct;
+		ino32_fallback += st->ino32_fallback;
+		ino64_direct += st->ino64_direct;
+		ino64_fallback += st->ino64_fallback;
+	}
+
+	seq_printf(m, "inode_count %lld\n", atomic64_read(&trimafs2_inode_count));
+	seq_printf(m, "dentry_path_release_queued %lld\n",
+		   atomic64_read(&trimafs2_dentry_path_release_queued));
+	seq_printf(m, "dentry_path_release_done %lld\n",
+		   atomic64_read(&trimafs2_dentry_path_release_done));
+	seq_printf(m, "inode_free_deferred %lld\n", atomic64_read(&trimafs2_inode_free_deferred));
+	seq_printf(m, "inode_free_done %lld\n", atomic64_read(&trimafs2_inode_free_done));
+	seq_printf(m, "ino32_direct %llu\n", ino32_direct);
+	seq_printf(m, "ino32_fallback %llu\n", ino32_fallback);
+	seq_printf(m, "ino64_direct %llu\n", ino64_direct);
+	seq_printf(m, "ino64_fallback %llu\n", ino64_fallback);
+	seq_printf(m, "release_pending %lld\n",
+		   atomic64_read(&trimafs2_dentry_path_release_queued) -
+		   atomic64_read(&trimafs2_dentry_path_release_done));
+	seq_printf(m, "inode_free_pending %lld\n",
+		   atomic64_read(&trimafs2_inode_free_deferred) -
+		   atomic64_read(&trimafs2_inode_free_done));
+	seq_printf(m, "release_max_active %u\n", trimafs2_release_max_active);
+	return 0;
+}
+
+static int trimafs2_stats_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, trimafs2_stats_show, inode->i_private);
+}
