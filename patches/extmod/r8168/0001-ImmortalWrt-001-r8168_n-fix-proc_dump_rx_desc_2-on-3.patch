---
 src/r8168_n.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/r8168_n.c b/src/r8168_n.c
index fa691d8..de8570e 100755
--- a/src/r8168_n.c
+++ b/src/r8168_n.c
@@ -1671,9 +1671,9 @@ static int proc_dump_rx_desc_2(struct seq_file *m, void *v)
                                                           j, k);
                         for (i=0; i<(tp->RxDescLength/4); i++) {
                                 if (!(i % 4))
-                                        seq_printf(m, "\n%04llx ",
-                                                   ((u64)pdword + (i * 4) -
-                                                    (u64)tp->RxDescArray));
+                                        seq_printf(m, "\n%04x ",
+                                                   (u32) ((uintptr_t)pdword + (i * 4) -
+                                                    (uintptr_t)tp->RxDescArray));
                                 seq_printf(m, "%08x ", pdword[i]);
                         }
                 }
