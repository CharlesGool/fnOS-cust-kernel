ImmortalWrt 的 110 补丁基于带 tp->enable_giga_lite 成员的版本, 8.056.02 里
Giga Lite 开关是全局变量 eee_giga_lite, rtl8168_phy_speed 不再需要 tp 参数。

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/r8168_n.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/r8168_n.c b/src/r8168_n.c
index 0010004..c452b01 100755
--- a/src/r8168_n.c
+++ b/src/r8168_n.c
@@ -5543,7 +5543,7 @@ static unsigned int rtl8168_phy_duplex(u8 status)
         return duplex;
 }
 
-static int rtl8168_phy_speed(struct rtl8168_private *tp, u8 status)
+static int rtl8168_phy_speed(u8 status)
 {
         int speed = SPEED_UNKNOWN;
 
@@ -5554,7 +5554,7 @@ static int rtl8168_phy_speed(struct rtl8168_private *tp, u8 status)
                         speed = SPEED_100;
                 else if (status & _10bps)
                         speed = SPEED_10;
-                else if (tp->enable_giga_lite)
+                else if (eee_giga_lite)
                         speed = SPEED_1000;
         }
 
@@ -5583,7 +5583,7 @@ rtl8168_check_link_status(struct net_device *dev)
                         if (netif_msg_ifup(tp)) {
                                 const u8 phy_status = RTL_R8(tp, PHYstatus);
                                 const unsigned int phy_duplex = rtl8168_phy_duplex(phy_status);
-                                const int phy_speed = rtl8168_phy_speed(tp, phy_status);
+                                const int phy_speed = rtl8168_phy_speed(phy_status);
                                 printk(KERN_INFO PFX "%s: Link is Up - %s/%s\n",
                                        dev->name,
                                        phy_speed_to_str(phy_speed),
