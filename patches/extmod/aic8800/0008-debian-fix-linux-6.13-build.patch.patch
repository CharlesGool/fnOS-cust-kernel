来自 radxa-pkg/aic8800 的 debian/patches(跳过固件路径相关补丁, 飞牛用 /lib/firmware/aic8800/{sdio,usb})

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../driver/aic8800/aic8800_fdrv/rwnx_main.c       | 11 +++++++++++
 .../driver/aic8800/aic8800_bsp/aic_bsp_driver.c   |  4 ++++
 .../driver/aic8800/aic8800_fdrv/rwnx_main.c       | 15 +++++++++++++++
 .../driver/aic8800/aic8800_fdrv/rwnx_platform.c   |  4 ++++
 4 files changed, 34 insertions(+)

diff --git a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
index e563d98..2a0c9c7 100644
--- a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
@@ -3684,6 +3684,9 @@ static int rwnx_cfg80211_stop_ap(struct wiphy *wiphy, struct net_device *dev)
  * configured at firmware level.
  */
 static int rwnx_cfg80211_set_monitor_channel(struct wiphy *wiphy,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION (6, 13, 0)) || (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 101))
+											 struct net_device *dev,
+#endif
 											 struct cfg80211_chan_def *chandef)
 {
 	struct rwnx_hw *rwnx_hw = wiphy_priv(wiphy);
@@ -3738,7 +3741,11 @@ static int rwnx_cfg80211_set_monitor_channel(struct wiphy *wiphy,
 
 int rwnx_cfg80211_set_monitor_channel_(struct wiphy *wiphy,
                                              struct cfg80211_chan_def *chandef){
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION (6, 13, 0)) || (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 101))
+    return rwnx_cfg80211_set_monitor_channel(wiphy, NULL, chandef);
+#else
     return rwnx_cfg80211_set_monitor_channel(wiphy, chandef);
+#endif
 }
 
 /**
@@ -4149,7 +4156,11 @@ static int rwnx_cfg80211_get_channel(struct wiphy *wiphy,
 
 	if (rwnx_vif->vif_index == rwnx_hw->monitor_vif) {
 		//retrieve channel from firmware
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION (6, 13, 0)) || (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 101))
+		rwnx_cfg80211_set_monitor_channel(wiphy, NULL, NULL);
+#else
 		rwnx_cfg80211_set_monitor_channel(wiphy, NULL);
+#endif
 	}
 
 	//Check if channel context is valid
diff --git a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aic_bsp_driver.c
index f723a22..138c8d3 100644
