Subject: [PATCH 13/28] =?UTF-8?q?debian=20=E8=A1=A5=E4=B8=81:=20fix-usb-bu?=
 =?UTF-8?q?ild.patch?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

来自 radxa-pkg/aic8800 的 debian/patches(跳过固件路径相关补丁, 飞牛用 /lib/firmware/aic8800/{sdio,usb})

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/Makefile         | 2 +-
 .../driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_mod_params.c    | 2 +-
 src/USB/driver_fw/drivers/aic_btusb/Makefile                    | 2 ++
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/Makefile b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/Makefile
index 7f60d6c..405d00c 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/Makefile
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/Makefile
@@ -1,6 +1,6 @@
 EXTRA_CFLAGS += $(USER_EXTRA_CFLAGS)
 EXTRA_CFLAGS += -Wno-implicit-fallthrough
-#EXTRA_CFLAGS += -Wno-unused-variable
+EXTRA_CFLAGS += -Wno-unused-variable
 
 RWNX_VERS_NUM := 6.4.3.0
 
diff --git a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_mod_params.c b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_mod_params.c
index c1de077..a1e96e4 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_mod_params.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_mod_params.c
@@ -940,7 +940,7 @@ static void rwnx_set_vht_capa(struct rwnx_hw *rwnx_hw, struct wiphy *wiphy)
         nss = 1;
     }
 
-	band_2GHz->vht_cap.vht_supported = true;
+    band_2GHz->vht_cap.vht_supported = true;
 		if (rwnx_hw->mod_params->sgi80)
 			band_2GHz->vht_cap.cap |= IEEE80211_VHT_CAP_SHORT_GI_80;
 		if (rwnx_hw->mod_params->stbc_on)
diff --git a/src/USB/driver_fw/drivers/aic_btusb/Makefile b/src/USB/driver_fw/drivers/aic_btusb/Makefile
index 61ec3d0..0966f67 100644
--- a/src/USB/driver_fw/drivers/aic_btusb/Makefile
+++ b/src/USB/driver_fw/drivers/aic_btusb/Makefile
@@ -1,3 +1,5 @@
+EXTRA_CFLAGS += -Wno-unused-variable
+
 MODULE_NAME = aic_btusb
 
 CONFIG_AIC8800_BTUSB_SUPPORT = m
