---
 .../driver/aic8800/aic8800_fdrv/rwnx_main.c          | 12 +++++++++++-
 .../driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c        |  8 +++++++-
 .../driver/aic8800/aic8800_fdrv/rwnx_platform.c      |  7 ++++++-
 .../driver/aic8800/aic8800_fdrv/rwnx_main.c          | 12 +++++++++++-
 .../driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c        |  8 +++++++-
 .../driver/aic8800/aic8800_fdrv/rwnx_platform.c      |  7 ++++++-
 .../drivers/aic8800/aic8800_fdrv/rwnx_main.c         | 12 +++++++++++-
 .../drivers/aic8800/aic8800_fdrv/rwnx_msg_tx.c       |  8 +++++++-
 8 files changed, 66 insertions(+), 8 deletions(-)

diff --git a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
index 9ee842e..de648db 100644
--- a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_main.c
@@ -4131,7 +4131,17 @@ rwnx_cfg80211_remain_on_channel_(struct wiphy *wiphy, struct wireless_dev *wdev,
 static int
 rwnx_cfg80211_remain_on_channel(struct wiphy *wiphy, struct wireless_dev *wdev,
 								struct ieee80211_channel *chan,
-								unsigned int duration, u64 *cookie)
+								unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+								/*
+								 * 7.2 added an optional receive address filter for the off-channel
+								 * period. cfg80211 refuses a non-NULL one unless the driver sets
+								 * NL80211_EXT_FEATURE_ROC_ADDR_FILTER, which this one does not, so it
+								 * is always NULL here. mac80211 ignores it in the same way.
+								 */
+								, const u8 *rx_addr
+#endif
+								)
 {
 	return rwnx_cfg80211_remain_on_channel_(wiphy, wdev, chan, duration, cookie, false);
 }
diff --git a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c
index aee98cb..29dc4ff 100644
--- a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c
+++ b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_msg_tx.c
@@ -3671,7 +3671,13 @@ int rwnx_send_dbg_trigger_req(struct rwnx_hw *rwnx_hw, char *msg)
 		return -ENOMEM;
 
 	/* Set parameters for the MM_DBG_TRIGGER_REQ message */
-	strncpy(req->error, msg, sizeof(req->error));
+	/*
+	 * strncpy() is gone in 7.2. req->error is a fixed 64-byte field of a
+	 * firmware message that is not NUL-terminated, and the message came
+	 * from kzalloc(), so copying at most the field size is all strncpy()
+	 * did here.
+	 */
+	memcpy(req->error, msg, strnlen(msg, sizeof(req->error)));
 
 	/* Send the MM_DBG_TRIGGER_REQ message to LMAC FW */
 	return rwnx_send_msg(rwnx_hw, req, 0, -1, NULL);
diff --git a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_platform.c b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_platform.c
index 8222bff..2aee663 100644
--- a/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_platform.c
+++ b/src/PCIE/driver_fw/driver/aic8800/aic8800_fdrv/rwnx_platform.c
@@ -1264,7 +1264,12 @@ static int parse_key_val(const char *str, const char *key, char *val)
 		p--;
 
 	p++;
-	strncpy(val, dst, p -dst);
+	/*
+	 * strncpy() is gone in 7.2. dst..p is a known-length run inside a
+	 * longer string, so strncpy() never reached its NUL and never padded;
+	 * the terminator is the line below. That is a plain memcpy().
+	 */
+	memcpy(val, dst, p - dst);
 	val[p - dst] = 0;
 	return 0;
 }
