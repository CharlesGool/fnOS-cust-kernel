--- a/src/tools/aicrf_test/Makefile
+++ b/src/tools/aicrf_test/Makefile
@@ -13,7 +13,7 @@ bt_test: bt_test.o
 	$(CROSS_COMPILE)gcc $+ $(LDFLAGS) -o $@
 
