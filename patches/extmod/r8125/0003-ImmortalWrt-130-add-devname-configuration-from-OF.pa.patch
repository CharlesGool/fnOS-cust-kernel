来源: immortalwrt/immortalwrt package/kernel/r8125/patches/130-add-devname-configuration-from-OF.patch
(飞牛的 r8125.ko 带有该补丁的行为, 见笔记 step14-extmod-net.md)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/r8125_n.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/r8125_n.c b/src/r8125_n.c
index 2033cf8..ffcc60d 100644
--- a/src/r8125_n.c
+++ b/src/r8125_n.c
@@ -16989,6 +16989,7 @@ rtl8125_init_board(struct pci_dev *pdev,
         void __iomem *ioaddr;
         struct net_device *dev;
         struct rtl8125_private *tp;
+        const char *devname = of_get_property(pdev->dev.of_node, "label", NULL);
         int rc = -ENOMEM, i, pm_cap;
 
         assert(ioaddr_out != NULL);
@@ -17003,6 +17004,9 @@ rtl8125_init_board(struct pci_dev *pdev,
                 goto err_out;
         }
 
+        if (devname)
+                strscpy(dev->name, devname, IFNAMSIZ);
+
         SET_MODULE_OWNER(dev);
         SET_NETDEV_DEV(dev, &pdev->dev);
         tp = netdev_priv(dev);
