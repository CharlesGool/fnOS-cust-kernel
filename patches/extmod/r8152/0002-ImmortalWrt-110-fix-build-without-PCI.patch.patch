---
 r8152.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/r8152.c b/r8152.c
index 402ed33..1fd8101 100644
--- a/r8152.c
+++ b/r8152.c
@@ -33567,7 +33567,7 @@ static int rtl_hc_support_sg(struct usb_device *udev)
 		goto out;
 	}
 
-	if (hc_dev->bus != &pci_bus_type)
+	if (!dev_is_pci(hc_dev))
 		goto out;
 
 	pdev = to_pci_dev(hc_dev);
