来源: immortalwrt/immortalwrt package/kernel/r8152/patches/100-add-LED-configuration-from-OF.patch
(飞牛的 r8152.ko 带有该补丁的行为, 见笔记 step14-extmod-net.md)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 r8152.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/r8152.c b/r8152.c
index 3985bfc..402ed33 100644
--- a/r8152.c
+++ b/r8152.c
@@ -19,6 +19,7 @@
 #include <linux/ethtool.h>
 #include <linux/phy.h>
 #include <linux/usb.h>
+#include <linux/of.h>
 #include <linux/crc32.h>
 #include <linux/if_vlan.h>
 #include <linux/uaccess.h>
@@ -13288,6 +13289,22 @@ out:
 	return ret;
 }
 
+static int r8152_led_configuration(struct r8152 *tp)
+{
+	u32 led_data;
+	int ret;
+
+	ret = of_property_read_u32(tp->udev->dev.of_node, "realtek,led-data",
+								&led_data);
+
+	if (ret)
+		return ret;
+
+	ocp_write_word(tp, MCU_TYPE_PLA, PLA_LEDSEL, led_data);
+
+	return 0;
+}
+
 static int r8152b_init(struct r8152 *tp)
 {
 	int ret;
@@ -13387,6 +13404,8 @@ static int r8152b_init(struct r8152 *tp)
 	ret = ocp_word_clr_bits(tp, MCU_TYPE_USB, USB_USB_CTRL,
 				RX_AGG_DISABLE | RX_ZERO_EN);
 
+	r8152_led_configuration(tp);
+
 out:
 	return (ret < 0) ? ret : 0;
 }
@@ -13577,6 +13596,8 @@ static int r8153_init(struct r8152 *tp)
 		break;
 	}
 
+	r8152_led_configuration(tp);
+
 out:
 	return (ret < 0) ? ret : 0;
 }
@@ -13707,6 +13728,8 @@ static int r8153b_init(struct r8152 *tp)
 
 	tp->coalesce = 15000;	/* 15 us */
 
+	r8152_led_configuration(tp);
+
 out:
 	return (ret < 0) ? ret : 0;
 }
@@ -13821,6 +13844,8 @@ static int r8153c_init(struct r8152 *tp)
 
 	tp->coalesce = 15000;	/* 15 us */
 
+	r8152_led_configuration(tp);
+
 out:
 	return (ret < 0) ? ret : 0;
 }
