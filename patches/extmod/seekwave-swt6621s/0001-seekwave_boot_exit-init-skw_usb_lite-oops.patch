 drivers/seekwaveplatform_lite/skwutil/skw_boot.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/seekwaveplatform_lite/skwutil/skw_boot.c b/drivers/seekwaveplatform_lite/skwutil/skw_boot.c
index a82562f..cc24533 100644
--- a/drivers/seekwaveplatform_lite/skwutil/skw_boot.c
+++ b/drivers/seekwaveplatform_lite/skwutil/skw_boot.c
@@ -1454,10 +1454,15 @@ static int skw_first_boot(struct seekwave_device *boot_data)
 #endif
 	return ret;
 }
+/* 只有探测到设备才会 init; 没有硬件时卸载模块不能去注销没注册过的东西 */
+static bool seekwave_boot_inited;
 int seekwave_boot_init(char *chip_id)
 {
 	int ret;
 
+	if (seekwave_boot_inited)
+		return 0;
+
 	skwboot_log("%s: enter chip_id=%s\n",__func__,chip_id);
 	if(chip_id != NULL && strlen(chip_id)!=0){
 		local_chip_id = chip_id;
@@ -1467,10 +1472,14 @@ int seekwave_boot_init(char *chip_id)
 	ret = platform_driver_register(&seekwave_driver);
 	if (seekwave_device.name)
 		platform_device_register(&seekwave_device);
+	seekwave_boot_inited = true;
 	return ret;
 }
 void seekwave_boot_exit(void)
 {
+	if (!seekwave_boot_inited)
+		return;
+	seekwave_boot_inited = false;
 	skw_ucom_exit();
 
 	if (seekwave_device.name)
