# Host directory holding upstream tarballs, out-of-tree module sources and the work area. Required. Component: scripts/ck.sh, scripts/cmpdeb.sh
CK_DEPS_DIR=/path/to/deps
# The same directory as seen inside the build container. Optional, default /k. Component: scripts/ck.sh
CK_CONTAINER_DIR=/k
# Name of the build container (Debian 12, see README requirements). Optional, default kwork. Component: scripts/ck.sh
CK_BUILD_CONTAINER=kwork
# Command used to run docker, e.g. a wrapper that enters another environment first. Optional, default docker. Component: scripts/ck.sh
CK_DOCKER=docker
# Parallel build jobs inside the container. Optional, default nproc of the container. Component: scripts/kwork/
KJOBS=
# Directory with the KVM test VM disks, OVMF vars and qmp.sock. Required for tests. Component: test/kvm/
CK_KVM_DIR=/path/to/kvm
# Password of the test VM account admintest. Required for tests. Component: test/kvm/vm.sh, test/kvm/smbtest.sh
VM_PASS=change-me
# Password of the test VM account u1. Required for smbtest.sh. Component: test/kvm/smbtest.sh
U1_PASS=change-me
# GnuPG home used to verify kernel.org signatures. Optional, default $CK_DEPS_DIR/gnupg. Component: scripts/ck.sh
CK_GNUPGHOME=
